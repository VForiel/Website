---
import PageLayout from "./PageLayout.astro";
import { parsePartialDate, buildDateLabel } from "../utils/dates";

interface Props {
    title: string;
    description: string;
    startDate?: string | Date;
    endDate?: string | Date;
    tags?: string[];
    image?: string;
    url?: string;
    lang?: "fr" | "en";
    designation?: string;
}

const {
    title,
    description,
    startDate,
    endDate,
    tags = [],
    image,
    url,
    lang = "fr",
    designation,
} = Astro.props;

const parsedEnd = parsePartialDate(endDate);
const dateLabel = buildDateLabel(startDate, endDate, lang);

const backLabel =
    lang === "fr" ? "← Retour au portfolio" : "← Back to portfolio";
const backHref = `${import.meta.env.BASE_URL.replace(/\/?$/, "")}/${lang}/portfolio`;
const externalLinkLabel = lang === "fr" ? "Voir le projet" : "View project";
const isAI = image?.split('/').pop()?.startsWith('IA_') || false;
const sheet =
    lang === "fr"
        ? { catalogue: "Catalogue des projets", id: "Désignation", period: "Période", domains: "Domaines", link: "Lien" }
        : { catalogue: "Project catalogue", id: "Designation", period: "Period", domains: "Fields", link: "Link" };
---

<PageLayout
    title={title}
    description={description}
    lang={lang}
    currentPath={Astro.url.pathname}
>
    <div class="project-page">
        <div class="container">
            <a href={backHref} class="back-link">{backLabel}</a>

            <article class="project">
                <header class="project-header">
                    {designation && <p class="eyebrow project-eyebrow">{designation} · {sheet.catalogue}</p>}
                    <h1 class="project-title">{title}</h1>
                    <p class="project-description">{description}</p>

                    <div class="project-details-row">
                        <dl class="datasheet">
                            {
                                designation && (
                                    <div class="datasheet__row">
                                        <dt>{sheet.id}</dt>
                                        <dd class="datasheet__id">{designation}</dd>
                                    </div>
                                )
                            }
                            <div class="datasheet__row">
                                <dt>{sheet.period}</dt>
                                <dd>
                                    {
                                        parsedEnd ? (
                                            <time
                                                class="project-date"
                                                datetime={parsedEnd.date.toISOString()}
                                            >
                                                {dateLabel}
                                            </time>
                                        ) : (
                                            <span class="project-date">{dateLabel}</span>
                                        )
                                    }
                                </dd>
                            </div>
                            {
                                tags.length > 0 && (
                                    <div class="datasheet__row">
                                        <dt>{sheet.domains}</dt>
                                        <dd class="project-tags">
                                            {tags.map((tag) => (
                                                <a href={`${backHref}?tag=${encodeURIComponent(tag)}`} class="tag">
                                                    {tag}
                                                </a>
                                            ))}
                                        </dd>
                                    </div>
                                )
                            }
                            {
                                url && (
                                    <div class="datasheet__row">
                                        <dt>{sheet.link}</dt>
                                        <dd>
                                            <a
                                                href={url}
                                                class="external-link"
                                                target="_blank"
                                                rel="noopener noreferrer"
                                            >
                                                {externalLinkLabel} →
                                            </a>
                                        </dd>
                                    </div>
                                )
                            }
                        </dl>
                    {
                        image && (
                            <div class="project-header-image-wrapper">
                                {isAI && (
                                    <div class="project-header__ai-badge">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg>
                                        <span>{lang === "fr" ? "IA" : "AI"}</span>
                                        <span class="ai-tooltip">{lang === 'fr' ? "Cette image a été générée par l'IA dans l'unique but d'illustrer le projet, elle ne fait pas partie du projet." : "This image was generated by AI solely to illustrate the project, it is not part of the project itself."}</span>
                                    </div>
                                )}
                                <div class="project-header-image">
                                    <img
                                        src={
                                            image.startsWith("/")
                                                ? `${import.meta.env.BASE_URL.replace(/\/$/, "")}${image}`
                                                : image
                                        }
                                        alt={title}
                                        class="thumbnail-image"
                                        id="thumbnail-trigger"
                                    />
                                </div>
                            </div>
                        )
                    }
                    </div>
                </header>

                {
                    image && (
                        <dialog id="image-lightbox" class="lightbox">
                            <div class="lightbox-content">
                                {isAI && (
                                    <div class="lightbox-ai-badge">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg>
                                        <span>{lang === "fr" ? "IA" : "AI"}</span>
                                        <span class="ai-tooltip">{lang === 'fr' ? "Cette image a été générée par l'IA dans l'unique but d'illustrer le projet, elle ne fait pas partie du projet." : "This image was generated by AI solely to illustrate the project, it is not part of the project itself."}</span>
                                    </div>
                                )}
                                <form method="dialog" class="lightbox-close-form">
                                    <button class="lightbox-close" aria-label="Close" formmethod="dialog">&times;</button>
                                </form>
                                <img
                                    src={
                                        image.startsWith("/")
                                            ? `${import.meta.env.BASE_URL.replace(/\/$/, "")}${image}`
                                            : image
                                    }
                                    alt={title}
                                    class="lightbox-image"
                                />
                            </div>
                        </dialog>
                    )
                }

                <div class="project-content prose">
                    <slot />
                </div>
            </article>
        </div>
    </div>
</PageLayout>

<style>
    .project-page {
        min-height: calc(100vh - 200px);
        padding-block: var(--space-16) var(--space-24);
    }

    .container {
        max-width: 800px;
        margin-inline: auto;
        padding-inline: var(--space-6);
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.04em;
        color: var(--color-text-muted);
        margin-block-end: var(--space-8);
        transition: color var(--transition-fast);
    }

    .back-link:hover {
        color: var(--color-primary);
    }

    .project {
        max-width: 52rem;
    }

    .project-header {
        margin-block-end: var(--space-12);
        padding-block-end: var(--space-8);
        border-bottom: 1px solid var(--color-border);
    }

    .project-details-row {
        display: flex;
        gap: var(--space-10);
        align-items: flex-start;
        justify-content: space-between;
    }

    .project-eyebrow {
        margin-block-end: var(--space-4);
        color: var(--color-primary);
    }

    /* Fiche signalétique : intitulés en chasse fixe, valeurs alignées sur une colonne */
    .datasheet {
        flex: 1;
        min-width: 0;
        margin: 0;
        border-top: 1px solid var(--color-border);
    }

    .datasheet__row {
        display: grid;
        grid-template-columns: 8.5rem minmax(0, 1fr);
        gap: var(--space-4);
        align-items: baseline;
        padding-block: var(--space-3);
        border-bottom: 1px solid var(--color-border-subtle);
    }

    .datasheet dt {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-text-muted);
    }

    .datasheet dd {
        margin: 0;
        font-size: var(--text-sm);
    }

    .datasheet__id {
        font-family: var(--font-mono);
        color: var(--color-primary);
    }

    .project-header-image-wrapper {
        flex-shrink: 0;
        width: 180px;
        position: relative;
    }

    .project-header-image {
        width: 100%;
        overflow: hidden;
        cursor: zoom-in;
        border: 1px solid var(--color-border-subtle);
    }

    :global(.project-header__ai-badge) {
        position: absolute;
        top: var(--space-2);
        left: var(--space-2);
        z-index: 2;
        display: flex;
        align-items: center;
        gap: var(--space-1);
        background-color: rgba(0, 0, 0, 0.6);
        color: white;
        padding: var(--space-1) var(--space-2);
        border-radius: var(--radius-sm);
        font-size: var(--text-xs);
        font-weight: 500;
        backdrop-filter: blur(4px);
        cursor: help;
        transition: transform 0.2s ease, background-color 0.2s ease;
    }

    :global(.project-header__ai-badge:hover) {
        transform: scale(1.05);
        background-color: rgba(0, 0, 0, 0.85);
    }
    
    .thumbnail-image {
        width: 100%;
        height: auto;
        display: block;
        object-fit: cover;
    }

    .project-header-image:hover {
        border-color: var(--color-text-muted);
    }

    .lightbox {
        border: none;
        background: transparent;
        padding: 0;
        max-width: 95vw;
        max-height: 95vh;
        margin: auto;
    }

    .lightbox-content {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    
    .lightbox::backdrop {
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(4px);
    }

    .lightbox-close-form {
        position: fixed;
        top: var(--space-6);
        right: var(--space-6);
        z-index: 10;
    }

    .lightbox-close {
        background: none;
        border: none;
        color: white;
        font-size: 3rem;
        cursor: pointer;
        line-height: 1;
        padding: var(--space-2);
        transition: transform 0.2s ease;
        outline: none;
    }
    
    .lightbox-close:hover {
        transform: scale(1.2);
    }

    :global(.lightbox-ai-badge) {
        position: absolute;
        top: var(--space-6);
        left: var(--space-6);
        z-index: 10;
        display: flex;
        align-items: center;
        gap: var(--space-2);
        background-color: rgba(0, 0, 0, 0.7);
        color: white;
        padding: var(--space-2) var(--space-4);
        border-radius: var(--radius-md);
        font-size: var(--text-base);
        font-weight: 500;
        backdrop-filter: blur(4px);
        cursor: help;
        transition: transform 0.2s ease, background-color 0.2s ease;
    }

    :global(.lightbox-ai-badge:hover) {
        transform: scale(1.05);
        background-color: rgba(0, 0, 0, 0.9);
    }

    :global(.ai-tooltip) {
        position: absolute;
        top: 100%;
        left: 0;
        margin-top: var(--space-2);
        background-color: rgba(0, 0, 0, 0.95);
        color: white;
        padding: var(--space-2) var(--space-3);
        border-radius: var(--radius-sm);
        font-size: var(--text-xs);
        font-weight: 400;
        line-height: 1.4;
        width: max-content;
        max-width: 250px;
        white-space: normal;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.2s ease, visibility 0.2s ease;
        pointer-events: none;
        box-shadow: var(--shadow-md);
        text-align: left;
    }

    :global(.lightbox-ai-badge .ai-tooltip) {
        font-size: var(--text-sm);
        max-width: 320px;
        padding: var(--space-3) var(--space-4);
    }

    :global(.project-header__ai-badge:hover .ai-tooltip),
    :global(.lightbox-ai-badge:hover .ai-tooltip) {
        opacity: 1;
        visibility: visible;
    }

    .lightbox-image {
        display: block;
        max-width: 100vw;
        max-height: 90vh;
        border-radius: var(--radius-lg);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
        object-fit: contain;
    }

    .project-title {
        font-size: clamp(2.25rem, 5vw, 3.5rem);
        font-weight: 400;
        margin-block-end: var(--space-4);
        line-height: 1.08;
    }

    .project-description {
        font-size: var(--text-xl);
        color: var(--color-text-secondary);
        margin-block-end: var(--space-6);
        line-height: 1.6;
    }

    .project-date {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--color-text-muted);
    }

    .project-tags {
        display: flex;
        gap: var(--space-1) var(--space-3);
        flex-wrap: wrap;
    }

    .tag {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-text-muted);
        text-decoration: none;
        transition: color 0.15s ease;
    }

    .tag:hover {
        color: var(--color-primary);
    }

    .external-link {
        color: var(--color-text);
        font-size: var(--text-sm);
        font-weight: 500;
        text-decoration: underline;
        text-decoration-color: var(--color-primary);
        text-underline-offset: 0.25em;
    }

    .external-link:hover {
        color: var(--color-primary);
    }

    /* Prose styling for markdown content */
    .prose {
        font-size: var(--text-lg);
        line-height: 1.75;
        color: var(--color-text);
    }

    .prose :global(h2) {
        font-size: var(--text-3xl);
        font-weight: 400;
        margin-block: var(--space-12) var(--space-4);
        color: var(--color-text);
    }

    .prose :global(h3) {
        font-size: var(--text-2xl);
        font-weight: 500;
        margin-block: var(--space-8) var(--space-3);
        color: var(--color-text);
    }

    .prose :global(p) {
        font-size: inherit;
        margin-block-end: var(--space-4);
        color: var(--color-text-secondary);
    }

    .prose :global(ul),
    .prose :global(ol) {
        margin-block: var(--space-4);
        padding-inline-start: var(--space-6);
    }

    .prose :global(li) {
        margin-block-end: var(--space-2);
        color: var(--color-text-secondary);
    }

    .prose :global(ul) {
        list-style: disc;
    }

    .prose :global(ol) {
        list-style: decimal;
    }

    .prose :global(a) {
        color: var(--color-text);
        text-decoration: underline;
        text-decoration-color: var(--color-primary);
        text-underline-offset: 0.2em;
    }

    .prose :global(a:hover) {
        color: var(--color-primary);
    }

    .prose :global(code) {
        background-color: var(--color-background-secondary);
        padding: 0.1em 0.35em;
        border-radius: var(--radius-sm);
        font-size: 0.85em;
        font-family: var(--font-mono);
    }

    .prose :global(pre) {
        background-color: var(--color-background-secondary);
        border: 1px solid var(--color-border-subtle);
        padding: var(--space-4);
        border-radius: var(--radius-sm);
        overflow-x: auto;
        margin-block: var(--space-6);
    }

    .prose :global(pre code) {
        background-color: transparent;
        padding: 0;
    }

    @media (max-width: 768px) {
        .project-details-row {
            flex-direction: column-reverse;
            gap: var(--space-6);
        }

        .project-header-image-wrapper {
            width: 100%;
            max-width: 300px;
        }

        .project-header-image {
            width: 100%;
        }

        .datasheet__row {
            grid-template-columns: 6.5rem minmax(0, 1fr);
        }

        .project-title {
            font-size: var(--text-3xl);
        }

        .project-description {
            font-size: var(--text-lg);
        }
    }
</style>

<script>
    function setupLightbox() {
        const thumbnail = document.getElementById('thumbnail-trigger');
        const lightbox = document.getElementById('image-lightbox') as HTMLDialogElement;
        
        if (thumbnail && lightbox) {
            thumbnail.addEventListener('click', () => {
                lightbox.showModal();
                document.body.style.overflow = 'hidden';
            });
            
            // Close when clicking empty backdrop space
            lightbox.addEventListener('click', (e) => {
                const dialogDimensions = lightbox.getBoundingClientRect();
                if (
                    e.clientX < dialogDimensions.left ||
                    e.clientX > dialogDimensions.right ||
                    e.clientY < dialogDimensions.top ||
                    e.clientY > dialogDimensions.bottom
                ) {
                    lightbox.close();
                }
            });

            // Prevent scroll when dialog is forcefully closed by browser tools or ESC key
            lightbox.addEventListener('close', () => {
                document.body.style.overflow = '';
            });
        }
    }

    // Run on initial load
    setupLightbox();

    // Run on Astro view transitions
    document.addEventListener('astro:page-load', setupLightbox);
</script>
