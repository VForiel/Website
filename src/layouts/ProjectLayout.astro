---
import PageLayout from './PageLayout.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  image?: string;
  url?: string;
  lang?: 'fr' | 'en';
}

const { title, description, date, tags = [], image, url, lang = 'fr' } = Astro.props;

const formattedDate = new Intl.DateTimeFormat(lang === 'fr' ? 'fr-FR' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);

const backLabel = lang === 'fr' ? '← Retour au portfolio' : '← Back to portfolio';
const backHref = `/${lang}/portfolio`;
const externalLinkLabel = lang === 'fr' ? 'Voir le projet' : 'View project';
---

<PageLayout 
  title={title} 
  description={description} 
  lang={lang}
  currentPath={Astro.url.pathname}
>
  <div class="project-page">
    <div class="container">
      <a href={backHref} class="back-link">{backLabel}</a>
      
      <article class="project">
        <header class="project-header">
          <h1 class="project-title">{title}</h1>
          <p class="project-description">{description}</p>
          
          <div class="project-meta">
            <time class="project-date" datetime={date.toISOString()}>
              {formattedDate}
            </time>
            
            {tags.length > 0 && (
              <div class="project-tags">
                {tags.map(tag => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
          </div>

          {url && (
            <a href={url} class="external-link" target="_blank" rel="noopener noreferrer">
              {externalLinkLabel} →
            </a>
          )}
        </header>

        {image && (
          <div class="project-image">
            <img src={image} alt={title} />
          </div>
        )}

        <div class="project-content prose">
          <slot />
        </div>
      </article>
    </div>
  </div>
</PageLayout>

<style>
  .project-page {
    min-height: calc(100vh - 200px);
    padding-block: var(--space-16) var(--space-24);
  }

  .container {
    max-width: 800px;
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    margin-block-end: var(--space-8);
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .project {
    background-color: var(--color-background-secondary);
    border-radius: var(--radius-lg);
    padding: var(--space-12);
  }

  .project-header {
    margin-block-end: var(--space-12);
  }

  .project-title {
    font-size: var(--text-4xl);
    font-weight: 700;
    margin-block-end: var(--space-4);
    line-height: 1.2;
  }

  .project-description {
    font-size: var(--text-xl);
    color: var(--color-text-secondary);
    margin-block-end: var(--space-6);
    line-height: 1.6;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    align-items: center;
    margin-block-end: var(--space-6);
  }

  .project-date {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .project-tags {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .tag {
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-3);
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
  }

  .external-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    background-color: var(--color-primary);
    color: white;
    border-radius: var(--radius-md);
    font-weight: 500;
    font-size: var(--text-base);
    transition: all var(--transition-base);
  }

  .external-link:hover {
    background-color: var(--color-primary-dark);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .project-image {
    margin-block-end: var(--space-12);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .project-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Prose styling for markdown content */
  .prose {
    font-size: var(--text-base);
    line-height: 1.75;
    color: var(--color-text);
  }

  .prose :global(h2) {
    font-size: var(--text-2xl);
    font-weight: 600;
    margin-block: var(--space-8) var(--space-4);
    color: var(--color-text);
  }

  .prose :global(h3) {
    font-size: var(--text-xl);
    font-weight: 600;
    margin-block: var(--space-6) var(--space-3);
    color: var(--color-text);
  }

  .prose :global(p) {
    margin-block-end: var(--space-4);
    color: var(--color-text-secondary);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-block: var(--space-4);
    padding-inline-start: var(--space-6);
  }

  .prose :global(li) {
    margin-block-end: var(--space-2);
    color: var(--color-text-secondary);
  }

  .prose :global(ul) {
    list-style: disc;
  }

  .prose :global(ol) {
    list-style: decimal;
  }

  .prose :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .prose :global(a:hover) {
    color: var(--color-primary-dark);
  }

  .prose :global(code) {
    background-color: var(--color-background);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    font-size: 0.9em;
    font-family: monospace;
  }

  .prose :global(pre) {
    background-color: var(--color-background);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin-block: var(--space-6);
  }

  .prose :global(pre code) {
    background-color: transparent;
    padding: 0;
  }

  @media (max-width: 768px) {
    .project {
      padding: var(--space-8);
    }

    .project-title {
      font-size: var(--text-3xl);
    }

    .project-description {
      font-size: var(--text-lg);
    }
  }
</style>
