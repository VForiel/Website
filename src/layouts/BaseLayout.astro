---
interface Props {
    title: string;
    description?: string;
    lang?: string;
}

const {
    title,
    description = "Doctorant en instrumentation astronomique, imagerie à haut contraste et simulation optique",
    lang = "fr",
} = Astro.props;
import "../styles/global.css";
import PoppyEasterEgg from "../components/PoppyEasterEgg.astro";
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />

        <!-- SEO -->
        <title>{title}</title>
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />

        <!-- Favicon -->
        <link
            rel="icon"
            type="image/jpeg"
            href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}profile-picture.jpg`}
        />

        <!-- Prevent theme flash on page load -->
        <script is:inline>
            // This script runs immediately before the page renders to prevent theme flash
            (function () {
                const theme = localStorage.getItem("theme");
                if (theme === "light") {
                    document.documentElement.setAttribute(
                        "data-theme",
                        "light",
                    );
                } else {
                    document.documentElement.setAttribute("data-theme", "dark");
                }
            })();
        </script>

        <!-- Styles importés via frontmatter -->

        <script defer src="https://cloud.umami.is/script.js" data-website-id="c3edc03f-6667-4feb-85f3-caf3baa000b4"></script>

    </head>
    <body>
        <slot />
        <PoppyEasterEgg lang={lang} />
    </body>
</html>
