---
interface Props {
    title: string;
    description?: string;
    lang?: string;
    /** Page accessible par son adresse mais exclue des moteurs de recherche */
    noindex?: boolean;
}

const {
    title,
    description = "Doctorant en instrumentation astronomique, imagerie à haut contraste et simulation optique",
    lang = "fr",
    noindex = false,
} = Astro.props;
// Polices : seulement les alphabets latin et latin étendu (« œ », etc.), pour garder un CSS léger
import "@fontsource/newsreader/latin-400.css";
import "@fontsource/newsreader/latin-ext-400.css";
import "@fontsource/newsreader/latin-400-italic.css";
import "@fontsource/newsreader/latin-ext-400-italic.css";
import "@fontsource/newsreader/latin-500.css";
import "@fontsource/newsreader/latin-ext-500.css";
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-ext-400.css";
import "@fontsource/ibm-plex-sans/latin-400-italic.css";
import "@fontsource/ibm-plex-sans/latin-ext-400-italic.css";
import "@fontsource/ibm-plex-sans/latin-500.css";
import "@fontsource/ibm-plex-sans/latin-ext-500.css";
import "@fontsource/ibm-plex-sans/latin-600.css";
import "@fontsource/ibm-plex-sans/latin-ext-600.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-ext-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "@fontsource/ibm-plex-mono/latin-ext-500.css";
import "../styles/global.css";
import PoppyEasterEgg from "../components/PoppyEasterEgg.astro";

// Image de partage générée au build pour cette page (integrations/og-images.mjs) ;
// la page en persan reprend celle de l'accueil
const pagePath = Astro.url.pathname.replace(import.meta.env.BASE_URL, "/").replace(/^\/+|\/+$/g, "");
const ogImage = new URL(`/og/${lang === "fa" || pagePath === "" ? "fr" : pagePath}.jpg`, Astro.site);
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />
        {noindex && <meta name="robots" content="noindex, nofollow" />}

        <!-- SEO -->
        <title>{title}</title>
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
        <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={title} />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={ogImage} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />

        <!-- Favicon -->
        <link
            rel="icon"
            type="image/png"
            href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}favicon.png`}
        />

        <!-- Prevent theme flash on page load -->
        <script is:inline>
            // This script runs immediately before the page renders to prevent theme flash
            (function () {
                const theme = localStorage.getItem("theme");
                if (theme === "light") {
                    document.documentElement.setAttribute(
                        "data-theme",
                        "light",
                    );
                    document.documentElement.classList.add("light-theme");
                } else {
                    document.documentElement.setAttribute("data-theme", "dark");
                }
            })();
        </script>

        <!-- Transitions entre pages : l'image et le titre d'un projet passent de la liste à sa page (et retour) -->
        <script is:inline>
            // Mode allégé pour les machines modestes (GPU intégré + écran très haute densité) :
            // si trop d'images dépassent ~22 ms juste après le chargement, data-perf="low" coupe
            // les effets décoratifs continus. Mémorisé pour la session : les pages suivantes partent allégées.
            (function () {
                var root = document.documentElement;
                try {
                    if (sessionStorage.getItem("perf") === "low") {
                        root.dataset.perf = "low";
                        return;
                    }
                } catch (e) {}
                var last = 0, frames = 0, slow = 0;
                function sample(now) {
                    if (last) {
                        frames++;
                        if (now - last > 22) slow++;
                    }
                    last = now;
                    if (frames < 90) return requestAnimationFrame(sample);
                    if (slow / frames < 0.25) return;
                    root.dataset.perf = "low";
                    try { sessionStorage.setItem("perf", "low"); } catch (e) {}
                    document.dispatchEvent(new Event("perf-low"));
                }
                addEventListener("load", function () {
                    setTimeout(function () { requestAnimationFrame(sample); }, 500);
                });
            })();
        </script>
        <script is:inline>
            (function () {
                if (!("onpagereveal" in window)) return;
                var NAMES = [["img", "project-image"], ["title", "project-title"]];

                function slugOf(url) {
                    var match = url && new URL(url).pathname.match(/\/projects\/([^/]+)\/?$/);
                    return match ? match[1] : null;
                }

                // Éléments à lier : sur une page projet, son image et son titre ; ailleurs, la carte du projet visé
                function targets(slug) {
                    if (document.querySelector(".project-page")) {
                        return { img: document.querySelector(".thumbnail-image"), title: document.querySelector(".project-title") };
                    }
                    var link = document.querySelector('a[href$="/projects/' + slug + '/"], a[href$="/projects/' + slug + '"]');
                    var card = link && link.closest(".project-card, .timeline-item");
                    if (!card) return {};
                    return { img: card.querySelector("img"), title: card.querySelector("h3") };
                }

                function mark(slug, transition) {
                    if (!slug || !transition) return;
                    var found = targets(slug);
                    NAMES.forEach(function (pair) {
                        var el = found[pair[0]];
                        if (!el) return;
                        el.style.viewTransitionName = pair[1];
                        transition.finished.finally(function () { el.style.viewTransitionName = ""; });
                    });
                }

                window.addEventListener("pageswap", function (event) {
                    if (!event.viewTransition || !event.activation) return;
                    var to = slugOf(event.activation.entry.url);
                    var here = slugOf(location.href);
                    mark(to || here, event.viewTransition);
                });

                window.addEventListener("pagereveal", function (event) {
                    if (!event.viewTransition || !window.navigation || !navigation.activation) return;
                    var from = navigation.activation.from && slugOf(navigation.activation.from.url);
                    mark(slugOf(location.href) || from, event.viewTransition);
                });
            })();
        </script>

        <!-- Styles importés via frontmatter -->

        <script defer src="https://cloud.umami.is/script.js" data-website-id="c3edc03f-6667-4feb-85f3-caf3baa000b4"></script>

    </head>
    <body>
        <slot />
        <PoppyEasterEgg lang={lang} />
        <script>
            import "../scripts/secrets";
        </script>
    </body>
</html>
