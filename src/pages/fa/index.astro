---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ParticlesBackground from "../../components/ParticlesBackground.astro";
---

<BaseLayout title="ستاره‌ها را دنبال کن" description="یک صفحه مخفی" lang="fa">
    <ParticlesBackground />
    <main class="fa-page" dir="rtl">
        <div class="fa-container">
            <header class="fa-header">
                <div class="ornament">✦</div>
                <h1>میراث درخشان ایران در علم</h1>
                <p class="subtitle">
                    از ستاره‌شناسی تا نور‌شناسی — دانشی که جهان را شکل داد
                </p>
                <div class="ornament">✦</div>
            </header>

            <section class="fa-section">
                <p>
                    تمدن ایران یکی از درخشان‌ترین میراث‌های علمی تاریخ بشر را به
                    جهان هدیه کرده است. در دوران طلایی اسلام، دانشمندان ایرانی
                    پایه‌گذار بسیاری از شاخه‌های علمی بودند که امروز ستون‌های
                    دانش مدرن هستند.
                </p>

                <div class="scientist-cards">
                    <div class="scientist-card">
                        <h3>
                            <a
                                href="https://en.wikipedia.org/wiki/Ibn_Sahl_(mathematician)"
                                target="_blank"
                                rel="noopener">ابن سهل</a
                            >
                        </h3>
                        <span class="date">۹۴۰ – ۱۰۰۰ میلادی</span>
                        <p>
                            قانون شکست نور، که در غرب به نام «قانون اسنل-دکارت»
                            شناخته می‌شود، در واقع نخستین بار توسط <strong
                                >ابن سهل</strong
                            > ریاضی‌دان ایرانی در رساله‌ای درباره آینه‌ها و عدسی‌های
                            سوزان کشف و فرمول‌بندی شد —
                            <em>بیش از ششصد سال پیش از اسنل.</em>
                        </p>
                    </div>

                    <div class="scientist-card">
                        <h3>
                            <a
                                href="https://en.wikipedia.org/wiki/Avicenna"
                                target="_blank"
                                rel="noopener">ابن سینا (ابوعلی سینا)</a
                            >
                        </h3>
                        <span class="date">۹۸۰ – ۱۰۳۷ میلادی</span>
                        <p>
                            پدر پزشکی مدرن. کتاب «قانون در طب» او بیش از پانصد
                            سال در دانشگاه‌های اروپا تدریس می‌شد و هنوز هم یکی
                            از مهم‌ترین متون پزشکی تاریخ به شمار می‌رود.
                        </p>
                    </div>

                    <div class="scientist-card">
                        <h3>
                            <a
                                href="https://en.wikipedia.org/wiki/Al-Khwarizmi"
                                target="_blank"
                                rel="noopener">خوارزمی</a
                            >
                        </h3>
                        <span class="date">۷۸۰ – ۸۵۰ میلادی</span>
                        <p>
                            پدر جبر. واژه «الگوریتم» از نام لاتین‌شده او گرفته
                            شده است. آثار او پایه‌های ریاضیات و علوم رایانه مدرن
                            را بنا نهاد.
                        </p>
                    </div>

                    <div class="scientist-card">
                        <h3>
                            <a
                                href="https://en.wikipedia.org/wiki/Omar_Khayyam"
                                target="_blank"
                                rel="noopener">عمر خیام</a
                            >
                        </h3>
                        <span class="date">۱۰۴۸ – ۱۱۳۱ میلادی</span>
                        <p>
                            ریاضی‌دان، ستاره‌شناس و شاعر. تقویم جلالی او از
                            تقویم گرگوری دقیق‌تر است. رباعیات او نیز یکی از
                            شناخته‌شده‌ترین آثار ادبی جهان است.
                        </p>
                    </div>

                    <div class="scientist-card">
                        <h3>
                            <a
                                href="https://en.wikipedia.org/wiki/Nasir_al-Din_al-Tusi"
                                target="_blank"
                                rel="noopener">نصیرالدین طوسی</a
                            >
                        </h3>
                        <span class="date">۱۲۰۱ – ۱۲۷۴ میلادی</span>
                        <p>
                            بنیان‌گذار مثلثات به عنوان یک شاخه مستقل ریاضی و
                            سازنده رصدخانه مراغه، یکی از مهم‌ترین مراکز نجومی
                            تاریخ.
                        </p>
                    </div>
                </div>
            </section>

            <div class="ornament ornament--divider">✦</div>

            <section class="fa-section personal">
                <h2>یک یادداشت شخصی</h2>
                <p>
                    در مسیر تحصیلات دکتری‌ام، با یک دختر ایرانی ملاقات کردم که
                    تأثیری عمیق و ماندگار بر زندگی‌ام گذاشت.
                </p>
                <p>
                    او روحی مهربان، خردمند و سرشار از عشق است. در دوران
                    دکتری‌ام، رویدادهای شخصی بسیار سختی مرا عمیقاً تکان داد. او
                    در آن لحظات تاریک، با صبر و مهربانی در کنارم ایستاد و به من
                    قدرت ادامه دادن را بخشید. بدون حمایت او، به احتمال زیاد
                    تحصیلات دکتری‌ام را رها کرده بودم.
                </p>
                <p>
                    هیچ کلمه‌ای نمی‌تواند سپاس مرا به اندازه کافی بیان کند. او
                    سزاوار این اشاره کوچک در سایت من است — و بسیار بیشتر از این.
                </p>
            </section>

            <footer class="fa-footer">
                <div class="ornament">✦</div>
                <p class="wish">
                    برای او، برای خانواده‌اش و برای مردم ایران —
                    <br />
                    آرزوی خوشبختی، آرامش و صلح دارم.
                    <br />
                    <br />
                    <span class="wish-secondary">
                        در روزگاری که سرزمینش درد و رنج بسیاری را تحمل می‌کند،
                        <br />
                        امیدوارم نور امید هرگز خاموش نشود.
                    </span>
                    <br />
                    <span class="wish-date">۴ مارس ۲۰۲۶</span>
                </p>
                <div class="lotus">
                    <img
                        src={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}images/easter-eggs/lotus.png`}
                        alt="Lotus"
                        class="lotus-img"
                    />
                </div>
            </footer>

            <div class="back-link">
                <a
                    href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}`}
                    class="back-btn"
                    aria-label="بازگشت"
                >
                    <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M19 12H5"></path>
                        <path d="m12 19-7-7 7-7"></path>
                    </svg>
                </a>
            </div>
        </div>
    </main>
</BaseLayout>

<style>
    @import url("https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700&display=swap");

    .fa-page {
        font-family: "Vazirmatn", "Inter", system-ui, sans-serif;
        min-height: 100vh;
        padding-block: var(--space-16);
        direction: rtl;
        text-align: right;
    }

    .fa-page p {
        max-width: none;
    }

    .fa-container {
        max-width: 800px;
        margin-inline: auto;
        padding-inline: var(--space-6);
    }

    /* Header */
    .fa-header {
        text-align: center;
        margin-block-end: 0;
    }

    .fa-header h1 {
        font-size: var(--text-3xl);
        font-weight: 700;
        margin-block: var(--space-4);
        background: linear-gradient(
            135deg,
            var(--color-accent),
            var(--color-primary-light)
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1.6;
    }

    .fa-header .subtitle {
        font-size: var(--text-lg);
        color: var(--color-text-secondary);
        font-weight: 300;
        line-height: 1.8;
        text-align: center;
        text-align-last: center;
        margin: 0;
    }

    .ornament {
        font-size: var(--text-xl);
        color: var(--color-accent);
        opacity: 0.6;
        letter-spacing: 0.5em;
        text-align: center;
        margin-block: var(--space-12);
    }

    /* First ornament at top of page needs no top margin */
    .fa-header > .ornament:first-child {
        margin-block-start: 0;
    }

    /* Sections */
    .fa-section {
        margin-block: 0;
    }

    .fa-section p {
        font-size: var(--text-base);
        color: var(--color-text-secondary);
        line-height: 2;
        margin-block: 0 var(--space-4);
    }

    .fa-section h2 {
        font-size: var(--text-2xl);
        font-weight: 600;
        color: var(--color-accent);
        margin-block-end: var(--space-6);
        text-align: center;
    }

    /* Scientist Cards */
    .scientist-cards {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
        margin-block-start: var(--space-8);
    }

    .scientist-card {
        background: var(--color-background-secondary);
        border-radius: var(--radius-lg);
        padding: var(--space-6);
        border-right: 3px solid var(--color-accent);
        text-align: right;
        transition:
            transform var(--transition-fast),
            box-shadow var(--transition-fast);
    }

    .scientist-card:hover {
        transform: translateX(-4px);
        box-shadow: var(--glow-accent);
    }

    .scientist-card h3 {
        font-size: var(--text-xl);
        font-weight: 600;
        color: var(--color-text);
        margin-block-end: var(--space-1);
    }

    .scientist-card h3 a {
        color: inherit;
        text-decoration: none;
        border-bottom: 1px dashed var(--color-border);
        transition:
            border-color var(--transition-fast),
            color var(--transition-fast);
    }

    .scientist-card h3 a:hover {
        color: var(--color-accent);
        border-color: var(--color-accent);
    }

    .scientist-card .date {
        font-size: var(--text-sm);
        color: var(--color-accent);
        font-weight: 500;
        display: block;
        margin-block-end: var(--space-3);
    }

    .scientist-card p {
        font-size: var(--text-sm);
        color: var(--color-text-secondary);
        line-height: 1.9;
        margin: 0;
    }

    .scientist-card em {
        color: var(--color-primary-light);
        font-style: normal;
        font-weight: 500;
    }

    /* Divider - moved to ornament section above */

    /* Personal section */
    .personal {
        background: var(--color-background-secondary);
        border-radius: var(--radius-xl);
        padding: var(--space-8);
        border: 1px solid var(--color-border);
    }

    .fa-section.personal p {
        text-align: center;
        text-align-last: center;
        line-height: 2.2;
    }

    /* Footer */
    .fa-footer {
        text-align: center;
        margin-block: 0;
        padding-block: 0;
    }

    .lotus {
        display: flex;
        justify-content: center;
        margin-block: var(--space-4);
    }

    .lotus-img {
        width: 56px;
        height: auto;
        opacity: 0.6;
        filter: brightness(0) invert(0.7) sepia(1) saturate(3) hue-rotate(10deg)
            drop-shadow(0 0 8px hsla(35, 85%, 65%, 0.35));
    }

    .fa-footer .wish {
        font-size: var(--text-lg);
        color: var(--color-text-secondary);
        line-height: 2.2;
        font-weight: 400;
        text-align: center;
        text-align-last: center;
        margin-block: 0;
    }

    .fa-footer .wish-secondary {
        font-size: var(--text-base);
        color: var(--color-text-muted);
        font-weight: 300;
        font-style: italic;
        display: block;
        text-align: center;
        text-align-last: center;
    }

    .wish-date {
        display: block;
        font-size: var(--text-sm);
        color: var(--color-text-muted);
        opacity: 0.6;
        margin-block-start: var(--space-4);
        text-align: center;
    }

    /* Back button */
    .back-link {
        display: flex;
        justify-content: center;
        margin-block-start: var(--space-8);
        direction: ltr;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 1px solid var(--color-border);
        color: var(--color-text-muted);
        background: var(--color-background-secondary);
        text-decoration: none;
        transition: all var(--transition-fast);
    }

    .back-btn:hover {
        color: var(--color-primary);
        border-color: var(--color-primary);
        transform: scale(1.1);
    }

    @media (max-width: 640px) {
        .fa-header h1 {
            font-size: var(--text-2xl);
        }

        .personal {
            padding: var(--space-6);
        }
    }
</style>
