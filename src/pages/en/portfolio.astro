---
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import ProjectTimeline from "../../components/ProjectTimeline.astro";
import { getCollection } from "astro:content";
import { sortProjects } from "../../utils/catalogue";

// Get all projects sorted by end_date (most recent first, ongoing projects first)
const allProjects = await getCollection("projects", ({ data }) => {
    return data.locale === "en";
});
const projects = sortProjects(allProjects);

// Group by featured/not featured
const featuredProjects = projects.filter((p) => p.data.featured);
const regularProjects = projects.filter((p) => !p.data.featured);
---

<PageLayout
    title="Portfolio - Vincent Foriel"
    description="Research projects and software developments in astronomical instrumentation"
    currentPath={Astro.url.pathname}
>
    <Section>
        <div class="page-header">
            <h1>Portfolio</h1>
            <p class="lead">
                Discover all my projects, whether research, studies, associative
                or personal projects, related to astronomy or not.
            </p>
        </div>
    </Section>

    {
        featuredProjects.length > 0 && (
            <Section>
                <h2 class="section-title">Main Projects</h2>
                <div class="projects-grid">
                    {featuredProjects.map((project, index) => {
                        // Remove .en suffix from slug (e.g., "heliosen" -> "helios")
                        const cleanSlug = project.id.replace(/en$/, "");
                        return (
                            <ProjectCard
                                title={project.data.title}
                                description={project.data.description}
                                startDate={project.data["start-date"]}
                                endDate={project.data["end-date"]}
                                tags={project.data.tags}
                                image={project.data.image}
                                projectSlug={cleanSlug}
                                externalUrl={project.data.url}
                                lang="en"
                                priority={index < 2}
                            />
                        );
                    })}
                </div>
            </Section>
        )
    }

    <Section>
        <ProjectTimeline projects={projects} lang="en" />
    </Section>

    <Section class="cta-section">
        <div class="cta-box">
            <h2>Interested in my work?</h2>
            <p>
                To discuss a collaboration, a research project or simply
                exchange on these topics, feel free to contact me.
            </p>
            <a
                href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}en/contact/`}
                class="button">Get in touch</a
            >
        </div>
    </Section>
</PageLayout>

<style>
    .page-header {
        padding-block: var(--space-4) var(--space-10);
        border-bottom: 1px solid var(--color-border);
    }

    .page-header h1 {
        font-size: clamp(2.5rem, 6vw, 4.25rem);
        margin-block-end: var(--space-4);
    }

    .lead {
        font-size: var(--text-xl);
        color: var(--color-text-secondary);
        max-width: 52ch;
    }

    .section-title {
        font-size: var(--text-3xl);
        margin-block-end: var(--space-10);
        padding-block-end: var(--space-4);
        border-bottom: 1px solid var(--color-border);
    }

    .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(350px, 100%), 1fr));
        gap: var(--space-10);
    }

    .cta-section {
        background: none;
    }

    .cta-box {
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: var(--space-12);
        align-items: start;
        padding-block-start: var(--space-10);
        border-top: 1px solid var(--color-border);
    }

    .cta-box h2 {
        font-size: var(--text-4xl);
        font-style: italic;
        grid-row: span 2;
    }

    .cta-box p {
        font-size: var(--text-lg);
        color: var(--color-text-secondary);
        margin-block-end: var(--space-6);
    }

    @media (max-width: 768px) {
        .projects-grid {
            grid-template-columns: 1fr;
        }
    }

    .cta-box > :not(h2) {
        grid-column: 2;
        justify-self: start;
    }

    @media (max-width: 768px) {
        .cta-box {
            grid-template-columns: 1fr;
        }

        .cta-box h2 {
            font-size: var(--text-3xl);
            margin-block-end: var(--space-4);
        }

        .cta-box > :not(h2) {
            grid-column: 1;
        }
    }
</style>
