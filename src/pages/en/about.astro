---
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";
import SpaceInvaders from "../../components/SpaceInvaders.astro";

const birthDate = new Date("1997-09-28");
const today = new Date();
let age = today.getFullYear() - birthDate.getFullYear();
const m = today.getMonth() - birthDate.getMonth();
if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) {
    age--;
}
---

<PageLayout
    title="About - Vincent Foriel"
    description="Background and research of Vincent Foriel, PhD candidate in astrophotonics"
    currentPath={Astro.url.pathname}
>
    <Section>
        <div class="about-header">
            <h1>About</h1>
            <p class="lead">
                PhD candidate in astronomical instrumentation, high-contrast
                imaging and optical simulation
            </p>
        </div>
    </Section>

    <Section>
        <div class="content-grid">
            <div class="content-main">
                <h2>My Journey</h2>
                <aside class="sidenote sidenote--sheet">
                    <h3>👤 About me</h3>
                    <dl class="datasheet">
                        <div class="datasheet__row"><dt>Age</dt><dd>{age} years old</dd></div>
                        <div class="datasheet__row"><dt>Gender</dt><dd>Male</dd></div>
                        <div class="datasheet__row"><dt>Origin</dt><dd>French</dd></div>
                        <div class="datasheet__row"><dt>Birthplace</dt><dd>Cagnes-sur-Mer</dd></div>
                        <div class="datasheet__row"><dt>Location</dt><dd>Nice, France</dd></div>
                    </dl>
                </aside>
                <p>
                    <span class="easter-egg-trigger">Space</span> has always fascinated
                    me — black holes, neutron stars, the sheer scale of cosmic structures.
                    This passion was fueled by Stephen Hawking's books as much as
                    by works like <em>Star Trek</em> or{" "}
                    <em>Interstellar</em>.
                </p>

                <p>
                    I first pursued a computer science degree, a field where I
                    had natural aptitude. But it was through following science
                    communicators and experimenting with physics modeling
                    through gaming that I made peace with math and decided to
                    pivot toward physics.<sup class="sidenote-ref"><a href="#note-1">1</a></sup>
                </p>
                <aside class="sidenote" id="note-1">
                    <h3><span class="sidenote__number">1</span>🎮 Fun fact</h3>
                    <p>
                        It was while building a projectile system in Minecraft —
                        point physics, trigonometry — that I decided to pursue
                        physics studies.
                    </p>
                    <p>
                        That project gave birth to{" "}
                        <a
                            href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}en/associations`}
                            >Altearn</a
                        > and{" "}
                        <a
                            href="https://docs.mcbookshelf.dev/en/latest/"
                            target="_blank"
                            rel="noopener">Bookshelf</a
                        >, a real Minecraft development library featuring math
                        and physics tools.
                    </p>
                </aside>

                <p>
                    Today, as a PhD candidate in astrophotonics, I design and
                    analyze instruments for astronomical observation. I adapt to
                    everything — theoretical as well as experimental physics —
                    but I particularly enjoy <strong
                        >computational physics</strong
                    >: from physical simulations to developing human-machine and
                    machine-machine interfaces for scientific or outreach
                    applications.
                </p>

                <h2>My Work Philosophy</h2>
                <p>Four principles guide my daily work:<sup class="sidenote-ref"><a href="#note-2">2</a></sup></p>

                <aside class="sidenote" id="note-2">
                    <h3><span class="sidenote__number">2</span>🎨 Jack of all trades</h3>
                    <p class="interests-text">
                        I love learning and exploring new fields. Piano today,
                        Japanese tomorrow, 3D printing next week — the subject
                        doesn't matter, curiosity is what drives me.
                    </p>
                </aside>

                <ul class="values-list">
                    <li>
                        <strong>Curiosity first</strong> — Explore, let yourself be
                        surprised, follow an unexpected lead. The best discoveries
                        often come from what you didn't plan to study.
                    </li>
                    <li>
                        <strong>Make it simple</strong> — What is well conceived is
                        clearly expressed. No dark corners, no unnecessarily complex
                        formulas, only simple words and decomposed logic.
                    </li>
                    <li>
                        <strong>Elegance is a feature</strong> — A performant system
                        is not enough. Its elegance, intuitiveness, and the pleasure
                        of using it matter just as much. A well-designed axe head
                        is useless if the handle isn't.
                    </li>
                    <li>
                        <strong>Never do something twice</strong> — Automate everything
                        that can be automated. Scripts, pipelines, CI/CD: every repetitive
                        task deserves to become a reliable, reproducible process.
                    </li>
                </ul>

                <h2>Organization</h2>
                <p>
                    I rely on project forges — GitHub, GitLab, Redmine,
                    OpenProject — to structure my work: issue management, code
                    reviews, integrated documentation. This approach lets me
                    work effectively with{" "}
                    <strong>autonomy</strong> while making collaboration seamless
                    when opportunities arise.
                </p>
            </div>
        </div>
    </Section>
    <SpaceInvaders />
</PageLayout>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const triggers = document.querySelectorAll(".easter-egg-trigger");
        triggers.forEach((trigger) => {
            trigger.addEventListener("click", () => {
                document.dispatchEvent(new CustomEvent("open-easter-egg"));
            });
        });
    });
</script>

<style>
    .about-header {
        padding-block: var(--space-4) var(--space-10);
        border-bottom: 1px solid var(--color-border);
    }

    .about-header h1 {
        font-size: clamp(2.5rem, 6vw, 4.25rem);
        margin-block-end: var(--space-4);
    }

    .lead {
        font-size: var(--text-xl);
        color: var(--color-text-secondary);
        max-width: 52ch;
    }

    .content-grid {
        display: block;
    }

    .content-main {
        position: relative;
        max-width: 40rem;
    }

    .content-main h2 {
        font-size: var(--text-3xl);
        margin-block: var(--space-12) var(--space-4);
    }

    .content-main h2:first-of-type {
        margin-block-start: 0;
    }

    .content-main p {
        margin-block-end: var(--space-4);
        color: var(--color-text-secondary);
    }

    .expertise-list,
    .values-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        margin-block: var(--space-6);
    }

    .expertise-list li,
    .values-list li {
        padding-inline-start: var(--space-6);
        position: relative;
        color: var(--color-text-secondary);
    }

    .expertise-list li::before,
    .values-list li::before {
        content: "—";
        position: absolute;
        left: 0;
        color: var(--color-text-muted);
    }

    /* Notes en marge (à la Tufte) : flottantes dans la marge droite, en ligne sur écran étroit */
    .sidenote {
        float: right;
        clear: right;
        width: 18rem;
        margin-right: -22rem;
        margin-block: 0.4rem var(--space-8);
        padding-block-start: var(--space-3);
        border-top: 1px solid var(--color-border);
        font-size: var(--text-sm);
    }

    .sidenote h3 {
        display: flex;
        align-items: baseline;
        gap: var(--space-2);
        font-size: var(--text-lg);
        margin-block-end: var(--space-3);
    }

    .content-main .sidenote p {
        font-size: var(--text-sm);
        margin-block-end: var(--space-2);
    }

    .sidenote a {
        color: var(--color-text);
        text-decoration: underline;
        text-decoration-color: var(--color-primary);
        text-underline-offset: 0.2em;
    }

    .sidenote__number,
    .sidenote-ref {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 400;
        color: var(--color-primary);
    }

    .sidenote-ref {
        margin-inline-start: 0.15em;
        line-height: 0;
    }

    .sidenote-ref a {
        color: inherit;
    }

    /* Fiche signalétique, comme sur les pages projet */
    .datasheet {
        margin: 0;
    }

    .datasheet__row {
        display: grid;
        grid-template-columns: 6.5rem minmax(0, 1fr);
        gap: var(--space-3);
        align-items: baseline;
        padding-block: var(--space-2);
        border-bottom: 1px solid var(--color-border-subtle);
    }

    .datasheet dt {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-text-muted);
    }

    .datasheet dd {
        margin: 0;
        color: var(--color-text);
    }

    @media (max-width: 1100px) {
        .content-main {
            max-width: 46rem;
        }

        .sidenote {
            float: none;
            width: auto;
            margin: var(--space-6) 0;
            padding: var(--space-4) var(--space-5);
            border-top: none;
            border-left: 1px solid var(--color-primary);
            background: rgba(var(--color-primary-rgb), 0.04);
        }
    }

    .easter-egg-trigger {
        cursor: text;
        user-select: none;
    }
</style>
