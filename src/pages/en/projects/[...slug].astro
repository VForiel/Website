---
import { getCollection, render } from "astro:content";
import ProjectLayout from "../../../layouts/ProjectLayout.astro";
import { sortProjects, designation } from "../../../utils/catalogue";

export async function getStaticPaths() {
    const projects = await getCollection("projects", ({ data }) => {
        return data.locale === "en";
    });

    const catalogue = sortProjects(projects);

    // Voisins dans le catalogue : « précédent » = plus ancien, « suivant » = plus récent
    const neighbour = (index: number) => {
        const other = catalogue[index];
        if (!other) return undefined;
        return {
            title: other.data.title,
            slug: other.id.replace(/en$/, ""),
            designation: designation(index, catalogue.length),
        };
    };

    return catalogue.map((project, index) => {
        // Remove .en suffix from slug (e.g., "heliosen" -> "helios")
        const cleanSlug = project.id.replace(/en$/, "");
        return {
            params: { slug: cleanSlug },
            props: {
                project,
                designation: designation(index, catalogue.length),
                previous: neighbour(index + 1),
                next: neighbour(index - 1),
            },
        };
    });
}

const { project, designation: catalogueId, previous, next } = Astro.props;
const { Content } = await render(project);
const {
    title,
    description,
    "start-date": startDate,
    "end-date": endDate,
    tags,
    image,
    url,
} = project.data;
---

<ProjectLayout
    title={title}
    description={description}
    startDate={startDate}
    endDate={endDate}
    tags={tags}
    image={image}
    url={url}
    lang="en"
    designation={catalogueId}
    previous={previous}
    next={next}
>
    <Content />
</ProjectLayout>
