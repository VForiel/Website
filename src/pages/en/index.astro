---
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import HeroPlate from "../../components/HeroPlate.astro";
import { getCollection } from "astro:content";
import { dateToTimestamp } from "../../utils/dates";

// Get top 4 services sorted by order
const allServices = await getCollection("services", ({ data }) => {
    return data.locale === "en";
});
const topServices = allServices
    .sort((a, b) => a.data.order - b.data.order)
    .slice(0, 4);

// Get featured projects
const allProjects = await getCollection("projects", ({ data }) => {
    return data.locale === "en";
});
const featuredProjects = allProjects
    .filter((project) => project.data.featured)
    .sort(
        (a, b) =>
            dateToTimestamp(b.data["end-date"]) -
            dateToTimestamp(a.data["end-date"]),
    );
---

<PageLayout
    title="Vincent Foriel - PhD Candidate in Astrophotonics"
    description="PhD candidate in astrophotonics, high-contrast imaging and optical simulation"
    currentPath={Astro.url.pathname}
>
    <!-- Hero Section -->
    <Section class="hero">
        <div class="hero__content">
            <p class="eyebrow hero__eyebrow">
                Astronomical instrumentation · High-contrast imaging ·
                Optical simulation
            </p>

            <h1 class="hero__title">
                PhD candidate in <em class="hero__highlight">astrophotonics</em>
            </h1>

            <p class="hero__description">
                Passionate about science and space, inspired by art and powered
                by computer science.
            </p>

            <div class="hero__cta">
                <a
                    href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}en/portfolio`}
                    class="button button--primary">Discover my projects</a
                >
                <a
                    href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}en/contact`}
                    class="link-underline">Contact me</a
                >
            </div>
        </div>

        <HeroPlate lang="en" />
    </Section>

    <!-- Expertise Overview -->
    <Section class="expertise-overview">
        <div class="section-head">
            <h2 class="section-head__title">
                <span class="section-head__index">01</span>
                Areas of Expertise
            </h2>
            <a
                href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}en/expertise`}
                class="section-head__link link-underline">All services</a
            >
        </div>

        <ol class="expertise-list">
            {
                topServices.map((service) => (
                    <li class="expertise-item">
                        <h3 class="expertise-item__title">
                            {service.data.title}
                        </h3>
                        <p class="expertise-item__description">
                            {service.data.description}
                        </p>
                    </li>
                ))
            }
        </ol>
    </Section>

    <!-- Featured Projects -->
    {
        featuredProjects.length > 0 && (
            <Section class="featured-projects">
                <div class="section-head">
                    <h2 class="section-head__title">
                        <span class="section-head__index">02</span>
                        Featured Projects
                    </h2>
                    <a
                        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}en/portfolio`}
                        class="section-head__link link-underline"
                    >
                        All projects
                    </a>
                </div>

                <div class="projects-grid">
                    {featuredProjects.map((project) => {
                        const cleanSlug = project.id.replace(/en$/, "");
                        return (
                            <ProjectCard
                                title={project.data.title}
                                description={project.data.description}
                                startDate={project.data["start-date"]}
                                endDate={project.data["end-date"]}
                                tags={project.data.tags}
                                image={project.data.image}
                                projectSlug={cleanSlug}
                                externalUrl={project.data.url}
                                lang="en"
                            />
                        );
                    })}
                </div>
            </Section>
        )
    }

    <!-- CTA Section -->
    <Section class="cta-section">
        <div class="cta-box">
            <h2 class="cta-box__title">Have a project?</h2>
            <div class="cta-box__body">
                <p class="cta-box__description">
                    I am available for research collaborations, technical
                    consulting, or science communication interventions.
                </p>
                <a
                    href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}en/contact`}
                    class="button button--primary">Let's discuss</a
                >
            </div>
        </div>
    </Section>
</PageLayout>

<style>
    /* Hero */
    /* La classe est posée sur le <section> du composant Section : hors de portée du style scopé */
    :global(.section.hero) {
        padding-block: var(--space-16) var(--space-12);
    }

    :global(.section.hero > .container) {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
        gap: var(--space-16);
        align-items: center;
    }

    .hero__content {
        max-width: 40rem;
    }

    .hero__eyebrow {
        margin-block-end: var(--space-6);
    }

    .hero__title {
        font-size: clamp(2.75rem, 6vw, 5rem);
        line-height: 1.02;
        margin-block-end: var(--space-8);
    }

    .hero__highlight {
        font-style: italic;
        color: var(--color-primary);
    }

    .hero__description {
        font-size: var(--text-xl);
        color: var(--color-text-secondary);
        margin-block-end: var(--space-10);
        max-width: 38ch;
    }

    .hero__cta {
        display: flex;
        align-items: center;
        gap: var(--space-8);
        flex-wrap: wrap;
    }

    /* Domaines d'expertise : colonnes séparées par des filets */
    .expertise-list {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        counter-reset: expertise;
    }

    .expertise-item {
        counter-increment: expertise;
        padding: var(--space-2) var(--space-6) var(--space-4);
        border-left: 1px solid var(--color-border);
    }

    .expertise-item:first-child {
        padding-left: 0;
        border-left: none;
    }

    .expertise-item::before {
        content: counter(expertise, lower-alpha) ".";
        display: block;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-text-muted);
        margin-block-end: var(--space-4);
    }

    .expertise-item__title {
        font-size: var(--text-xl);
        margin-block-end: var(--space-3);
    }

    .expertise-item__description {
        color: var(--color-text-secondary);
        font-size: var(--text-sm);
    }

    /* Projets */
    .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
        gap: var(--space-10);
    }

    /* Appel à contact */
    .cta-box {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-12);
        align-items: start;
        padding-block-start: var(--space-10);
        border-top: 1px solid var(--color-border);
    }

    .cta-box__title {
        font-size: var(--text-4xl);
        font-style: italic;
    }

    .cta-box__description {
        font-size: var(--text-lg);
        color: var(--color-text-secondary);
        margin-block-end: var(--space-6);
    }

    @media (max-width: 900px) {
        :global(.section.hero) {
            padding-block: var(--space-12) var(--space-8);
        }

        :global(.section.hero > .container) {
            grid-template-columns: 1fr;
            gap: var(--space-12);
        }

        :global(.section.hero .plate) {
            justify-self: start;
        }

        .hero__description {
            font-size: var(--text-lg);
        }

        .expertise-list {
            grid-template-columns: repeat(2, 1fr);
            row-gap: var(--space-8);
        }

        .expertise-item:nth-child(odd) {
            padding-left: 0;
            border-left: none;
        }

        .cta-box {
            grid-template-columns: 1fr;
            gap: var(--space-6);
        }

        .cta-box__title {
            font-size: var(--text-3xl);
        }
    }

    @media (max-width: 480px) {
        .expertise-list {
            grid-template-columns: 1fr;
        }

        .expertise-item {
            padding-left: 0;
            border-left: none;
            padding-block-start: var(--space-4);
            border-top: 1px solid var(--color-border-subtle);
        }

        .expertise-item:first-child {
            border-top: none;
        }
    }
</style>
