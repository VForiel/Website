---
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";
---

<PageLayout
    title="CV - Vincent Foriel"
    description="Curriculum Vitae of Vincent Foriel, expert in astrophotonics instrumentation"
    currentPath={Astro.url.pathname}
>
    <Section class="cv-section">
        <div class="cv-header">
            <h1>Curriculum Vitae</h1>
            <div class="cv-contact">
                <span>vincent.foriel@gmail.com</span>
                <span>•</span>
                <span>Nice, France</span>
            </div>
        </div>

        <div class="cv-content">
            <!-- Education -->
            <div class="cv-block">
                <h2 class="cv-block__title">Education</h2>

                <div class="cv-item">
                    <div class="cv-item__header">
                        <h3 class="cv-item__title">PhD in Astrophotonics</h3>
                        <span class="cv-item__date">2021 - 2024</span>
                    </div>
                    <div class="cv-item__subtitle">
                        Observatoire de la Côte d'Azur
                    </div>
                    <p class="cv-item__description">
                        Development of end-to-end simulation methods for
                        high-contrast imaging. Design of software tools for
                        analyzing coronagraphic instrument performance.
                    </p>
                </div>

                <div class="cv-item">
                    <div class="cv-item__header">
                        <h3 class="cv-item__title">Master's in Astrophysics</h3>
                        <span class="cv-item__date">2019 - 2021</span>
                    </div>
                    <div class="cv-item__subtitle">Université Côte d'Azur</div>
                    <p class="cv-item__description">
                        Specialization in astronomical instrumentation and
                        observation techniques.
                    </p>
                </div>
            </div>

            <!-- Experience -->
            <div class="cv-block">
                <h2 class="cv-block__title">Professional Experience</h2>

                <div class="cv-item">
                    <div class="cv-item__header">
                        <h3 class="cv-item__title">
                            Researcher in optical instrumentation
                        </h3>
                        <span class="cv-item__date">2021 - Present</span>
                    </div>
                    <div class="cv-item__subtitle">
                        Observatoire de la Côte d'Azur
                    </div>
                    <ul class="cv-item__list">
                        <li>
                            Development of simulation frameworks for
                            high-contrast instruments
                        </li>
                        <li>
                            Performance analysis of coronagraphic architectures
                        </li>
                        <li>
                            International collaboration on instrumental projects
                            (ESO, NASA)
                        </li>
                        <li>Supervision of Master's students</li>
                    </ul>
                </div>

                <div class="cv-item">
                    <div class="cv-item__header">
                        <h3 class="cv-item__title">
                            Scientific software developer
                        </h3>
                        <span class="cv-item__date">2020 - 2021</span>
                    </div>
                    <div class="cv-item__subtitle">
                        Collaborative research project
                    </div>
                    <ul class="cv-item__list">
                        <li>
                            Development of Python tools for astronomical data
                            analysis
                        </li>
                        <li>Optimization of image processing pipelines</li>
                        <li>Technical documentation and user training</li>
                    </ul>
                </div>
            </div>

            <!-- Skills -->
            <div class="cv-block">
                <h2 class="cv-block__title">Skills</h2>

                <div class="cv-skills">
                    <div class="cv-skill-group">
                        <h3>Programming</h3>
                        <p>
                            Python (expert), C/C++, Fortran, Git/GitHub, CI/CD
                        </p>
                    </div>

                    <div class="cv-skill-group">
                        <h3>Scientific tools</h3>
                        <p>
                            NumPy, SciPy, Matplotlib, Astropy, Pandas, Jupyter
                        </p>
                    </div>

                    <div class="cv-skill-group">
                        <h3>Areas of expertise</h3>
                        <p>
                            Physical optics, Image processing, Numerical
                            simulation, Statistical analysis
                        </p>
                    </div>

                    <div class="cv-skill-group">
                        <h3>Languages</h3>
                        <p>
                            French (native), English (fluent - B2/C1), Spanish
                            (A1), Japanese (A1)
                        </p>
                    </div>
                </div>
            </div>

            <!-- Publications -->
            <div class="cv-block">
                <h2 class="cv-block__title">Publications & Presentations</h2>

                <div class="cv-item">
                    <p class="cv-item__description">
                        Publications in peer-reviewed journals (A&A, SPIE
                        Proceedings)
                    </p>
                    <p class="cv-item__description">
                        Oral presentations and posters at international
                        conferences
                    </p>
                </div>
            </div>

            <!-- Qualities -->
            <div class="cv-block">
                <h2 class="cv-block__title">Qualities</h2>
                <div class="cv-qualities">
                    <span class="cv-quality">Creative</span>
                    <span class="cv-quality">Curious</span>
                    <span class="cv-quality">Autonomous</span>
                    <span class="cv-quality">Altruistic</span>
                </div>
            </div>
        </div>

        <div class="cv-footer">
            <a href={`${import.meta.env.BASE_URL}en/contact`} class="button"
                >Contact me</a
            >
            <button onclick="window.print()" class="button button--secondary"
                >Print CV</button
            >
        </div>
    </Section>
</PageLayout>

<style>
    .cv-section {
        max-width: 900px;
        margin-inline: auto;
    }

    .cv-header {
        text-align: center;
        margin-block-end: var(--space-12);
        padding-block-end: var(--space-8);
        border-bottom: 2px solid var(--color-border);
    }

    .cv-header h1 {
        font-size: var(--text-4xl);
        margin-block-end: var(--space-3);
    }

    .cv-contact {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-3);
        font-size: var(--text-sm);
        color: var(--color-text-secondary);
    }

    .cv-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-12);
        padding: var(--space-8);
        background-color: var(--color-background-secondary);
        border-radius: var(--radius-lg);
    }

    .cv-block__title {
        font-size: var(--text-2xl);
        color: var(--color-primary);
        margin-block-end: var(--space-6);
        padding-block-end: var(--space-2);
        border-bottom: 1px solid var(--color-border);
    }

    .cv-item {
        margin-block-end: var(--space-8);
    }

    .cv-item:last-child {
        margin-block-end: 0;
    }

    .cv-item__header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: var(--space-4);
        margin-block-end: var(--space-2);
    }

    .cv-item__title {
        font-size: var(--text-xl);
        font-weight: 600;
    }

    .cv-item__date {
        font-size: var(--text-sm);
        color: var(--color-text-muted);
        white-space: nowrap;
    }

    .cv-item__subtitle {
        font-size: var(--text-base);
        color: var(--color-text-secondary);
        font-style: italic;
        margin-block-end: var(--space-3);
    }

    .cv-item__description {
        color: var(--color-text-secondary);
        line-height: 1.6;
        margin-block-end: var(--space-2);
    }

    .cv-item__list {
        list-style: disc;
        padding-inline-start: var(--space-6);
        color: var(--color-text-secondary);
    }

    .cv-item__list li {
        margin-block-end: var(--space-2);
    }

    .cv-skills {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: var(--space-6);
    }

    .cv-skill-group h3 {
        font-size: var(--text-base);
        font-weight: 600;
        margin-block-end: var(--space-2);
    }

    .cv-skill-group p {
        font-size: var(--text-sm);
        color: var(--color-text-secondary);
        line-height: 1.6;
    }

    .cv-qualities {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3);
    }

    .cv-quality {
        padding: var(--space-2) var(--space-4);
        background-color: var(--color-background-secondary);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        font-size: var(--text-sm);
        font-weight: 500;
    }

    .cv-footer {
        margin-block-start: var(--space-16);
        padding-block-start: var(--space-8);
        border-top: 2px solid var(--color-border);
        display: flex;
        justify-content: center;
        gap: var(--space-4);
        flex-wrap: wrap;
    }

    .button {
        display: inline-block;
        padding: var(--space-4) var(--space-8);
        font-size: var(--text-base);
        font-weight: 500;
        background-color: var(--color-primary);
        color: white;
        border-radius: var(--radius-md);
        transition: all var(--transition-base);
        border: 2px solid transparent;
        cursor: pointer;
    }

    .button:hover {
        background-color: var(--color-primary-dark);
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
    }

    .button--secondary {
        background-color: transparent;
        color: var(--color-text);
        border-color: var(--color-border);
    }

    .button--secondary:hover {
        background-color: var(--color-background-secondary);
        border-color: var(--color-primary);
        color: var(--color-primary);
    }

    /* Print styles */
    @media print {
        .cv-footer {
            display: none;
        }

        @page {
            margin: 2cm;
        }
    }

    @media (max-width: 768px) {
        .cv-item__header {
            flex-direction: column;
            align-items: flex-start;
            gap: var(--space-1);
        }

        .cv-skills {
            grid-template-columns: 1fr;
        }
    }
</style>
