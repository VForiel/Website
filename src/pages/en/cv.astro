---
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";

const birthDate = new Date("1997-09-28");
const today = new Date();
let age = today.getFullYear() - birthDate.getFullYear();
const m = today.getMonth() - birthDate.getMonth();
if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) {
    age--;
}
---

<PageLayout
    title="CV - Vincent Foriel"
    description="Curriculum Vitae of Vincent Foriel, expert in astrophotonics instrumentation"
    currentPath={Astro.url.pathname}
>
    <Section class="cv-section">
        <div class="cv-header">
            <h1>Curriculum Vitae</h1>
            <div class="cv-contact">
                <span>{age} years old</span>
                <span>•</span>
                <span>vincent.foriel@gmail.com</span>
                <span>•</span>
                <span>Nice, France</span>
            </div>
        </div>

        <div class="cv-content">
            <!-- Education -->
            <div class="cv-block">
                <h2 class="cv-block__title">Education</h2>

                <div class="cv-item">
                    <div class="cv-item__header">
                        <h3 class="cv-item__title">
                            PhD Student in Astrophotonics
                        </h3>
                        <span class="cv-item__date">Nov. 2023 - Present</span>
                    </div>
                    <div class="cv-item__subtitle">
                        Observatoire de la Côte d'Azur (OCA), Nice
                    </div>
                    <p class="cv-item__description">
                        Improving the nulling interferometry technique via the
                        development of a phase-adjustable photonic component for
                        exoplanet detection.
                    </p>
                </div>

                <div class="cv-item">
                    <div class="cv-item__header">
                        <h3 class="cv-item__title">
                            Master's in Computational Physics
                        </h3>
                        <span class="cv-item__date">Sept. 2021 - Jul. 2023</span
                        >
                    </div>
                    <div class="cv-item__subtitle">
                        Université de Bourgogne Franche-Comté (UBFC), Besançon
                    </div>
                </div>

                <div class="cv-item">
                    <div class="cv-item__header">
                        <h3 class="cv-item__title">
                            Bachelor's in Fundamental Physics
                        </h3>
                        <span class="cv-item__date">Sept. 2017 - Jul. 2021</span
                        >
                    </div>
                    <div class="cv-item__subtitle">
                        Université Côte d'Azur (UniCA), Nice
                    </div>
                </div>

                <div class="cv-item">
                    <div class="cv-item__header">
                        <h3 class="cv-item__title">
                            DUT in Networks and Telecommunications
                        </h3>
                        <span class="cv-item__date">Sept. 2015 - Jul. 2017</span
                        >
                    </div>
                    <div class="cv-item__subtitle">
                        Université Côte d'Azur (UniCA), Nice
                    </div>
                </div>
            </div>

            <!-- Experience -->
            <div class="cv-block">
                <h2 class="cv-block__title">Professional Experience</h2>

                <div class="cv-item">
                    <div class="cv-item__header">
                        <h3 class="cv-item__title">
                            Corporate Internship: Unveiling the 3D structure of
                            pre-stellar cores (ML)
                        </h3>
                        <span class="cv-item__date">Feb. 2023 - Mar. 2022</span>
                    </div>
                    <div class="cv-item__subtitle">
                        Université de Bourgogne Franche-Comté (UBFC), Besançon
                    </div>
                    <p class="cv-item__description">
                        Study of a convolutional network's ability to infer the
                        properties of a pre-stellar core from numerically
                        generated observations.
                    </p>
                </div>

                <div class="cv-item">
                    <div class="cv-item__header">
                        <h3 class="cv-item__title">
                            Laboratory Project: Determining TNO detection
                            efficiency (ML)
                        </h3>
                        <span class="cv-item__date">Nov. 2021 - Jun. 2022</span>
                    </div>
                    <div class="cv-item__subtitle">
                        Université de Bourgogne Franche-Comté (UBFC), Besançon
                    </div>
                    <p class="cv-item__description">
                        Study of neural networks' functioning and their ability
                        to extrapolate detection efficiency model parameters.
                    </p>
                </div>

                <div class="cv-item">
                    <div class="cv-item__header">
                        <h3 class="cv-item__title">
                            Tutored Project: Stellar Coronagraphy
                        </h3>
                        <span class="cv-item__date">Mar. 2020 - Jun. 2020</span>
                    </div>
                    <div class="cv-item__subtitle">
                        Université Côte d'Azur (UCA), Nice
                    </div>
                    <p class="cv-item__description">
                        Simulation of light behavior in a telescope.
                    </p>
                </div>
            </div>

            <!-- Skills -->
            <div class="cv-block">
                <h2 class="cv-block__title">Skills</h2>

                <div class="cv-skills">
                    <div class="cv-skill-group">
                        <h3>Programming</h3>
                        <p>
                            Python (expert), C/C++, Fortran, Git/GitHub, CI/CD
                        </p>
                    </div>

                    <div class="cv-skill-group">
                        <h3>Scientific tools</h3>
                        <p>
                            NumPy, SciPy, Matplotlib, Astropy, Pandas, Jupyter
                        </p>
                    </div>

                    <div class="cv-skill-group">
                        <h3>Areas of expertise</h3>
                        <p>
                            Physical optics, Image processing, Numerical
                            simulation, Statistical analysis
                        </p>
                    </div>

                    <div class="cv-skill-group">
                        <h3>Languages</h3>
                        <p>
                            French (native), English (fluent - B2/C1), Spanish
                            (A1), Japanese (A1)
                        </p>
                    </div>
                </div>
            </div>

            <!-- Publications & Presentations -->
            <div class="cv-block">
                <h2 class="cv-block__title">Publications & Presentations</h2>

                <div class="cv-item">
                    <div class="cv-item__header">
                        <h3 class="cv-item__title">Conference Presentations</h3>
                    </div>
                    <ul class="cv-item__list">
                        <li>
                            <strong
                                >SPIE Astronomical Telescopes + Instrumentation</strong
                            > (Copenhagen) — <em>June 2026 (Upcoming)</em>
                        </li>
                        <li>
                            <strong>LIFE Conference</strong> — <em
                                >November 2025</em
                            >
                        </li>
                        <li>
                            <strong>WITSO</strong> (ESA Workshop, Leiden) — <em
                                >October 2025</em
                            >
                        </li>
                        <li>
                            <strong
                                >SPIE Astronomical Telescopes + Instrumentation</strong
                            > (Yokohama) — <em>June 2023</em>
                        </li>
                    </ul>
                </div>

                <div class="cv-item">
                    <div class="cv-item__header">
                        <h3 class="cv-item__title">Scientific Publications</h3>
                    </div>
                    <ul class="cv-item__list">
                        <li>1 paper in finalization</li>
                        <li>
                            2 papers partially written, awaiting experimental
                            results
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Qualities -->
            <div class="cv-block">
                <h2 class="cv-block__title">Qualities</h2>
                <div class="cv-qualities">
                    <span class="cv-quality">Creative</span>
                    <span class="cv-quality">Curious</span>
                    <span class="cv-quality">Autonomous</span>
                    <span class="cv-quality">Altruistic</span>
                </div>
            </div>
        </div>
    </Section>
</PageLayout>

<style>
    .cv-section {
        max-width: 900px;
        margin-inline: auto;
    }

    .cv-header {
        text-align: center;
        margin-block-end: var(--space-12);
        padding-block-end: var(--space-8);
        border-bottom: 2px solid var(--color-border);
    }

    .cv-header h1 {
        font-size: var(--text-4xl);
        margin-block-end: var(--space-3);
    }

    .cv-contact {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-3);
        font-size: var(--text-sm);
        color: var(--color-text-secondary);
    }

    .cv-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-12);
        padding: var(--space-8);
        background-color: var(--color-background-secondary);
        border-radius: var(--radius-lg);
    }

    .cv-block__title {
        font-size: var(--text-2xl);
        color: var(--color-primary);
        margin-block-end: var(--space-6);
        padding-block-end: var(--space-2);
        border-bottom: 1px solid var(--color-border);
    }

    .cv-item {
        margin-block-end: var(--space-8);
    }

    .cv-item:last-child {
        margin-block-end: 0;
    }

    .cv-item__header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: var(--space-4);
        margin-block-end: var(--space-2);
    }

    .cv-item__title {
        font-size: var(--text-xl);
        font-weight: 600;
    }

    .cv-item__date {
        font-size: var(--text-sm);
        color: var(--color-text-muted);
        white-space: nowrap;
    }

    .cv-item__subtitle {
        font-size: var(--text-base);
        color: var(--color-text-secondary);
        font-style: italic;
        margin-block-end: var(--space-3);
    }

    .cv-item__description {
        color: var(--color-text-secondary);
        line-height: 1.6;
        margin-block-end: var(--space-2);
    }

    .cv-item__list {
        list-style: disc;
        padding-inline-start: var(--space-6);
        color: var(--color-text-secondary);
    }

    .cv-item__list li {
        margin-block-end: var(--space-2);
    }

    .cv-skills {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: var(--space-6);
    }

    .cv-skill-group h3 {
        font-size: var(--text-base);
        font-weight: 600;
        margin-block-end: var(--space-2);
    }

    .cv-skill-group p {
        font-size: var(--text-sm);
        color: var(--color-text-secondary);
        line-height: 1.6;
    }

    .cv-qualities {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3);
    }

    .cv-quality {
        padding: var(--space-2) var(--space-4);
        background-color: var(--color-background-secondary);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        font-size: var(--text-sm);
        font-weight: 500;
    }

    .cv-footer {
        margin-block-start: var(--space-16);
        padding-block-start: var(--space-8);
        border-top: 2px solid var(--color-border);
        display: flex;
        justify-content: center;
        gap: var(--space-4);
        flex-wrap: wrap;
    }

    .button {
        display: inline-block;
        padding: var(--space-4) var(--space-8);
        font-size: var(--text-base);
        font-weight: 500;
        background-color: var(--color-primary);
        color: white;
        border-radius: var(--radius-md);
        transition: all var(--transition-base);
        border: 2px solid transparent;
        cursor: pointer;
    }

    .button:hover {
        background-color: var(--color-primary-dark);
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
    }

    .button--secondary {
        background-color: transparent;
        color: var(--color-text);
        border-color: var(--color-border);
    }

    .button--secondary:hover {
        background-color: var(--color-background-secondary);
        border-color: var(--color-primary);
        color: var(--color-primary);
    }

    /* Print styles */
    @media print {
        .cv-footer {
            display: none;
        }

        @page {
            margin: 2cm;
        }
    }

    @media (max-width: 768px) {
        .cv-item__header {
            flex-direction: column;
            align-items: flex-start;
            gap: var(--space-1);
        }

        .cv-skills {
            grid-template-columns: 1fr;
        }
    }
</style>
