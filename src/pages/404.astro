---
// Page servie par GitHub Pages pour toute adresse inconnue, quelle que soit la langue : contenu bilingue
import PageLayout from "../layouts/PageLayout.astro";
import Section from "../components/Section.astro";
import HeroPlate from "../components/HeroPlate.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<PageLayout
    title="Objet introuvable · Object not found - Vincent Foriel"
    description="Cette page n'existe pas. This page does not exist."
    currentPath="/fr/404"
>
    <Section class="not-found">
        <div class="not-found__text">
            <p class="eyebrow">Erreur 404 · Objet introuvable</p>
            <h1>Rien à ces coordonnées.</h1>
            <p class="not-found__lead">
                La page demandée n'existe pas, ou plus. Le catalogue, lui, est
                toujours là.
            </p>
            <p class="not-found__en" lang="en">
                Nothing at these coordinates: the page you asked for does not
                exist. The catalogue is still there.
            </p>

            <div class="not-found__actions">
                <a href={`${base}/fr/`} class="button">Retour à l'accueil</a>
                <a href={`${base}/fr/portfolio/`} class="link-underline">Parcourir le catalogue</a>
                <button type="button" class="link-underline not-found__search" data-search-open>
                    Rechercher
                </button>
            </div>
            <p class="not-found__en-links" lang="en">
                <a href={`${base}/en/`} class="link-underline">Home</a>
                ·
                <a href={`${base}/en/portfolio/`} class="link-underline">Catalogue</a>
            </p>
        </div>

        <HeroPlate
            lang="fr"
            variant="empty"
            fig="Fig. 404"
            caption="Aucun objet détecté au-dessus du bruit. · No object detected above the noise."
        />
    </Section>
</PageLayout>

<style>
    :global(.section.not-found > .container) {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
        gap: var(--space-16);
        align-items: center;
    }

    h1 {
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        margin-block: var(--space-4) var(--space-6);
    }

    .not-found__lead {
        font-size: var(--text-xl);
        color: var(--color-text-secondary);
        max-width: 36ch;
    }

    .not-found__en {
        margin-block-start: var(--space-3);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-text-muted);
        max-width: 52ch;
    }

    .not-found__actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-4) var(--space-8);
        margin-block-start: var(--space-10);
    }

    .not-found__search {
        padding: 0;
        border: none;
        background: none;
        font: inherit;
        cursor: pointer;
    }

    .not-found__en-links {
        display: flex;
        gap: var(--space-2);
        margin-block-start: var(--space-4);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-text-muted);
    }

    @media (max-width: 900px) {
        :global(.section.not-found > .container) {
            grid-template-columns: 1fr;
            gap: var(--space-12);
        }

        :global(.section.not-found .plate) {
            justify-self: start;
        }
    }
</style>
