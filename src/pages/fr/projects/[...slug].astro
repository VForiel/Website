---
import { getCollection, render } from "astro:content";
import ProjectLayout from "../../../layouts/ProjectLayout.astro";
import { sortProjects, designation } from "../../../utils/catalogue";

export async function getStaticPaths() {
    const projects = await getCollection("projects", ({ data }) => {
        return data.locale === "fr";
    });

    const catalogue = sortProjects(projects);

    return catalogue.map((project, index) => {
        // Remove .fr suffix from slug (e.g., "heliosfr" -> "helios")
        const cleanSlug = project.id.replace(/fr$/, "");
        return {
            params: { slug: cleanSlug },
            props: { project, designation: designation(index, catalogue.length) },
        };
    });
}

const { project, designation: catalogueId } = Astro.props;
const { Content } = await render(project);
const {
    title,
    description,
    "start-date": startDate,
    "end-date": endDate,
    tags,
    image,
    url,
} = project.data;
---

<ProjectLayout
    title={title}
    description={description}
    startDate={startDate}
    endDate={endDate}
    tags={tags}
    image={image}
    url={url}
    lang="fr"
    designation={catalogueId}
>
    <Content />
</ProjectLayout>
