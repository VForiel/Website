---
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import ProjectTimeline from "../../components/ProjectTimeline.astro";
import { getCollection } from "astro:content";

// Get all projects sorted by end_date (most recent first, ongoing projects first)
const allProjects = await getCollection("projects", ({ data }) => {
    return data.locale === "fr";
});
const projects = allProjects.sort((a, b) => {
    // Projects without end-date (ongoing) come first
    if (!a.data["end-date"] && !b.data["end-date"]) return 0;
    if (!a.data["end-date"]) return -1;
    if (!b.data["end-date"]) return 1;
    return (
        (b.data["end-date"]?.valueOf() ?? Infinity) -
        (a.data["end-date"]?.valueOf() ?? Infinity)
    );
});

// Group by featured/not featured
const featuredProjects = projects.filter((p) => p.data.featured);
const regularProjects = projects.filter((p) => !p.data.featured);
---

<PageLayout
    title="Portfolio - Vincent Foriel"
    description="Projets de recherche et développements logiciels en instrumentation astronomique"
    currentPath={Astro.url.pathname}
>
    <Section>
        <div class="page-header">
            <h1>Portfolio</h1>
            <p class="lead">
                Découvrez l'ensemble de mes projets, aussi bien de recherche que
                mes projets d'études, associatifs ou personnels, liés ou non à
                l'astro.
            </p>
        </div>
    </Section>

    {
        featuredProjects.length > 0 && (
            <Section>
                <h2 class="section-title">Projets principaux</h2>
                <div class="projects-grid">
                    {featuredProjects.map((project) => {
                        // Remove .fr suffix from slug (e.g., "heliosfr" -> "helios")
                        const cleanSlug = project.slug.replace(/fr$/, "");
                        return (
                            <ProjectCard
                                title={project.data.title}
                                description={project.data.description}
                                startDate={project.data["start-date"]}
                                endDate={project.data["end-date"]}
                                tags={project.data.tags}
                                image={project.data.image}
                                projectSlug={cleanSlug}
                                externalUrl={project.data.url}
                                lang="fr"
                            />
                        );
                    })}
                </div>
            </Section>
        )
    }

    <Section>
        <ProjectTimeline projects={projects} lang="fr" />
    </Section>

    <Section class="cta-section">
        <div class="cta-box">
            <h2>Intéressé par mes travaux ?</h2>
            <p>
                Pour discuter d'une collaboration, d'un projet de recherche ou
                simplement échanger sur ces thématiques, n'hésitez pas à me
                contacter.
            </p>
            <a
                href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}fr/contact`}
                class="button">Entrer en contact</a
            >
        </div>
    </Section>
</PageLayout>

<style>
    .page-header {
        max-width: 65ch;
        margin-inline: auto;
        text-align: center;
        margin-block-end: var(--space-12);
    }

    .page-header h1 {
        font-size: var(--text-4xl);
        margin-block-end: var(--space-4);
    }

    .lead {
        font-size: var(--text-xl);
        color: var(--color-text-secondary);
    }

    .section-title {
        font-size: var(--text-2xl);
        margin-block-end: var(--space-8);
    }

    .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: var(--space-8);
    }

    .cta-section {
        background-color: var(--color-background-secondary);
    }

    .cta-box {
        max-width: 600px;
        margin-inline: auto;
        text-align: center;
    }

    .cta-box h2 {
        font-size: var(--text-3xl);
        margin-block-end: var(--space-4);
    }

    .cta-box p {
        font-size: var(--text-lg);
        color: var(--color-text-secondary);
        margin-block-end: var(--space-8);
    }

    .button {
        display: inline-block;
        padding: var(--space-4) var(--space-8);
        font-size: var(--text-base);
        font-weight: 500;
        background-color: var(--color-primary);
        color: white;
        border-radius: var(--radius-md);
        transition: all var(--transition-base);
    }

    .button:hover {
        background-color: var(--color-primary-dark);
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
    }

    @media (max-width: 768px) {
        .projects-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
