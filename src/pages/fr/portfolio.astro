---
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import ProjectTimeline from "../../components/ProjectTimeline.astro";
import { getCollection } from "astro:content";
import { dateToTimestamp } from "../../utils/dates";

// Get all projects sorted by end_date (most recent first, ongoing projects first)
const allProjects = await getCollection("projects", ({ data }) => {
    return data.locale === "fr";
});
const projects = allProjects.sort((a, b) => {
    // Projects without end-date (ongoing) come first, then most recent
    return dateToTimestamp(b.data["end-date"]) - dateToTimestamp(a.data["end-date"]);
});

// Group by featured/not featured
const featuredProjects = projects.filter((p) => p.data.featured);
const regularProjects = projects.filter((p) => !p.data.featured);
---

<PageLayout
    title="Portfolio - Vincent Foriel"
    description="Projets de recherche et développements logiciels en instrumentation astronomique"
    currentPath={Astro.url.pathname}
>
    <Section>
        <div class="page-header">
            <h1>Portfolio</h1>
            <p class="lead">
                Découvrez l'ensemble de mes projets, aussi bien de recherche que
                mes projets d'études, associatifs ou personnels, liés ou non à
                l'astro.
            </p>
        </div>
    </Section>

    {
        featuredProjects.length > 0 && (
            <Section>
                <h2 class="section-title">Projets principaux</h2>
                <div class="projects-grid">
                    {featuredProjects.map((project) => {
                        // Remove .fr suffix from slug (e.g., "heliosfr" -> "helios")
                        const cleanSlug = project.id.replace(/fr$/, "");
                        return (
                            <ProjectCard
                                title={project.data.title}
                                description={project.data.description}
                                startDate={project.data["start-date"]}
                                endDate={project.data["end-date"]}
                                tags={project.data.tags}
                                image={project.data.image}
                                projectSlug={cleanSlug}
                                externalUrl={project.data.url}
                                lang="fr"
                            />
                        );
                    })}
                </div>
            </Section>
        )
    }

    <Section>
        <ProjectTimeline projects={projects} lang="fr" />
    </Section>

    <Section class="cta-section">
        <div class="cta-box">
            <h2>Intéressé par mes travaux ?</h2>
            <p>
                Pour discuter d'une collaboration, d'un projet de recherche ou
                simplement échanger sur ces thématiques, n'hésitez pas à me
                contacter.
            </p>
            <a
                href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}fr/contact`}
                class="button">Entrer en contact</a
            >
        </div>
    </Section>
</PageLayout>

<style>
    .page-header {
        padding-block: var(--space-4) var(--space-10);
        border-bottom: 1px solid var(--color-border);
    }

    .page-header h1 {
        font-size: clamp(2.5rem, 6vw, 4.25rem);
        margin-block-end: var(--space-4);
    }

    .lead {
        font-size: var(--text-xl);
        color: var(--color-text-secondary);
        max-width: 52ch;
    }

    .section-title {
        font-size: var(--text-3xl);
        margin-block-end: var(--space-10);
        padding-block-end: var(--space-4);
        border-bottom: 1px solid var(--color-border);
    }

    .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: var(--space-10);
    }

    .cta-section {
        background: none;
    }

    .cta-box {
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: var(--space-12);
        align-items: start;
        padding-block-start: var(--space-10);
        border-top: 1px solid var(--color-border);
    }

    .cta-box h2 {
        font-size: var(--text-4xl);
        font-style: italic;
        grid-row: span 2;
    }

    .cta-box p {
        font-size: var(--text-lg);
        color: var(--color-text-secondary);
        margin-block-end: var(--space-6);
    }

    @media (max-width: 768px) {
        .projects-grid {
            grid-template-columns: 1fr;
        }
    }

    .cta-box > :not(h2) {
        grid-column: 2;
        justify-self: start;
    }

    @media (max-width: 768px) {
        .cta-box {
            grid-template-columns: 1fr;
        }

        .cta-box h2 {
            font-size: var(--text-3xl);
            margin-block-end: var(--space-4);
        }

        .cta-box > :not(h2) {
            grid-column: 1;
        }
    }
</style>
