---
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";
---

<PageLayout
    title="Contact - Vincent Foriel"
    description="Entrez en contact avec Vincent Foriel pour des collaborations, du conseil ou de la vulgarisation scientifique"
    currentPath={Astro.url.pathname}
>
    <Section>
        <div class="contact-header">
            <h1>Contact</h1>
            <p class="lead">
                Pour discuter d'un projet de collaboration, d'une intervention
                ou simplement échanger
            </p>
        </div>
    </Section>

    <Section>
        <div class="contact-grid">
            <!-- Contact information -->
            <div class="contact-main">
                <h2>Entrons en contact</h2>

                <div class="contact-methods">
                    <div class="contact-method">
                        <div class="contact-method__icon">✉️</div>
                        <div>
                            <h3 class="contact-method__title">Email</h3>
                            <a
                                href="mailto:vincent.foriel@gmail.com"
                                class="contact-method__link"
                            >
                                vincent.foriel@gmail.com
                            </a>
                        </div>
                    </div>

                    <div class="contact-method">
                        <div class="contact-method__icon">📍</div>
                        <div>
                            <h3 class="contact-method__title">Localisation</h3>
                            <p class="contact-method__text">Nice, France</p>
                        </div>
                    </div>
                </div>

                <div class="social-links">
                    <h3>Profils professionnels</h3>
                    <div class="social-links__list">
                        <a
                            href="https://github.com/VForiel"
                            class="social-link"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <span class="social-link__icon">🔗</span>
                            <span class="social-link__name">GitHub</span>
                        </a>

                        <a
                            href="https://www.linkedin.com/in/vincentforiel/"
                            class="social-link"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <span class="social-link__icon">🔗</span>
                            <span class="social-link__name">LinkedIn</span>
                        </a>

                        <a
                            href="https://orcid.org/0009-0009-3977-5499"
                            class="social-link"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <span class="social-link__icon">🔗</span>
                            <span class="social-link__name">ORCID</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Sidebar with availability -->
            <aside class="contact-sidebar">
                <div
                    class="info-card info-card--highlight"
                >
                    <h3>
                        🚀 Recherche de Poste
                    </h3>
                    <p>
                        Je suis prioritairement à la recherche d'un <strong
                            >post-doctorat</strong
                        > ou d'un <strong>poste d'ingénieur de recherche</strong
                        > à temps plein en instrumentation optique et simulation.
                        N'hésitez pas à me contacter si votre équipe recrute !
                    </p>
                </div>

                <div class="info-card">
                    <h3>🤝 Missions Freelance & Conseil</h3>
                    <p>
                        En parallèle de mon activité principale, je reste
                        disponible pour des missions ponctuelles (conférences,
                        conseil, soutien scolaire) à hauteur de <strong
                            >2h par semaine maximum</strong
                        >.
                    </p>
                </div>

                <div class="info-card">
                    <h3>Délai de réponse</h3>
                    <p>
                        Je réponds généralement dans les 48 heures aux demandes
                        par email.
                    </p>
                </div>
            </aside>
        </div>
    </Section>
</PageLayout>

<style>
    .info-card.info-card--highlight {
        border-top-color: var(--color-primary);
    }

    .info-card.info-card--highlight h3 {
        color: var(--color-primary);
    }

    .contact-header {
        padding-block: var(--space-4) var(--space-10);
        border-bottom: 1px solid var(--color-border);
    }

    .contact-header h1 {
        font-size: clamp(2.5rem, 6vw, 4.25rem);
        margin-block-end: var(--space-4);
    }

    .lead {
        font-size: var(--text-xl);
        color: var(--color-text-secondary);
        max-width: 52ch;
    }

    .contact-grid {
        display: grid;
        grid-template-columns: 1fr 350px;
        gap: var(--space-12);
        align-items: start;
    }

    .contact-main {
        padding: 0;
    }

    .contact-main h2 {
        font-size: var(--text-3xl);
        margin-block-end: var(--space-4);
    }

    .contact-main > p {
        color: var(--color-text-secondary);
        margin-block-end: var(--space-10);
        line-height: 1.7;
    }

    .contact-methods {
        display: flex;
        flex-direction: column;
        gap: var(--space-8);
        margin-block-end: var(--space-12);
    }

    .contact-method {
        display: flex;
        align-items: flex-start;
        gap: var(--space-4);
        padding-block-start: var(--space-4);
        border-top: 1px solid var(--color-border-subtle);
    }

    .contact-method__icon {
        font-size: 1.5rem;
        flex-shrink: 0;
        filter: grayscale(0.6);
    }

    .contact-method__title {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 400;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-text-muted);
        margin-block-end: var(--space-1);
    }

    .contact-method__link {
        font-size: var(--text-lg);
        color: var(--color-text);
        text-decoration: underline;
        text-decoration-color: var(--color-border);
        text-underline-offset: 0.25em;
        transition: text-decoration-color var(--transition-fast);
    }

    .contact-method__link:hover {
        color: var(--color-text);
        text-decoration-color: var(--color-primary);
    }

    .contact-method__text {
        font-size: var(--text-base);
        color: var(--color-text-secondary);
    }

    .social-links h3 {
        font-size: var(--text-lg);
        margin-block-end: var(--space-4);
    }

    .social-links__list {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
    }

    .social-link {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        padding-block: var(--space-3);
        border-bottom: 1px solid var(--color-border-subtle);
        transition: color var(--transition-fast);
    }

    .social-link:hover {
        color: var(--color-primary);
    }

    .social-link__icon {
        font-size: 1.5rem;
    }

    .social-link__name {
        font-size: var(--text-base);
        font-weight: 500;
        color: inherit;
    }

    .contact-sidebar {
        position: sticky;
        top: calc(var(--space-16) + 60px);
    }

    .info-card {
        padding-block: var(--space-5) var(--space-8);
        border-top: 1px solid var(--color-border);
    }

    .info-card h3 {
        font-size: var(--text-xl);
        margin-block-end: var(--space-3);
    }

    .info-card p {
        font-size: var(--text-sm);
        color: var(--color-text-secondary);
        line-height: 1.6;
    }

    .collaboration-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
    }

    .collaboration-list li {
        font-size: var(--text-sm);
        color: var(--color-text-secondary);
        padding-inline-start: var(--space-5);
        position: relative;
    }

    .collaboration-list li::before {
        content: "—";
        position: absolute;
        left: 0;
        color: var(--color-text-muted);
    }

    @media (max-width: 1024px) {
        .contact-grid {
            grid-template-columns: 1fr;
        }

        .contact-sidebar {
            position: static;
        }
    }
</style>
