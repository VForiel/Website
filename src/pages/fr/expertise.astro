---
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";
import { getCollection, render } from "astro:content";

// Get all services sorted by order
const allServices = await getCollection("services", ({ data }) => {
    return data.locale === "fr";
});
const services = allServices.sort((a, b) => a.data.order - b.data.order);

// Render all services
const renderedServices = await Promise.all(
    services.map(async (service) => {
        const slug = service.id
            .replace(/\.md$/, "")
            .replace(/\.?(fr|en)$/, "");
        return {
            id: service.id,
            slug,
            data: service.data,
            Content: (await render(service)).Content,
        };
    }),
);
const webChannel = String(
    renderedServices.findIndex(({ slug }) => slug === "web-development") + 1,
).padStart(2, "0");
---

<PageLayout
    title="Expertise & Services - Vincent Foriel"
    description="Services de création de sites web clés en main, communication scientifique, science des données, calcul haute performance, IA pour la physique et cours de math/physique/informatique"
    currentPath={Astro.url.pathname}
>
    <Section>
        <div class="page-header">
            <h1>Expertise & Services</h1>
            <p class="lead">
                De la création de sites web clés en main au conseil technique et à la communication scientifique, je propose
                mes services pour des collaborations sur mesure.
            </p>
        </div>

        <!-- Cartes sommaires / navigation rapide -->
        <nav class="summary-nav" aria-label="Sommaire des domaines d'expertise">
            <div class="summary-nav__header">
                <span class="summary-nav__eyebrow">Index des domaines</span>
                <span class="summary-nav__count">{renderedServices.length} domaines</span>
            </div>
            <div class="summary-grid">
                {
                    renderedServices.map(({ data, slug }, index) => {
                        const { title, description, icon, available } = data;
                        const channelNum = String(index + 1).padStart(2, "0");

                        return (
                            <a
                                href={`#service-${slug}`}
                                class={`summary-card ${!available ? "summary-card--unavailable" : ""}`}
                                aria-label={`Faire défiler jusqu'à ${title}`}
                            >
                                <div class="summary-card__top">
                                    {icon && <span class="summary-card__icon">{icon}</span>}
                                    <div class="summary-card__meta">
                                        <span class="summary-card__channel">Canal {channelNum}</span>
                                        <span
                                            class={`summary-card__status ${available ? "summary-card__status--available" : "summary-card__status--unavailable"}`}
                                        >
                                            {available ? "Disponible" : "Indisponible"}
                                        </span>
                                    </div>
                                </div>
                                <h3 class="summary-card__title">{title}</h3>
                                <p class="summary-card__desc">{description}</p>
                                <div class="summary-card__footer">
                                    <span class="summary-card__action">Accéder au détail</span>
                                    <span class="summary-card__arrow" aria-hidden="true">↓</span>
                                </div>
                            </a>
                        );
                    })
                }
            </div>
        </nav>
    </Section>

    {
        renderedServices.map(({ data, Content, slug }, index) => {
            const { title, description, icon, available, reason } = data;

            return (
                <Section class="service-section">
                    <div
                        id={`service-${slug}`}
                        class={`service ${!available ? "service--unavailable" : ""}`}
                    >
                        <div class="service__header">
                            {icon && <div class="service__icon">{icon}</div>}
                            <div>
                                <p class="service__channel">
                                    Canal {String(index + 1).padStart(2, "0")}
                                    {!available && <span> · hors bande</span>}
                                </p>
                                <div class="service__title-row">
                                    <h2 class="service__title">{title}</h2>
                                    {!available && (
                                        <span
                                            class="service__badge"
                                            title={reason}
                                        >
                                            Indisponible
                                        </span>
                                    )}
                                </div>
                                <p class="service__description">
                                    {description}
                                </p>
                            </div>
                        </div>

                        <div class="service__content prose">
                            <Content />
                            {slug === "web-development" && (
                                <div class="service__action-bar">
                                    <button
                                        type="button"
                                        class="button button--secondary"
                                        data-open-modal="modal-web-development"
                                    >
                                        <span>En savoir plus sur l'offre clé en main</span>
                                        <span aria-hidden="true">→</span>
                                    </button>
                                </div>
                            )}
                        </div>
                    </div>
                </Section>
            );
        })
    }

    <Section class="cta-section">
        <div class="cta-box">
            <h2>Besoin d'un expert ?</h2>
            <p>
                Que ce soit pour un site web, un projet de recherche, une analyse
                technique ou une intervention de vulgarisation, discutons de votre besoin.
            </p>
            <a
                href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}fr/contact/`}
                class="button">Me contacter</a
            >
        </div>
    </Section>

    <!-- Popup Modale Détails : Création de sites web -->
    <dialog id="modal-web-development" class="expertise-modal" aria-labelledby="modal-web-dev-title">
        <div class="expertise-modal__panel">
            <div class="expertise-modal__header">
                <div class="expertise-modal__header-left">
                    <span class="expertise-modal__channel">Canal {webChannel}</span>
                    <span class="expertise-modal__badge">Disponible</span>
                </div>
                <button
                    type="button"
                    class="expertise-modal__close"
                    data-close-modal="modal-web-development"
                    aria-label="Fermer la fenêtre"
                >
                    &times;
                </button>
            </div>

            <div class="expertise-modal__content">
                <div class="expertise-modal__title-group">
                    <span class="expertise-modal__icon">🌐</span>
                    <div>
                        <h2 id="modal-web-dev-title" class="expertise-modal__title">Création de sites web clés en main</h2>
                        <p class="expertise-modal__subtitle">Solutions adaptées aux indépendants, cabinets libéraux, associations et chercheurs</p>
                    </div>
                </div>

                <div class="expertise-modal__prose">
                    <div class="modal-block">
                        <h3 class="modal-block__title">Exemples de réalisations concrètes</h3>
                        <ul class="modal-examples-list">
                            <li>
                                <strong>Sites vitrines et portfolios professionnels</strong>
                                <p class="modal-example-desc">Valorisation d'une activité ou d'un cabinet avec un design soigné, responsive et optimisé pour le référencement naturel (SEO).</p>
                                <ul class="modal-links-list">
                                    <li>
                                        <a href="https://vincent.foriel.pro" target="_blank" rel="noopener noreferrer">vincent.foriel.pro</a> — Portfolio personnel et académique bilingue, sobre, responsive et rapide.
                                    </li>
                                    <li>
                                        <a href="https://philippine.villard.pro" target="_blank" rel="noopener noreferrer">philippine.villard.pro</a> — Site vitrine de cabinet libéral pour Philippine Villard (psychologue clinicienne), présentant ses spécialités et simplifiant la prise de contact et de rendez-vous.
                                    </li>
                                </ul>
                            </li>
                            <li>
                                <strong>Plateformes associatives et communautaires</strong>
                                <p class="modal-example-desc">Centralisation des ressources et animation de réseaux avec espace membres et gestion des événements.</p>
                                <ul class="modal-links-list">
                                    <li>
                                        <a href="https://ajc06.com" target="_blank" rel="noopener noreferrer">ajc06.com</a> — Plateforme complète pour l'association AJC06 combinant gestion interne et fonctionnalités de réseau social.
                                    </li>
                                    <li>
                                        <a href="https://nice-event.fr" target="_blank" rel="noopener noreferrer">nice-event.fr</a> — Agenda participatif de Nice, des Alpes-Maritimes et de Monaco : carte interactive, espace membres, collecte automatique des événements de dizaines de sources et diffusion sur les réseaux sociaux.
                                    </li>
                                </ul>
                            </li>
                            <li>
                                <strong>Interfaces utilisateur et outils de simulation interactifs</strong>
                                <p class="modal-example-desc">Visualisation de données et manipulation de calculs scientifiques en direct dans le navigateur.</p>
                                <ul class="modal-links-list">
                                    <li>
                                        <a href="https://lumos.vincent.foriel.pro" target="_blank" rel="noopener noreferrer">lumos.vincent.foriel.pro</a> — Interface utilisateur web pour un simulateur optique interactif.
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </div>

                    <div class="modal-block">
                        <h3 class="modal-block__title">Formule clé en main tout compris</h3>
                        <div class="modal-features-grid">
                            <div class="modal-feature-card">
                                <div class="modal-feature-card__header">
                                    <span class="modal-feature-card__icon">🖥️</span>
                                    <h4>Hébergement & Domaine inclus</h4>
                                </div>
                                <p>Un an de location de serveur haute performance et réservation de votre nom de domaine offerts, certificat SSL (HTTPS) et DNS inclus.</p>
                            </div>
                            <div class="modal-feature-card">
                                <div class="modal-feature-card__header">
                                    <span class="modal-feature-card__icon">⏱️</span>
                                    <h4>Dépannage sous 48h garanti</h4>
                                </div>
                                <p>Assistance technique et résolution sous 48 heures ouvrées en cas d'anomalie critique ou d'interruption de service.</p>
                            </div>
                            <div class="modal-feature-card">
                                <div class="modal-feature-card__header">
                                    <span class="modal-feature-card__icon">📱</span>
                                    <h4>Conception sur-mesure & responsive</h4>
                                </div>
                                <p>Code propre, léger et accessible, parfait sur smartphones, tablettes et ordinateurs, sans dépendance lourde.</p>
                            </div>
                            <div class="modal-feature-card">
                                <div class="modal-feature-card__header">
                                    <span class="modal-feature-card__icon">🤝</span>
                                    <h4>Autonomie ou accompagnement</h4>
                                </div>
                                <p>Passation claire pour vous permettre d'éditer facilement vos textes et images, ou formule de suivi selon vos souhaits.</p>
                            </div>
                        </div>
                    </div>

                    <div class="modal-block modal-block--pricing">
                        <h3 class="modal-block__title">Tarifs et délais</h3>
                        <p>
                            Les tarifs sont calculés <strong>sur mesure</strong> en fonction des besoins précis, du volume fonctionnel et des délais de livraison souhaités.
                        </p>
                    </div>
                </div>
            </div>

            <div class="expertise-modal__footer">
                <button
                    type="button"
                    class="button button--secondary"
                    data-close-modal="modal-web-development"
                >
                    Fermer
                </button>
                <a
                    href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}fr/contact/`}
                    class="button"
                >
                    Demander un devis / Me contacter
                </a>
            </div>
        </div>
    </dialog>
</PageLayout>

<script>
    function initExpertiseModals() {
        document.querySelectorAll<HTMLElement>("[data-open-modal]").forEach((trigger) => {
            trigger.addEventListener("click", () => {
                const modalId = trigger.getAttribute("data-open-modal");
                const modal = modalId ? document.getElementById(modalId) : null;
                if (modal && modal instanceof HTMLDialogElement) {
                    modal.showModal();
                }
            });
        });

        document.querySelectorAll<HTMLElement>("[data-close-modal]").forEach((closeBtn) => {
            closeBtn.addEventListener("click", () => {
                const modalId = closeBtn.getAttribute("data-close-modal");
                const modal = modalId ? document.getElementById(modalId) : null;
                if (modal && modal instanceof HTMLDialogElement) {
                    modal.close();
                }
            });
        });

        document.querySelectorAll<HTMLDialogElement>(".expertise-modal").forEach((dialog) => {
            dialog.addEventListener("click", (event) => {
                if (event.target === dialog) dialog.close();
            });
        });
    }

    initExpertiseModals();
</script>

<style>
    .page-header {
        padding-block: var(--space-4) var(--space-10);
        border-bottom: 1px solid var(--color-border);
    }

    .page-header h1 {
        font-size: clamp(2.5rem, 6vw, 4.25rem);
        margin-block-end: var(--space-4);
    }

    .lead {
        font-size: var(--text-xl);
        color: var(--color-text-secondary);
        max-width: 52ch;
    }

    .service-section:nth-of-type(even) {
        background: none;
    }

    .service {
        max-width: 900px;
        padding-block-start: var(--space-8);
        border-top: 1px solid var(--color-border);
        scroll-margin-top: calc(5rem + var(--space-6));
        transition: background-color var(--transition-slow);
    }

    .service:target {
        animation: service-highlight 2s ease-out;
    }

    @keyframes service-highlight {
        0% {
            background-color: hsla(42, 62%, 70%, 0.12);
        }
        100% {
            background-color: transparent;
        }
    }

    /* Sommaire rapide des expertises */
    .summary-nav {
        margin-block-start: var(--space-8);
        padding-block-end: var(--space-4);
    }

    .summary-nav__header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        margin-block-end: var(--space-6);
        gap: var(--space-4);
        flex-wrap: wrap;
    }

    .summary-nav__eyebrow {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-primary);
    }

    .summary-nav__count {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-text-muted);
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--space-4);
    }

    .summary-card {
        display: flex;
        flex-direction: column;
        padding: var(--space-5);
        background: var(--color-background-secondary);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        text-decoration: none;
        color: inherit;
        position: relative;
        overflow: hidden;
        transition:
            transform var(--transition-fast),
            border-color var(--transition-base),
            background-color var(--transition-base),
            box-shadow var(--transition-base);
    }

    .summary-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: transparent;
        transition: background-color var(--transition-base);
    }

    .summary-card:hover {
        transform: translateY(-2px);
        border-color: var(--color-primary);
        background: var(--color-surface);
        box-shadow: 0 8px 24px -8px hsla(226, 30%, 4%, 0.8);
    }

    .summary-card:hover::before {
        background: var(--color-primary);
    }

    .summary-card:focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: 2px;
    }

    .summary-card__top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
        margin-block-end: var(--space-3);
    }

    .summary-card__icon {
        font-size: 1.5rem;
        line-height: 1;
        transition: transform var(--transition-fast);
    }

    .summary-card:hover .summary-card__icon {
        transform: scale(1.1);
    }

    .summary-card__meta {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        margin-left: auto;
    }

    .summary-card__channel {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-primary);
    }

    .summary-card__status {
        display: inline-flex;
        align-items: center;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        padding: 0.1rem var(--space-2);
        border-radius: var(--radius-sm);
        white-space: nowrap;
    }

    .summary-card__status--available {
        color: hsl(140, 60%, 75%);
        background: hsla(140, 60%, 45%, 0.12);
        border: 1px solid hsla(140, 60%, 60%, 0.3);
    }

    :global(.light-theme) .summary-card__status--available {
        color: hsl(140, 70%, 25%);
        background: hsla(140, 60%, 45%, 0.15);
        border-color: hsla(140, 60%, 35%, 0.3);
    }

    .summary-card__status--unavailable {
        color: hsl(4, 65%, 68%);
        background: hsla(4, 65%, 50%, 0.1);
        border: 1px solid hsla(4, 65%, 60%, 0.25);
    }

    :global(.light-theme) .summary-card__status--unavailable {
        color: hsl(4, 75%, 40%);
        background: hsla(4, 65%, 50%, 0.12);
        border-color: hsla(4, 65%, 40%, 0.3);
    }

    .summary-card__title {
        font-size: var(--text-lg);
        font-weight: 500;
        line-height: 1.25;
        color: var(--color-text);
        margin-block-end: var(--space-2);
        transition: color var(--transition-fast);
    }

    .summary-card:hover .summary-card__title {
        color: var(--color-primary);
    }

    .summary-card__desc {
        font-size: var(--text-sm);
        line-height: 1.45;
        color: var(--color-text-secondary);
        margin-block-end: var(--space-4);
        flex-grow: 1;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .summary-card__footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-block-start: var(--space-3);
        border-top: 1px dashed var(--color-border-subtle);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-text-muted);
        transition: color var(--transition-fast);
    }

    .summary-card:hover .summary-card__footer {
        color: var(--color-primary);
    }

    .summary-card__arrow {
        font-size: var(--text-sm);
        transition: transform var(--transition-fast);
    }

    .summary-card:hover .summary-card__arrow {
        transform: translateY(3px);
    }

    .summary-card--unavailable {
        opacity: 0.85;
    }

    .summary-card--unavailable .summary-card__channel {
        color: var(--color-text-muted);
    }

    @media (max-width: 960px) {
        .summary-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 600px) {
        .summary-grid {
            grid-template-columns: 1fr;
        }
    }

    .service__header {
        display: flex;
        align-items: flex-start;
        gap: var(--space-6);
        margin-block-end: var(--space-6);
    }

    .service__header > div {
        min-width: 0;
    }

    .service__icon {
        font-size: 2rem;
        line-height: 1;
        flex-shrink: 0;
        width: 3rem;
        filter: grayscale(0.6);
        opacity: 0.85;
    }

    .service__title-row {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        flex-wrap: wrap;
    }

    .service__title {
        font-size: var(--text-3xl);
        margin-block-end: var(--space-2);
    }

    .service__availability-status {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
    }

    .service__badge {
        display: inline-block;
        padding: 0.125rem var(--space-2);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: hsl(4, 65%, 62%);
        border: 1px solid currentColor;
        border-radius: var(--radius-sm);
        cursor: help;
        position: relative;
    }

    .service__badge[title]:hover::after {
        content: attr(title);
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%);
        margin-top: var(--space-2);
        padding: var(--space-2) var(--space-3);
        background-color: var(--color-neutral-800);
        color: var(--color-neutral-50);
        font-size: var(--text-sm);
        font-weight: 400;
        text-transform: none;
        letter-spacing: normal;
        white-space: nowrap;
        border-radius: var(--radius-sm);
        z-index: 10;
        box-shadow: var(--shadow-md);
    }

    .service__description {
        font-size: var(--text-lg);
        color: var(--color-text-secondary);
    }

    .service__reason {
        font-size: var(--text-sm);
        font-style: italic;
        color: var(--color-text-muted);
        margin-block-start: var(--space-2);
    }

    .service--unavailable {
        position: relative;
    }

    /* Service indisponible : bande hachurée dans la marge, contenu atténué */
    .service--unavailable::before {
        content: "";
        position: absolute;
        top: var(--space-8);
        bottom: 0;
        left: calc(-1 * var(--space-6));
        width: 7px;
        background: repeating-linear-gradient(
            135deg,
            var(--color-text-muted) 0 1px,
            transparent 1px 5px
        );
        opacity: 0.7;
    }

    .service--unavailable .service__icon,
    .service--unavailable .service__content {
        opacity: 0.55;
    }

    .service--unavailable .service__title {
        color: var(--color-text-secondary);
    }

    .service__channel {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-primary);
        margin-block-end: var(--space-2);
    }

    .service--unavailable .service__channel {
        color: var(--color-text-muted);
    }

    .service__content {
        padding-inline-start: calc(3rem + var(--space-6));
    }

    /* Prose styling for markdown content */
    .prose :global(h2) {
        font-size: var(--text-2xl);
        margin-block: var(--space-6) var(--space-4);
    }

    .prose :global(h3) {
        font-size: var(--text-xl);
        margin-block: var(--space-5) var(--space-3);
    }

    .prose :global(p) {
        color: var(--color-text-secondary);
        margin-block-end: var(--space-4);
    }

    .prose :global(ul) {
        list-style: disc;
        padding-inline-start: var(--space-6);
        margin-block: var(--space-4);
    }

    .prose :global(li) {
        color: var(--color-text-secondary);
        margin-block-end: var(--space-2);
    }

    .prose :global(a) {
        color: var(--color-text);
        text-decoration: underline;
        text-decoration-color: var(--color-primary);
        text-underline-offset: 0.2em;
    }

    .prose :global(a:hover) {
        color: var(--color-primary);
    }

    .cta-section {
        background: none;
    }

    .cta-box {
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: var(--space-12);
        align-items: start;
        padding-block-start: var(--space-10);
        border-top: 1px solid var(--color-border);
    }

    .cta-box h2 {
        font-size: var(--text-4xl);
        font-style: italic;
        grid-row: span 2;
