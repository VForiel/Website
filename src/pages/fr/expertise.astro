---
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";
import { getCollection, render } from "astro:content";

// Get all services sorted by order
const allServices = await getCollection("services", ({ data }) => {
    return data.locale === "fr";
});
const services = allServices.sort((a, b) => a.data.order - b.data.order);

// Render all services
const renderedServices = await Promise.all(
    services.map(async (service) => ({
        data: service.data,
        Content: (await render(service)).Content,
    })),
);
---

<PageLayout
    title="Expertise & Services - Vincent Foriel"
    description="Services de communication scientifique, science des données, calcul haute performance, IA pour la physique et cours de math/physique/informatique"
    currentPath={Astro.url.pathname}
>
    <Section>
        <div class="page-header">
            <h1>Expertise & Services</h1>
            <p class="lead">
                Du conseil technique à la communication scientifique, je propose
                mes services pour de courtes collaborations en parallèle de mon activité principale.
            </p>
        </div>
    </Section>

    {
        renderedServices.map(({ data, Content }) => {
            const { title, description, icon, available, reason } = data;

            return (
                <Section class="service-section">
                    <div
                        class={`service ${!available ? "service--unavailable" : ""}`}
                    >
                        <div class="service__header">
                            {icon && <div class="service__icon">{icon}</div>}
                            <div>
                                <div class="service__title-row">
                                    <h2 class="service__title">{title}</h2>
                                    {!available && (
                                        <span
                                            class="service__badge"
                                            title={reason}
                                        >
                                            Indisponible
                                        </span>
                                    )}
                                </div>
                                <p class="service__description">
                                    {description}
                                </p>
                            </div>
                        </div>

                        <div class="service__content prose">
                            <Content />
                        </div>
                    </div>
                </Section>
            );
        })
    }

    <Section class="cta-section">
        <div class="cta-box">
            <h2>Besoin d'un expert ?</h2>
            <p>
                Que ce soit pour un projet de recherche, une analyse technique
                ou une intervention de vulgarisation, discutons de votre besoin.
            </p>
            <a
                href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}fr/contact`}
                class="button">Me contacter</a
            >
        </div>
    </Section>
</PageLayout>

<style>
    .page-header {
        padding-block: var(--space-4) var(--space-10);
        border-bottom: 1px solid var(--color-border);
    }

    .page-header h1 {
        font-size: clamp(2.5rem, 6vw, 4.25rem);
        margin-block-end: var(--space-4);
    }

    .lead {
        font-size: var(--text-xl);
        color: var(--color-text-secondary);
        max-width: 52ch;
    }

    .service-section:nth-of-type(even) {
        background: none;
    }

    .service {
        max-width: 900px;
        padding-block-start: var(--space-8);
        border-top: 1px solid var(--color-border);
    }

    .service__header {
        display: flex;
        align-items: flex-start;
        gap: var(--space-6);
        margin-block-end: var(--space-6);
    }

    .service__icon {
        font-size: 2rem;
        line-height: 1;
        flex-shrink: 0;
        width: 3rem;
        filter: grayscale(0.6);
        opacity: 0.85;
    }

    .service__title-row {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        flex-wrap: wrap;
    }

    .service__title {
        font-size: var(--text-3xl);
        margin-block-end: var(--space-2);
    }

    .service__availability-status {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
    }

    .service__badge {
        display: inline-block;
        padding: 0.125rem var(--space-2);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: hsl(4, 65%, 62%);
        border: 1px solid currentColor;
        border-radius: var(--radius-sm);
        cursor: help;
        position: relative;
    }

    .service__badge[title]:hover::after {
        content: attr(title);
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%);
        margin-top: var(--space-2);
        padding: var(--space-2) var(--space-3);
        background-color: var(--color-neutral-800);
        color: var(--color-neutral-50);
        font-size: var(--text-sm);
        font-weight: 400;
        text-transform: none;
        letter-spacing: normal;
        white-space: nowrap;
        border-radius: var(--radius-sm);
        z-index: 10;
        box-shadow: var(--shadow-md);
    }

    .service__description {
        font-size: var(--text-lg);
        color: var(--color-text-secondary);
    }

    .service__reason {
        font-size: var(--text-sm);
        font-style: italic;
        color: var(--color-text-muted);
        margin-block-start: var(--space-2);
    }

    .service--unavailable {
        opacity: 0.5;
        filter: grayscale(0.3);
    }

    .service__content {
        padding-inline-start: calc(3rem + var(--space-6));
    }

    /* Prose styling for markdown content */
    .prose :global(h2) {
        font-size: var(--text-2xl);
        margin-block: var(--space-6) var(--space-4);
    }

    .prose :global(h3) {
        font-size: var(--text-xl);
        margin-block: var(--space-5) var(--space-3);
    }

    .prose :global(p) {
        color: var(--color-text-secondary);
        margin-block-end: var(--space-4);
    }

    .prose :global(ul) {
        list-style: disc;
        padding-inline-start: var(--space-6);
        margin-block: var(--space-4);
    }

    .prose :global(li) {
        color: var(--color-text-secondary);
        margin-block-end: var(--space-2);
    }

    .prose :global(a) {
        color: var(--color-text);
        text-decoration: underline;
        text-decoration-color: var(--color-primary);
        text-underline-offset: 0.2em;
    }

    .prose :global(a:hover) {
        color: var(--color-primary);
    }

    .cta-section {
        background: none;
    }

    .cta-box {
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: var(--space-12);
        align-items: start;
        padding-block-start: var(--space-10);
        border-top: 1px solid var(--color-border);
    }

    .cta-box h2 {
        font-size: var(--text-4xl);
        font-style: italic;
        grid-row: span 2;
    }

    .cta-box p {
        font-size: var(--text-lg);
        color: var(--color-text-secondary);
        margin-block-end: var(--space-6);
    }

    @media (max-width: 768px) {
        .service__header {
            gap: var(--space-4);
        }

        .service__content {
            padding-inline-start: 0;
        }
    }

    .cta-box > :not(h2) {
        grid-column: 2;
        justify-self: start;
    }

    @media (max-width: 768px) {
        .cta-box {
            grid-template-columns: 1fr;
        }

        .cta-box h2 {
            font-size: var(--text-3xl);
            margin-block-end: var(--space-4);
        }

        .cta-box > :not(h2) {
            grid-column: 1;
        }
    }
</style>
