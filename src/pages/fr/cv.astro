---
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";

const birthDate = new Date("1997-09-28");
const today = new Date();
let age = today.getFullYear() - birthDate.getFullYear();
const m = today.getMonth() - birthDate.getMonth();
if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) {
    age--;
}
---

<PageLayout
    title="CV - Vincent Foriel"
    description="Curriculum Vitae de Vincent Foriel, expert en instrumentation astrophotonique"
    currentPath={Astro.url.pathname}
>
    <Section class="cv-section">
        <div class="cv-header">
            <h1>Curriculum Vitae</h1>
            <div
                class="cv-objective"
                style="color: white; max-width: 600px; margin: 1rem auto; font-size: 1.1rem; opacity: 0.9;"
            >
                <strong>Recherche :</strong> Post-doctorat ou ingénierie de recherche
                en instrumentation optique et/ou simulation numérique (France / International)
            </div>
            <div class="cv-contact">
                <span>{age} ans</span>
                <span>•</span>
                <span>vincent.foriel@gmail.com</span>
                <span>•</span>
                <span>Nice, France</span>
            </div>
        </div>

        <div class="cv-content">
            <!-- Formation -->
            <div class="cv-block">
                <h2 class="cv-block__title">Formation</h2>

                <div class="cv-item">
                    <div class="cv-item__header">
                        <h3 class="cv-item__title">
                            Doctorant en astrophotonique
                        </h3>
                        <span class="cv-item__date">Nov. 2023 - Présent</span>
                    </div>
                    <div class="cv-item__subtitle">
                        Observatoire de la Côte d'Azur (OCA), Nice
                    </div>
                    <p class="cv-item__description">
                        Améliorer la technique d'interférométrie annulante via
                        la mise au point d'un composant photonique ajustable en
                        phase pour la détection d'exoplanète.
                    </p>
                </div>

                <div class="cv-item">
                    <div class="cv-item__header">
                        <h3 class="cv-item__title">
                            Master en physique computationnelle
                        </h3>
                        <span class="cv-item__date"
                            >Sept. 2021 - Juil. 2023</span
                        >
                    </div>
                    <div class="cv-item__subtitle">
                        Université de Bourgogne Franche-Comté (UBFC), Besançon
                    </div>
                </div>

                <div class="cv-item">
                    <div class="cv-item__header">
                        <h3 class="cv-item__title">
                            Licence de physique fondamentale
                        </h3>
                        <span class="cv-item__date"
                            >Sept. 2017 - Juil. 2021</span
                        >
                    </div>
                    <div class="cv-item__subtitle">
                        Université Côte d'Azur (UniCA), Nice
                    </div>
                </div>

                <div class="cv-item">
                    <div class="cv-item__header">
                        <h3 class="cv-item__title">
                            DUT Réseaux et Télécommunications
                        </h3>
                        <span class="cv-item__date"
                            >Sept. 2015 - Juil. 2017</span
                        >
                    </div>
                    <div class="cv-item__subtitle">
                        Université Côte d'Azur (UniCA), Nice
                    </div>
                </div>
            </div>

            <!-- Expérience -->
            <div class="cv-block">
                <h2 class="cv-block__title">Expérience professionnelle</h2>

                <div class="cv-item">
                    <div class="cv-item__header">
                        <h3 class="cv-item__title">
                            Stage en entreprise : Dévoilement de la structure 3D
                            des noyaux pré stellaires (ML)
                        </h3>
                        <span class="cv-item__date">Fév. 2023 - Mars 2022</span>
                    </div>
                    <div class="cv-item__subtitle">
                        Université de Bourgogne Franche-Comté (UBFC), Besançon
                    </div>
                    <p class="cv-item__description">
                        Etude de la capacité d'un réseau convolutif à inférer
                        les propriétés d'un cœur pré stellaire à partir
                        d'observations générées numériquement.
                    </p>
                </div>

                <div class="cv-item">
                    <div class="cv-item__header">
                        <h3 class="cv-item__title">
                            Projet en laboratoire : Détermination d'efficacité
                            de détection des TNO (ML)
                        </h3>
                        <span class="cv-item__date">Nov. 2021 - Juin 2022</span>
                    </div>
                    <div class="cv-item__subtitle">
                        Université de Bourgogne Franche-Comté (UBFC), Besançon
                    </div>
                    <p class="cv-item__description">
                        Etude du fonctionnement des réseaux neuronaux et de leur
                        capacité à extrapoler des paramètres de modèle
                        d'efficacité de détection.
                    </p>
                </div>

                <div class="cv-item">
                    <div class="cv-item__header">
                        <h3 class="cv-item__title">
                            Projet tuteuré : Coronographie stellaire
                        </h3>
                        <span class="cv-item__date">Mars 2020 - Juin 2020</span>
                    </div>
                    <div class="cv-item__subtitle">
                        Université Côte d'Azur (UCA), Nice
                    </div>
                    <p class="cv-item__description">
                        Simulation du comportement de la lumière dans un
                        télescope.
                    </p>
                </div>
            </div>

            <!-- Compétences -->
            <div class="cv-block">
                <h2 class="cv-block__title">Compétences</h2>

                <div class="cv-skills">
                    <div class="cv-skill-group">
                        <h3>Programmation</h3>
                        <p>
                            Python (expert), C/C++, Fortran, Git/GitHub, CI/CD
                        </p>
                    </div>

                    <div class="cv-skill-group">
                        <h3>Outils scientifiques</h3>
                        <p>
                            NumPy, SciPy, Matplotlib, Astropy, Pandas, Jupyter
                        </p>
                    </div>

                    <div class="cv-skill-group">
                        <h3>Domaines d'expertise</h3>
                        <p>
                            Optique physique, Traitement d'images, Simulation
                            numérique, Analyse statistique
                        </p>
                    </div>

                    <div class="cv-skill-group">
                        <h3>Langues</h3>
                        <p>
                            Français (natif), Anglais (courant - B2/C1),
                            Espagnol (A1), Japonais (A1)
                        </p>
                    </div>
                </div>
            </div>

            <!-- Publications & Presentations -->
            <div class="cv-block">
                <h2 class="cv-block__title">Publications & Présentations</h2>

                <div class="cv-item">
                    <div class="cv-item__header">
                        <h3 class="cv-item__title">
                            Présentations en conférences
                        </h3>
                    </div>
                    <ul class="cv-item__list">
                        <li>
                            <strong
                                >SPIE Astronomical Telescopes + Instrumentation</strong
                            > (Copenhague) — <em>Juin 2026 (à venir)</em>
                        </li>
                        <li>
                            <strong>LIFE Conference</strong> — <em
                                >Novembre 2025</em
                            >
                        </li>
                        <li>
                            <strong>WITSO</strong> (Workshop ESA, Leiden) — <em
                                >Octobre 2025</em
                            >
                        </li>
                        <li>
                            <strong
                                >SPIE Astronomical Telescopes + Instrumentation</strong
                            > (Yokohama) — <em>Juin 2023</em>
                        </li>
                    </ul>
                </div>

                <div class="cv-item">
                    <div class="cv-item__header">
                        <h3 class="cv-item__title">
                            Publications scientifiques
                        </h3>
                    </div>
                    <ul class="cv-item__list">
                        <li>1 article en cours de finalisation</li>
                        <li>
                            2 articles partiellement rédigés, en attente de
                            résultats expérimentaux
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Qualities -->
            <div class="cv-block">
                <h2 class="cv-block__title">Qualités</h2>
                <div class="cv-qualities">
                    <span class="cv-quality">Créatif</span>
                    <span class="cv-quality">Curieux</span>
                    <span class="cv-quality">Autonome</span>
                    <span class="cv-quality">Altruiste</span>
                </div>
            </div>
        </div>
    </Section>
</PageLayout>

<style>
    .cv-section {
        max-width: 900px;
        margin-inline: auto;
    }

    .cv-header {
        text-align: center;
        margin-block-end: var(--space-12);
        padding-block-end: var(--space-8);
        border-bottom: 2px solid var(--color-border);
    }

    .cv-header h1 {
        font-size: var(--text-4xl);
        margin-block-end: var(--space-3);
    }

    .cv-contact {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-3);
        font-size: var(--text-sm);
        color: var(--color-text-secondary);
    }

    .cv-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-12);
        padding: var(--space-8);
        background-color: var(--color-background-secondary);
        border-radius: var(--radius-lg);
    }

    .cv-block__title {
        font-size: var(--text-2xl);
        color: var(--color-primary);
        margin-block-end: var(--space-6);
        padding-block-end: var(--space-2);
        border-bottom: 1px solid var(--color-border);
    }

    .cv-item {
        margin-block-end: var(--space-8);
    }

    .cv-item:last-child {
        margin-block-end: 0;
    }

    .cv-item__header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: var(--space-4);
        margin-block-end: var(--space-2);
    }

    .cv-item__title {
        font-size: var(--text-xl);
        font-weight: 600;
    }

    .cv-item__date {
        font-size: var(--text-sm);
        color: var(--color-text-muted);
        white-space: nowrap;
    }

    .cv-item__subtitle {
        font-size: var(--text-base);
        color: var(--color-text-secondary);
        font-style: italic;
        margin-block-end: var(--space-3);
    }

    .cv-item__description {
        color: var(--color-text-secondary);
        line-height: 1.6;
        margin-block-end: var(--space-2);
    }

    .cv-item__list {
        list-style: disc;
        padding-inline-start: var(--space-6);
        color: var(--color-text-secondary);
    }

    .cv-item__list li {
        margin-block-end: var(--space-2);
    }

    .cv-skills {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: var(--space-6);
    }

    .cv-skill-group h3 {
        font-size: var(--text-base);
        font-weight: 600;
        margin-block-end: var(--space-2);
    }

    .cv-skill-group p {
        font-size: var(--text-sm);
        color: var(--color-text-secondary);
        line-height: 1.6;
    }

    .cv-qualities {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3);
    }

    .cv-quality {
        padding: var(--space-2) var(--space-4);
        background-color: var(--color-background-secondary);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        font-size: var(--text-sm);
        font-weight: 500;
    }

    .cv-footer {
        margin-block-start: var(--space-16);
        padding-block-start: var(--space-8);
        border-top: 2px solid var(--color-border);
        display: flex;
        justify-content: center;
        gap: var(--space-4);
        flex-wrap: wrap;
    }

    .button {
        display: inline-block;
        padding: var(--space-4) var(--space-8);
        font-size: var(--text-base);
        font-weight: 500;
        background-color: var(--color-primary);
        color: white;
        border-radius: var(--radius-md);
        transition: all var(--transition-base);
        border: 2px solid transparent;
        cursor: pointer;
    }

    .button:hover {
        background-color: var(--color-primary-dark);
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
    }

    .button--secondary {
        background-color: transparent;
        color: var(--color-text);
        border-color: var(--color-border);
    }

    .button--secondary:hover {
        background-color: var(--color-background-secondary);
        border-color: var(--color-primary);
        color: var(--color-primary);
    }

    /* Print styles */
    @media print {
        .cv-footer {
            display: none;
        }

        @page {
            margin: 2cm;
        }
    }

    @media (max-width: 768px) {
        .cv-item__header {
            flex-direction: column;
            align-items: flex-start;
            gap: var(--space-1);
        }

        .cv-skills {
            grid-template-columns: 1fr;
        }
    }
</style>
