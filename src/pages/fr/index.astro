---
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/Section.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { dateToTimestamp } from "../../utils/dates";

// Get top 4 services sorted by order
const allServices = await getCollection("services", ({ data }) => {
    return data.locale === "fr";
});
const topServices = allServices
    .sort((a, b) => a.data.order - b.data.order)
    .slice(0, 4);

// Get featured projects
const allProjects = await getCollection("projects", ({ data }) => {
    return data.locale === "fr";
});
const featuredProjects = allProjects
    .filter((project) => project.data.featured)
    .sort(
        (a, b) =>
            dateToTimestamp(b.data["end-date"]) -
            dateToTimestamp(a.data["end-date"]),
    );
---

<PageLayout
    title="Vincent Foriel - Doctorant en Astrophotonique"
    description="Doctorant en astrophotonique, imagerie à haut contraste et simulation optique"
    currentPath={Astro.url.pathname}
>
    <!-- Hero Section -->
    <Section class="hero">
        <div class="hero__content">
            <h1 class="hero__title">
                Doctorant en<br />
                <span class="hero__highlight">Astrophotonique</span>
            </h1>

            <p class="hero__description">
                Passionné de science et d'espace, inspiré par l'art et propulsé
                par l'informatique.
            </p>

            <div class="hero__cta">
                <a
                    href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}fr/portfolio`}
                    class="button button--primary">Découvrir mes projets</a
                >
                <a
                    href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}fr/contact`}
                    class="button button--secondary">Me contacter</a
                >
            </div>
        </div>
    </Section>

    <!-- Expertise Overview -->
    <Section class="expertise-overview">
        <h2 class="section-title">Domaines d'expertise</h2>

        <div class="expertise-grid">
            {
                topServices.map((service) => (
                    <div class="expertise-card">
                        <div class="expertise-card__icon">
                            {service.data.icon}
                        </div>
                        <h3 class="expertise-card__title">
                            {service.data.title}
                        </h3>
                        <p class="expertise-card__description">
                            {service.data.description}
                        </p>
                    </div>
                ))
            }
        </div>

        <div class="cta-center">
            <a
                href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}fr/expertise`}
                class="link-arrow">Voir tous les services →</a
            >
        </div>
    </Section>

    <!-- Featured Projects -->
    {
        featuredProjects.length > 0 && (
            <Section class="featured-projects">
                <h2 class="section-title">Projets en vedette</h2>

                <div class="projects-grid">
                    {featuredProjects.map((project) => {
                        const cleanSlug = project.slug.replace(/fr$/, "");
                        return (
                            <ProjectCard
                                title={project.data.title}
                                description={project.data.description}
                                startDate={project.data["start-date"]}
                                endDate={project.data["end-date"]}
                                tags={project.data.tags}
                                image={project.data.image}
                                projectSlug={cleanSlug}
                                externalUrl={project.data.url}
                                lang="fr"
                            />
                        );
                    })}
                </div>

                <div class="cta-center">
                    <a
                        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}fr/portfolio`}
                        class="link-arrow"
                    >
                        Voir tous les projets →
                    </a>
                </div>
            </Section>
        )
    }

    <!-- CTA Section -->
    <Section class="cta-section">
        <div class="cta-box">
            <h2 class="cta-box__title">Vous avez un projet ?</h2>
            <p class="cta-box__description">
                Je suis disponible pour des collaborations en recherche, du
                conseil technique, ou des interventions de communication
                scientifique.
            </p>
            <a
                href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}fr/contact`}
                class="button button--primary">Discutons-en</a
            >
        </div>
    </Section>
</PageLayout>

<style>
    /* Hero Section */
    .hero {
        padding-block: var(--space-32) var(--space-24);
    }

    .hero__content {
        max-width: 800px;
        margin-inline: auto;
        text-align: center;
    }

    .hero__title {
        font-size: var(--text-5xl);
        font-weight: 700;
        margin-block-end: var(--space-6);
        line-height: 1.1;
    }

    .hero__highlight {
        color: var(--color-primary);
    }

    .hero__description {
        font-size: var(--text-xl);
        color: var(--color-text-secondary);
        margin-block-end: var(--space-8);
        max-width: 65ch;
        margin-inline: auto;
    }

    .hero__cta {
        display: flex;
        gap: var(--space-4);
        justify-content: center;
        flex-wrap: wrap;
    }

    /* Buttons */
    .button {
        display: inline-block;
        padding: var(--space-4) var(--space-8);
        font-size: var(--text-base);
        font-weight: 500;
        border-radius: var(--radius-md);
        transition: all var(--transition-base);
        border: 2px solid transparent;
    }

    .button--primary {
        background-color: var(--color-primary);
        color: white;
    }

    .button--primary:hover {
        background-color: var(--color-primary-dark);
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
    }

    .button--secondary {
        border-color: var(--color-border);
        color: var(--color-text);
    }

    .button--secondary:hover {
        border-color: var(--color-primary);
        color: var(--color-primary);
    }

    /* Section Title */
    .section-title {
        font-size: var(--text-3xl);
        text-align: center;
        margin-block-end: var(--space-12);
    }

    /* Expertise Grid */
    .expertise-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--space-6);
        margin-block-end: var(--space-8);
    }

    .expertise-card {
        padding: var(--space-8);
        background-color: var(--color-background);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        transition: all var(--transition-base);
    }

    .expertise-card:hover {
        border-color: var(--color-primary);
        box-shadow: var(--shadow-md);
        transform: translateY(-4px);
    }

    .expertise-card__icon {
        font-size: 3rem;
        margin-block-end: var(--space-4);
    }

    .expertise-card__title {
        font-size: var(--text-xl);
        margin-block-end: var(--space-3);
    }

    .expertise-card__description {
        color: var(--color-text-secondary);
        font-size: var(--text-base);
    }

    /* Projects Grid */
    .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: var(--space-8);
        margin-block-end: var(--space-8);
    }

    /* CTA Section */
    .cta-section {
        background-color: var(--color-background-secondary);
    }

    .cta-box {
        max-width: 600px;
        margin-inline: auto;
        text-align: center;
    }

    .cta-box__title {
        font-size: var(--text-3xl);
        margin-block-end: var(--space-4);
    }

    .cta-box__description {
        font-size: var(--text-lg);
        color: var(--color-text-secondary);
        margin-block-end: var(--space-8);
    }

    /* Link Arrow */
    .cta-center {
        text-align: center;
    }

    .link-arrow {
        font-size: var(--text-lg);
        font-weight: 500;
        color: var(--color-primary);
        transition: transform var(--transition-base);
        display: inline-block;
    }

    .link-arrow:hover {
        transform: translateX(4px);
    }

    /* Responsive */
    @media (max-width: 900px) {
        .hero__title {
            font-size: var(--text-4xl);
        }

        .hero__description {
            font-size: var(--text-lg);
        }

        .expertise-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 480px) {
        .expertise-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
