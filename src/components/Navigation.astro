---
import { strings } from "../i18n/strings";
import { withLocalePrefix } from "../i18n/config";

interface Props {
  currentPath?: string;
  lang?: 'fr' | 'en';
}

const { currentPath, lang = 'fr' } = Astro.props;

const t = strings[lang].nav;
const navItems = [
  { href: withLocalePrefix('/about', lang), label: t.about },
  { href: withLocalePrefix('/expertise', lang), label: t.expertise },
  { href: withLocalePrefix('/portfolio', lang), label: t.portfolio },
  { href: withLocalePrefix('/associations', lang), label: t.associations },
  { href: withLocalePrefix('/cv', lang), label: t.cv },
  { href: withLocalePrefix('/contact', lang), label: t.contact },
];

const isActiveLink = (href: string) => {
  // Normalize paths for comparison (remove trailing slash except for root)
  const normalizedCurrent = currentPath?.replace(/\/$/, '') || '';
  const normalizedHref = href.replace(/\/$/, '');
  
  // Exact match for all links (including home)
  return normalizedCurrent === normalizedHref;
};
---

<nav class="nav" aria-label="Navigation principale">
  <ul class="nav__list">
    {navItems.map((item) => (
      <li>
        <a 
          href={item.href} 
          class:list={['nav__link', { 'nav__link--active': isActiveLink(item.href) }]}
          aria-current={isActiveLink(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
    counter-reset: nav;
  }

  .nav__link {
    position: relative;
    display: inline-block;
    padding-block: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
    white-space: nowrap;
    counter-increment: nav;
  }

  .nav__link:hover {
    color: var(--color-text);
  }

  .nav__link--active {
    color: var(--color-text);
  }

  /* Survol : une petite règle graduée se trace sous le lien… */
  .nav__link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 4px;
    background:
      linear-gradient(var(--color-primary), var(--color-primary)) bottom / 100% 1px no-repeat,
      repeating-linear-gradient(90deg, var(--color-primary) 0 1px, transparent 1px 5px) bottom left / 100% 4px no-repeat;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .nav__link:hover::after,
  .nav__link--active::after {
    transform: scaleX(1);
  }

  .nav__link--active::after {
    background: linear-gradient(var(--color-primary), var(--color-primary)) bottom / 100% 1px no-repeat;
  }

  /* … et son numéro apparaît au-dessus */
  .nav__link::before {
    content: counter(nav, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: -0.55rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.06em;
    color: var(--color-primary);
    opacity: 0;
    transform: translateY(3px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .nav__link:hover::before {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__link::after,
    .nav__link::before {
      transition: none;
    }
  }

  /* Navigation dans le menu mobile plein écran : liens numérotés en grande serif */
  :global(.mobile-menu) .nav__list {
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    counter-reset: nav;
  }

  :global(.mobile-menu) .nav__link {
    counter-increment: nav;
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-3);
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    color: var(--color-text);
    width: 100%;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  :global(.mobile-menu) .nav__link::after {
    display: none;
  }

  :global(.mobile-menu) .nav__link::before {
    position: static;
    opacity: 1;
    transform: none;
    content: counter(nav, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  :global(.mobile-menu) .nav__link--active {
    color: var(--color-primary);
  }
</style>
