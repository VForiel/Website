    function updateBaselineList() {
      const pairs = getPairs();
      const panel = $('[data-baseline-panel]');
      panel.hidden = pairs.length <= 1;
      const list = $('[data-baseline-list]');
      list.innerHTML = '';
      pairs.forEach((pair) => {
        const label = document.createElement('label'); label.className = 'baseline-option';
        const input = document.createElement('input'); input.type = 'checkbox'; input.checked = pairIsVisible(pair); input.dataset.pair = pair.key;
        input.addEventListener('change', () => { if (state.visiblePairs === null) state.visiblePairs = new Set(pairs.map((item) => item.key)); if (input.checked) state.visiblePairs.add(pair.key); else state.visiblePairs.delete(pair.key); updateReadout(); });
        const swatch = document.createElement('i'); swatch.style.background = pair.colour;
        const text = document.createElement('span'); text.textContent = `${pair.key} · ${pair.length.toFixed(2)} B`;
        label.append(input, swatch, text); list.append(label);
      });
    }

    function updateMission() {
      const candidate = planetTransmission() > .78 && stellarLeak() < .02;
      $('[data-action="scan"]').disabled = !state.locked;
      $('[data-action="verify"]').disabled = !state.scanned;
      const coach = $('[data-coach]');
      if (!state.locked) coach.textContent = copy.phaseHint;
      else if (!state.scanned) coach.textContent = candidate ? copy.scanHint : copy.scanHint;
      else if (!state.verified) coach.textContent = copy.kernelHint;
      else coach.textContent = copy.conclusion;
      [state.locked, state.scanned, state.verified].forEach((done, index) => { const step = $(`[data-step="${index}"]`); step.classList.toggle('done', done); });
      $('[data-progress]').textContent = `${[state.locked, state.scanned, state.verified].filter(Boolean).length} / 3`;
      $('[data-complete]').hidden = !state.verified;
    }

    function animate(timestamp) { state.time = timestamp; drawSky(missionCanvas, missionCtx, true); drawSky(mapCanvas, mapCtx, false); drawWave(); drawKernel(); requestAnimationFrame(animate); }
    phaseInput.addEventListener('input', (event) => { const selected = selectedTelescope(); if (selected) selected.phase = Number(event.target.value); updateReadout(); updateMission(); });
    $('[data-action="lock"]').addEventListener('click', () => { if (phaseError() <= .16) { state.locked = true; updateMission(); } });
    $('[data-action="scan"]').addEventListener('click', () => { if (planetTransmission() > .78 && stellarLeak() < .02) { state.scanned = true; updateMission(); } else { $('[data-coach]').textContent = copy.scanHint; } });
    $('[data-action="verify"]').addEventListener('click', () => { if (state.scanned) { state.verified = true; updateMission(); } });
    $('[data-reset]').addEventListener('click', () => { state.telescopes = [{ id: 'T1', x: -17.22, y: 0, phase: 0 }, { id: 'T2', x: 17.22, y: 0, phase: 0 }]; state.planets = [{ id: 'P1', x: .27, y: .21, contrast: 1e-6 }]; state.stars = [{ id: 'S0', x: 0, y: 0, contrast: 1, primary: true }]; Object.assign(state, { selected: 'T1', dragging: null, visiblePairs: null, skyScale: 20, arrayScale: 42, locked: false, scanned: false, verified: false }); updateReadout(); updateMission(); });
    $('[data-turbulence]').addEventListener('change', (event) => { state.turbulence = event.target.checked; });

    function scenePoint(event) {
      const rect = missionCanvas.getBoundingClientRect();
      const radius = Math.min(rect.width, rect.height) * .36;
      return { x: (event.clientX - rect.left - rect.width / 2) / radius, y: (event.clientY - rect.top - rect.height / 2) / radius };
    }
    function hitObject(point) {
      const radius = Math.min(missionCanvas.clientWidth, missionCanvas.clientHeight) * .36;
      const objects = [...state.telescopes, ...state.planets, ...state.stars.filter((star) => !star.primary)];
      return objects.find((object) => {
        const position = objectDisplayPosition(object);
        return Math.hypot(point.x - position.x, point.y - position.y) < 24 / radius;
      });
    }
    missionCanvas.addEventListener('pointerdown', (event) => {
      root.focus({ preventScroll: true });
      const rect = missionCanvas.getBoundingClientRect();
      const localY = event.clientY - rect.top;
      if (localY < 46 || localY > rect.height - 46) {
        const isSkyScale = localY < 46;
        const current = isSkyScale ? state.skyScale : state.arrayScale;
        const unit = isSkyScale ? 'mas' : 'm';
        const editor = $('[data-scale-editor]');
        $('[data-scale-editor-label]').textContent = isSkyScale ? (lang === 'fr' ? 'Échelle angulaire du ciel' : 'Sky angular scale') : (lang === 'fr' ? 'Échelle de la baseline' : 'Baseline scale');
        $('[data-scale-input]').value = String(current);
        $('[data-scale-unit]').textContent = unit;
        editor.dataset.scaleKind = isSkyScale ? 'sky' : 'array';
        editor.hidden = false;
        return;
      }
      const object = hitObject(scenePoint(event)); state.selected = object?.id || null; state.dragging = object || null; if (object) missionCanvas.setPointerCapture(event.pointerId); if (object && 'phase' in object) phaseInput.value = String(object.phase); updateReadout();
    });
    $('[data-scale-apply]').addEventListener('click', () => {
      const editor = $('[data-scale-editor]');
      const value = Number($('[data-scale-input]').value);
      if (Number.isFinite(value) && value > 0) { if (editor.dataset.scaleKind === 'sky') state.skyScale = value; else state.arrayScale = value; updateReadout(); }
      editor.hidden = true;
    });
    $('[data-scale-input]').addEventListener('keydown', (event) => { if (event.key === 'Enter') $('[data-scale-apply]').click(); if (event.key === 'Escape') $('[data-scale-editor]').hidden = true; });
    missionCanvas.addEventListener('pointermove', (event) => {
      if (state.dragging) return;
      const rect = missionCanvas.getBoundingClientRect();
      const localY = event.clientY - rect.top;
      if (localY < 46 || localY > rect.height - 46) { missionCanvas.style.cursor = 'pointer'; return; }
      missionCanvas.style.cursor = hitObject(scenePoint(event)) ? 'grab' : 'default';
    });
    missionCanvas.addEventListener('pointermove', (event) => { if (!state.dragging) return; const point = scenePoint(event); if (isTelescope(state.dragging)) { state.dragging.x = point.x * state.arrayScale / 2; state.dragging.y = point.y * state.arrayScale / 2; clampTelescopeToView(state.dragging); } else { state.dragging.x = Math.max(-1.35, Math.min(1.35, point.x)); state.dragging.y = Math.max(-1.05, Math.min(1.05, point.y)); } updateReadout(); updateMission(); });
    missionCanvas.addEventListener('pointerup', () => { state.dragging = null; });
    missionCanvas.addEventListener('pointercancel', () => { state.dragging = null; });
    $('[data-add="planet"]').addEventListener('click', () => { const id = `P${state.planets.length + 1}`; state.planets.push({ id, x: -.34, y: -.23, contrast: 1e-6 }); state.selected = id; updateReadout(); });
    $('[data-add="star"]').addEventListener('click', () => { const id = `S${state.stars.length}`; state.stars.push({ id, x: -.34, y: -.23, contrast: 1e-2 }); state.selected = id; updateReadout(); });
    $('[data-add="telescope"]').addEventListener('click', () => { const id = `T${state.telescopes.length + 1}`; state.telescopes.push({ id, x: 0, y: -state.arrayScale * .41, phase: 0 }); state.selected = id; phaseInput.value = '0'; updateReadout(); });
    $('[data-object-contrast]').addEventListener('input', (event) => { const selected = selectedObject(); if (selected && !selectedTelescope()) selected.contrast = Math.pow(10, Number(event.target.value)); updateReadout(); });
    const updatePosition = (axis, value) => { const selected = selectedObject(); if (!selected || !Number.isFinite(value)) return; setObjectPositionValue(selected, axis, value); if (isTelescope(selected)) fitScaleToTelescope(selected); updateReadout(); updateMission(); };
