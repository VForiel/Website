    }

    function drawWave() {
      const { width: w, height: h } = resizeCanvas(waveCanvas, waveCtx);
      waveCtx.clearRect(0, 0, w, h);
      const left = 28, right = w - 28, half = h * .29, gap = h * .3, amp = Math.min(42, h * .12);
      const bases = [half, half + gap, h * .82];
