---
interface Props {
  lang: 'fr' | 'en';
}

const { lang } = Astro.props;

const copy = lang === 'fr'
  ? {
      eyebrow: 'LABORATOIRE INTERACTIF',
      title: 'Éteindre une étoile<br />pour voir sa planète',
      lead: 'Pilotez un interféromètre, observez les ondes et découvrez pourquoi les <button class="term" data-concept="kernel">kernels</button> sont précieux lorsque le monde réel perturbe la mesure.',
      simplified: 'Modèle pédagogique simplifié',
      tabs: ['Mission', 'Ondes', 'Carte du ciel', 'Kernel nulling'],
      missionTitle: 'Mission : révéler la planète',
      missionText: 'Une planète faible est noyée dans la lumière de son étoile. Réglez d’abord le <button class="term" data-concept="phase">déphasage</button>, choisissez ensuite une bonne <button class="term" data-concept="baseline">ligne de base</button>, puis vérifiez la mesure avec un kernel.',
      steps: ['1. Stabiliser le null', '2. Orienter la ligne de base', '3. Vérifier le kernel'],
      phase: 'Réglage de phase', baseline: 'Longueur de baseline', orientation: 'Orientation de la baseline',
      phaseHelp: 'La cible est π rad : une crête rencontre un creux.',
      lock: 'Verrouiller le null', scan: 'Scanner cette orientation', verify: 'Tester la robustesse kernel',
      locked: 'Null stabilisé', scanDone: 'Signal candidat mesuré', verified: 'Signal vérifié',
      phaseHint: 'Approchez-vous de π pour verrouiller.',
      scanHint: 'Un bon réglage fait passer la planète, pas l’étoile.',
      kernelHint: 'Le kernel sépare mieux le signal astrophysique des défauts instrumentaux.',
      waveTitle: 'Deux ondes, une sortie sombre',
      waveText: 'Les deux télescopes reçoivent la lumière de l’étoile avec la même phase. Un déphaseur impose ensuite π radians dans un bras : les amplitudes s’additionnent à zéro dans la sortie nulle.',
      received: 'Ondes reçues', combined: 'Combinaison', bright: 'sortie brillante', dark: 'sortie nulle',
      skyTitle: 'La carte de transmission',
      skyText: 'Le centre est l’étoile. Les bandes représentent les zones qui passent (bleu) ou sont rejetées (sombre) par la sortie nulle. La planète ne se trouve pas au même endroit que l’étoile : elle ne suit donc pas exactement le même déphasage.',
      kernelTitle: 'Le kernel ne rend pas la lumière magique',
      kernelText: 'Les sorties nulles individuelles restent sensibles au <button class="term" data-concept="piston">piston</button>. Un observable kernel est une combinaison particulière de sorties, choisie pour rejeter — à un certain ordre — des erreurs instrumentales tout en gardant une signature du ciel.',
      turbulence: 'Activer la turbulence', simpleNull: 'Null classique', kernelObservable: 'Observable kernel',
      rawOutput: 'Variation des sorties nulles', kernelOutput: 'Variation du kernel',
      kernelNote: 'Dans cette visualisation, le kernel est un observable calibré : ce n’est ni une sortie noire parfaite, ni une promesse que toute erreur disparaît.',
      readout: 'Lecture instrumentale', starLeak: 'Fuite stellaire', planetSignal: 'Signal planète', contrast: 'Contraste apparent',
      progress: 'Progression de la mission',
      conclusion: 'Planète révélée',
      conclusionText: 'Vous avez combiné trois idées : annuler l’étoile, choisir la géométrie qui laisse passer la planète, puis exploiter un observable plus robuste aux perturbations.',
      reset: 'Recommencer la mission',
      concepts: {
        phase: { title: 'Phase et différence de marche', intuition: 'La phase indique où se trouve une onde dans son cycle : crête, passage à zéro ou creux. Décaler une onde de 180° revient à faire coïncider chaque crête avec un creux.', simulation: 'Le curseur représente le déphasage appliqué à un bras de l’interféromètre. Pour l’étoile placée sur l’axe, la sortie nulle est idéale à $\Delta\phi=\pi$.', detail: 'Pour deux champs de même amplitude, l’intensité de la sortie nulle varie comme $I_\mathrm{nul}/I_\mathrm{brillant}=\sin^2[(\Delta\phi-\pi)/2]$. Près du null, la fuite est quadratique en petite erreur de phase. En pratique, les erreurs d’amplitude, de polarisation et le chromatisme comptent aussi.' },
        baseline: { title: 'Ligne de base', intuition: 'La baseline est le segment qui relie deux télescopes. Sa longueur et son orientation transforment une direction dans le ciel en différence de phase.', simulation: 'Tournez ou allongez la baseline : les franges sur la carte du ciel bougent et se resserrent. Une planète peut se retrouver dans une zone transmise ou rejetée.', detail: 'Pour une source à petit angle $\boldsymbol{\theta}$, la phase géométrique sur une baseline $\mathbf B$ est $2\pi\,\mathbf B\!\cdot\!\boldsymbol{\theta}/\lambda$. Le produit scalaire explique pourquoi l’orientation projetée est essentielle.' },
        piston: { title: 'Piston atmosphérique', intuition: 'Le piston est un décalage global de front d’onde entre deux ouvertures. Il ne déforme pas nécessairement l’image de chaque télescope, mais il casse directement l’interférence entre eux.', simulation: 'La turbulence fait osciller les signaux instrumentaux. Cette perturbation est volontairement amplifiée afin d’être visible.', detail: 'Le piston change la différence de marche optique, donc la phase de manière aléatoire. Le suivi de frange et l’étalonnage sont nécessaires ; une précision pertinente se mesure souvent en une fraction de longueur d’onde.' },
        kernel: { title: 'Kernel nulling', intuition: 'Plutôt que de croire une seule mesure fragile, on combine plusieurs sorties d’un interféromètre à plusieurs télescopes afin de construire une mesure plus fiable.', simulation: 'Activez la turbulence : les courbes des sorties nulles bougent fortement. La courbe kernel varie moins dans ce modèle, car les modes d’erreurs dominants ont été rejetés.', detail: 'Un kernel est une combinaison linéaire définie à partir de la matrice de réponse de l’instrument. Il est construit dans le noyau de la réponse aux petites erreurs considérées. Sa robustesse dépend de l’architecture, du schéma de mesure et de l’ordre de développement ; il ne remplace pas le contrôle de phase.' }
      }
    }
  : {
      eyebrow: 'INTERACTIVE LAB',
      title: 'Turn off a star<br />to see its planet',
      lead: 'Operate an interferometer, inspect the waves, and discover why <button class="term" data-concept="kernel">kernels</button> matter when the real world perturbs a measurement.',
      simplified: 'Simplified teaching model',
      tabs: ['Mission', 'Waves', 'Sky map', 'Kernel nulling'],
      missionTitle: 'Mission: reveal the planet',
      missionText: 'A faint planet is buried in its star’s light. First tune the <button class="term" data-concept="phase">phase shift</button>, then choose a useful <button class="term" data-concept="baseline">baseline</button>, and finally test the measurement with a kernel.',
      steps: ['1. Stabilise the null', '2. Aim the baseline', '3. Check the kernel'],
      phase: 'Phase setting', baseline: 'Baseline length', orientation: 'Baseline orientation',
      phaseHelp: 'The target is π rad: a crest meets a trough.',
      lock: 'Lock the null', scan: 'Scan this orientation', verify: 'Test kernel robustness',
      locked: 'Null stabilised', scanDone: 'Candidate signal measured', verified: 'Signal verified',
      phaseHint: 'Move close to π to lock it.',
      scanHint: 'A good setting transmits the planet, not the star.',
      kernelHint: 'The kernel better separates an astrophysical signal from instrumental defects.',
      waveTitle: 'Two waves, one dark output',
      waveText: 'The telescopes receive the on-axis starlight with the same phase. A phase shifter then applies π radians to one arm: the field amplitudes add to zero at the null output.',
      received: 'Received waves', combined: 'Combination', bright: 'bright output', dark: 'null output',
      skyTitle: 'The transmission map',
      skyText: 'The star sits at the centre. Bands indicate locations passed (blue) or rejected (dark) by the null output. A planet is off axis, so it does not acquire the star’s exact phase shift.',
      kernelTitle: 'A kernel does not make light magical',
      kernelText: 'Individual null outputs remain sensitive to <button class="term" data-concept="piston">piston</button>. A kernel observable is a specific combination of outputs, designed to reject — to a given order — instrumental errors while retaining a sky signature.',
      turbulence: 'Enable turbulence', simpleNull: 'Classical null', kernelObservable: 'Kernel observable',
      rawOutput: 'Null-output variation', kernelOutput: 'Kernel variation',
      kernelNote: 'In this visualisation, the kernel is a calibrated observable: it is neither a perfectly dark output nor a promise that every error vanishes.',
      readout: 'Instrument readout', starLeak: 'Stellar leakage', planetSignal: 'Planet signal', contrast: 'Apparent contrast',
      progress: 'Mission progress',
      conclusion: 'Planet revealed',
      conclusionText: 'You combined three ideas: cancel the star, select a geometry that transmits the planet, then use an observable more robust to perturbations.',
      reset: 'Restart the mission',
      concepts: {
        phase: { title: 'Phase and optical path difference', intuition: 'Phase states where a wave lies in its cycle: crest, zero crossing, or trough. Shifting a wave by 180° makes every crest meet a trough.', simulation: 'The slider represents the phase shift applied to one interferometer arm. For the on-axis star, the null output is ideal at $\Delta\phi=\pi$.', detail: 'For equal-amplitude fields, the null-output intensity follows $I_\mathrm{null}/I_\mathrm{bright}=\sin^2[(\Delta\phi-\pi)/2]$. Close to the null, leakage is quadratic in a small phase error. Amplitude, polarisation and chromatic errors also matter in practice.' },
        baseline: { title: 'Baseline', intuition: 'The baseline is the segment joining two telescopes. Its length and orientation turn a direction in the sky into a phase difference.', simulation: 'Rotate or lengthen the baseline: fringes move and tighten on the sky map. A planet may lie in a transmitted or rejected region.', detail: 'For a source at a small angle $\boldsymbol{\theta}$, the geometric phase over a baseline $\mathbf B$ is $2\pi\,\mathbf B\!\cdot\!\boldsymbol{\theta}/\lambda$. The dot product is why projected orientation matters.' },
        piston: { title: 'Atmospheric piston', intuition: 'Piston is an overall wavefront offset between two apertures. It does not necessarily distort each telescope’s image, but it directly disrupts their interference.', simulation: 'Turbulence makes the instrumental signals oscillate. It is deliberately amplified here to remain visible.', detail: 'Piston changes the optical path difference and therefore the phase at random. Fringe tracking and calibration are required; relevant precision is often a fraction of a wavelength.' },
        kernel: { title: 'Kernel nulling', intuition: 'Rather than trusting a single fragile reading, combine several outputs from a multi-telescope interferometer to construct a more reliable quantity.', simulation: 'Enable turbulence: the individual null-output curves move strongly. The kernel curve moves less in this model because dominant error modes have been rejected.', detail: 'A kernel is a linear combination defined from the instrument response matrix. It belongs to the null space of the response to the small errors being considered. Its robustness depends on the architecture, measurement scheme and expansion order; it does not replace phase control.' }
      }
    };
---

<div class="nulling-lab" data-lab data-lang={lang} data-copy={JSON.stringify(copy)} tabindex="0">
  <header class="lab-hero">
    <p class="eyebrow">{copy.eyebrow} <span>{copy.simplified}</span></p>
    <h1 set:html={copy.title}></h1>
    <p class="lead" set:html={copy.lead}></p>
  </header>

  <div class="lab-tabs" role="tablist" aria-label="Nulling laboratory sections">
    {copy.tabs.map((label, index) => (
      <button class:list={["lab-tab", { active: index === 0 }]} data-tab={index} role="tab" aria-selected={index === 0 ? 'true' : 'false'}>{label}</button>
    ))}
  </div>

  <section class="lab-panel" data-panel="0" role="tabpanel">
    <div class="panel-heading"><p class="section-kicker">01 / EXPERIMENT</p><h2>{copy.missionTitle}</h2><p set:html={copy.missionText}></p></div>
    <div class="mission-layout">
      <div class="scene-card celestial-card">
        <div class="scene-caption"><span class="live-dot"></span><span>{copy.readout}</span><span class="scene-mode">2T NULLER</span></div>
        <div class="scene-toolbar">
          <span data-selection>{lang === 'fr' ? 'Cliquez sur un télescope pour régler sa phase' : 'Click a telescope to tune its phase'}</span>
          <div class="object-actions">
            <button class="object-button" data-add="planet" title={lang === 'fr' ? 'Ajouter une planète' : 'Add a planet'}>＋ <span>{lang === 'fr' ? 'Planète' : 'Planet'}</span></button>
            <button class="object-button" data-add="star" title={lang === 'fr' ? 'Ajouter une étoile' : 'Add a star'}>＋ <span>{lang === 'fr' ? 'Étoile' : 'Star'}</span></button>
            <button class="object-button" data-add="telescope" title={lang === 'fr' ? 'Ajouter un télescope' : 'Add a telescope'}>＋ <span>{lang === 'fr' ? 'Télescope' : 'Telescope'}</span></button>
            <button class="object-button delete-button" data-delete title={lang === 'fr' ? 'Supprimer l’objet sélectionné' : 'Delete selected object'} disabled>⌫</button>
          </div>
        </div>
        <canvas class="sky-canvas" data-canvas="mission" width="720" height="500" aria-label="Interactive sky scene showing a star, planets, telescopes and transmission fringes"></canvas>
        <div class="scale-editor" data-scale-editor hidden>
          <label><span data-scale-editor-label>{lang === 'fr' ? 'Échelle de la scène' : 'Scene scale'}</span><input data-scale-input type="number" min="1" step="1" /><output data-scale-unit></output></label>
          <button type="button" data-scale-apply>{lang === 'fr' ? 'Appliquer' : 'Apply'}</button>
        </div>
        <div class="scene-legend"><span><i class="legend-star"></i>{copy.starLeak}</span><span><i class="legend-planet"></i>{copy.planetSignal}</span><span><i class="legend-baseline"></i>{lang === 'fr' ? 'lignes pointillées : lignes de base' : 'dashed lines: baselines'}</span></div>
      </div>
      <aside class="control-deck">
        <div class="mission-progress"><span>{copy.progress}</span><strong data-progress>0 / 3</strong></div>
        <ol class="mission-steps">
          {copy.steps.map((step, index) => <li data-step={index}><span>{index + 1}</span>{step}<b>✓</b></li>)}
        </ol>
        <div class="selected-object-panel" data-selected-panel hidden>
          <label class="control" data-phase-control><span>{lang === 'fr' ? 'Phase du télescope' : 'Telescope phase'} <output data-phase-label>0.00π</output></span><input data-phase type="range" min="0" max="6.283" step="0.01" value="0" /><small>{copy.phaseHelp}</small></label>
          <label class="control" data-contrast-control><span>{lang === 'fr' ? 'Contraste de l’objet' : 'Object contrast'} <output data-contrast-label>—</output></span><input data-object-contrast type="range" min="-8" max="-4" step="0.1" value="-6" /><small data-contrast-help>{lang === 'fr' ? 'Sélectionnez une étoile ou une planète.' : 'Select a star or planet.'}</small></label>
          <div class="position-controls" data-position-controls hidden>
            <div class="position-title"><span>{lang === 'fr' ? 'Position' : 'Position'}</span><output data-position-unit>—</output></div>
            <label><span>X</span><input data-position-x type="number" step="1" /><output data-position-x-label>—</output></label>
            <label><span>Y</span><input data-position-y type="number" step="1" /><output data-position-y-label>—</output></label>
            <small data-position-help>{lang === 'fr' ? 'Flèches : déplacer de 1 unité. Molette : zoomer.' : 'Arrows: move by 1 unit. Wheel: zoom.'}</small>
          </div>
          <p class="selection-help" data-selection-help>{lang === 'fr' ? 'Sélectionnez un télescope dans la scène.' : 'Select a telescope in the scene.'}</p>
        </div>
        <div class="baseline-panel" data-baseline-panel hidden><div class="baseline-panel-title"><span>{lang === 'fr' ? 'Lignes de base visibles' : 'Visible baselines'}</span><small>{lang === 'fr' ? 'Chaque paire contribue aux franges.' : 'Each pair contributes fringes.'}</small></div><div class="baseline-list" data-baseline-list></div></div>
        <div class="mission-actions">
          <button class="action-button" data-action="lock">{copy.lock}</button>
          <button class="action-button" data-action="scan" disabled>{copy.scan}</button>
          <button class="action-button" data-action="verify" disabled>{copy.verify}</button>
        </div>
        <p class="coach" data-coach>{copy.phaseHint}</p>
      </aside>
    </div>
    <div class="readout-grid">
      <div><span>{copy.starLeak}</span><strong data-leak>1.00</strong><small>relative flux</small></div>
      <div><span>{copy.planetSignal}</span><strong data-planet>0.00</strong><small>relative throughput</small></div>
      <div><span>{copy.contrast}</span><strong data-contrast>—</strong><small>planet / leakage</small></div>
    </div>
    <div class="mission-complete" data-complete hidden><div>✦</div><h3>{copy.conclusion}</h3><p>{copy.conclusionText}</p><button data-reset>{copy.reset}</button></div>
  </section>

  <section class="lab-panel" data-panel="1" role="tabpanel" hidden>
    <div class="panel-heading"><p class="section-kicker">02 / FIELD</p><h2>{copy.waveTitle}</h2><p>{copy.waveText}</p></div>
    <div class="wave-layout">
      <div class="wave-card"><div class="wave-head"><span>{copy.received}</span><span data-wave-phase>Δφ = 0.00π</span></div><canvas class="wave-canvas" data-canvas="waves" width="900" height="360" aria-label="Animated waves from two telescope arms combining at a null output"></canvas><div class="wave-key"><span class="key-a"></span> Telescope A <span class="key-b"></span> Telescope B <span class="key-sum"></span> {copy.combined}</div></div>
      <aside class="formula-card"><p class="formula-label">NULL DEPTH</p><p class="formula">N = sin² <span>(Δφ − π)</span> / 2</p><div class="formula-result"><span>N</span><strong data-null-depth>1.00</strong></div><p>{lang === 'fr' ? 'Ne retenez pas nécessairement la formule : le graphique raconte la même histoire. Lorsque les deux courbes colorées sont opposées, leur somme (blanc) devient plate.' : 'You do not need to memorise the equation: the graph tells the same story. When the coloured curves are opposite, their sum (white) becomes flat.'}</p></aside>
    </div>
  </section>

  <section class="lab-panel" data-panel="2" role="tabpanel" hidden>
    <div class="panel-heading"><p class="section-kicker">03 / GEOMETRY</p><h2>{copy.skyTitle}</h2><p>{copy.skyText}</p></div>
    <div class="map-layout"><div class="scene-card celestial-card"><div class="scene-caption"><span>{copy.orientation}</span><strong data-map-angle>0°</strong></div><canvas class="sky-canvas" data-canvas="map" width="720" height="500" aria-label="Transmission map for the selected interferometer baseline"></canvas></div><aside class="geometry-note"><div class="formula-label">PHASE GÉOMÉTRIQUE</div><p class="geometry-formula">φ = 2π <span>B · θ</span> / λ</p><p>{lang === 'fr' ? 'La baseline agit comme une règle placée sur le ciel. Tournez-la : seul le déplacement de la planète mesuré dans sa direction change la phase géométrique.' : 'The baseline acts as a ruler laid over the sky. Rotate it: only the planet displacement measured along its direction changes the geometric phase.'}</p><button class="term wide-term" data-concept="baseline">{lang === 'fr' ? 'Comprendre la géométrie' : 'Understand the geometry'}</button></aside></div>
  </section>

  <section class="lab-panel" data-panel="3" role="tabpanel" hidden>
    <div class="panel-heading"><p class="section-kicker">04 / ROBUSTNESS</p><h2>{copy.kernelTitle}</h2><p set:html={copy.kernelText}></p></div>
    <div class="kernel-layout"><div class="chip-card"><div class="chip-flow"><div class="tel-group"><span>T1</span><span>T2</span><span>T3</span><span>T4</span></div><div class="chip"><i></i><i></i><i></i><i></i><b>MMI</b></div><div class="outputs"><span>N₁</span><span>N₂</span><span>N₃</span><span>N₄</span><strong>K</strong></div></div><p>{lang === 'fr' ? 'Quatre entrées, plusieurs sorties nulles, puis une combinaison kernel K.' : 'Four inputs, several null outputs, then one kernel combination K.'}</p></div><div class="kernel-controls"><label class="toggle"><input type="checkbox" data-turbulence /><span></span>{copy.turbulence}</label><div class="kernel-stats"><div><span>{copy.simpleNull}</span><strong data-raw-rms>0.00</strong></div><div><span>{copy.kernelObservable}</span><strong data-kernel-rms>0.00</strong></div></div><p>{copy.kernelNote}</p></div></div>
    <div class="trace-card"><div class="trace-head"><span>{copy.rawOutput}</span><span>{copy.kernelOutput}</span></div><canvas class="trace-canvas" data-canvas="kernel" width="1100" height="300" aria-label="Live comparison of classical null and kernel sensitivity to turbulence"></canvas></div>
  </section>

  <div class="concept-modal" data-modal hidden role="dialog" aria-modal="true" aria-labelledby="concept-title"><div class="modal-backdrop" data-close></div><div class="modal-card"><button class="modal-close" data-close aria-label="Close">×</button><p class="section-kicker" data-modal-section>CONCEPT</p><h2 id="concept-title" data-modal-title></h2><div class="concept-columns"><div><h3>{lang === 'fr' ? 'Intuition' : 'Intuition'}</h3><p data-modal-intuition></p><h3>{lang === 'fr' ? 'Dans cette expérience' : 'In this experiment'}</h3><p data-modal-simulation></p></div><div class="technical"><h3>{lang === 'fr' ? 'Pour aller plus loin' : 'Go further'}</h3><p data-modal-detail></p></div></div></div></div>
</div>

<script is:inline>
  const labs = document.querySelectorAll('[data-lab]');
  labs.forEach((root) => {
    const copy = JSON.parse(root.dataset.copy || '{}');
    const lang = root.dataset.lang || 'en';
    const $ = (selector) => root.querySelector(selector);
    const $$ = (selector) => [...root.querySelectorAll(selector)];
    const state = { stars: [{ id: 'S0', x: 0, y: 0, contrast: 1, primary: true }], telescopes: [{ id: 'T1', x: -17.22, y: 0, phase: 0 }, { id: 'T2', x: 17.22, y: 0, phase: 0 }], planets: [{ id: 'P1', x: .27, y: .21, contrast: 1e-6 }], selected: 'T1', dragging: null, visiblePairs: null, skyScale: 20, arrayScale: 42, turbulence: false, locked: false, scanned: false, verified: false, time: 0, samples: [] };
    const phaseInput = $('[data-phase]');
    const missionCanvas = $('[data-canvas="mission"]');
    const mapCanvas = $('[data-canvas="map"]');
    const waveCanvas = $('[data-canvas="waves"]');
    const kernelCanvas = $('[data-canvas="kernel"]');
    const missionCtx = missionCanvas.getContext('2d');
    const mapCtx = mapCanvas.getContext('2d');
    const waveCtx = waveCanvas.getContext('2d');
    const kernelCtx = kernelCanvas.getContext('2d');

    const referenceBaseline = 1.64;
    const selectedTelescope = () => state.telescopes.find((telescope) => telescope.id === state.selected);
    const selectedStar = () => state.stars.find((star) => star.id === state.selected);
    const selectedPlanet = () => state.planets.find((planet) => planet.id === state.selected);
    const selectedObject = () => selectedTelescope() || selectedStar() || selectedPlanet();
    const isTelescope = (object) => Boolean(object && 'phase' in object);
    const objectDisplayPosition = (object) => isTelescope(object) ? { x: object.x / (state.arrayScale / 2), y: object.y / (state.arrayScale / 2) } : object;
    const objectPositionUnit = (object) => isTelescope(object) ? 'm' : 'mas';
    const objectPositionValue = (object, axis) => isTelescope(object) ? object[axis] : object[axis] * state.skyScale / 2;
    const setObjectPositionValue = (object, axis, value) => { object[axis] = isTelescope(object) ? value : value / (state.skyScale / 2); };
    const clampTelescopeToView = (telescope) => {
      const limit = state.arrayScale / 2 * .96;
      telescope.x = Math.max(-limit, Math.min(limit, telescope.x));
      telescope.y = Math.max(-limit, Math.min(limit, telescope.y));
    };
    const fitScaleToTelescope = (telescope) => {
      const requiredScale = Math.max(Math.abs(telescope.x), Math.abs(telescope.y)) * 2 / .96;
      if (requiredScale > state.arrayScale) state.arrayScale = Math.min(500, requiredScale);
    };
    // The interferometric centre is the canvas centre. In this teaching model,
    // B is the telescope distance from that centre and theta its polar angle.
    const geometricPhase = (telescope) => {
      const B = Math.hypot(telescope.x, telescope.y);
      const theta = Math.atan2(telescope.y, telescope.x);
      return B * Math.cos(theta);
    };
    const totalPhase = (telescope) => telescope.phase + geometricPhase(telescope);
    const relativePhase = () => state.telescopes.length > 1 ? totalPhase(state.telescopes[1]) - totalPhase(state.telescopes[0]) : totalPhase(state.telescopes[0] || { x: 0, y: 0, phase: 0 });
    const baselineGeometry = () => {
      const first = state.telescopes[0], second = state.telescopes[1] || first;
      const dx = second.x - first.x, dy = second.y - first.y;
      return { length: Math.max(.1, Math.hypot(dx, dy)), angle: Math.atan2(dy, dx) };
    };
    const phaseError = () => {
      return Math.abs(((relativePhase() - Math.PI + Math.PI) % (2 * Math.PI)) - Math.PI);
    };
    const stellarLeak = () => Math.pow(Math.sin(phaseError() / 2), 2);
    const getPairs = () => {
      const pairs = [];
      for (let first = 0; first < state.telescopes.length; first += 1) {
        for (let second = first + 1; second < state.telescopes.length; second += 1) {
          const telescopeA = state.telescopes[first];
          const telescopeB = state.telescopes[second];
          pairs.push({
            key: `${telescopeA.id}-${telescopeB.id}`,
            colour: ['#f5b546', '#62b8ff', '#5ee6b1', '#df8fff', '#ff8e72', '#b9d8ff'][(pairs.length) % 6],
            first: telescopeA,
            second: telescopeB,
            length: Math.hypot(telescopeB.x - telescopeA.x, telescopeB.y - telescopeA.y),
            angle: Math.atan2(telescopeB.y - telescopeA.y, telescopeB.x - telescopeA.x),
