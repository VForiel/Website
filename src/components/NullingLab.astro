    const formatNumber = (value) => value < 0.001 ? value.toExponential(1) : value.toFixed(3);

    function resizeCanvas(canvas, ctx) {
      const rect = canvas.getBoundingClientRect();
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      const width = Math.max(1, Math.round(rect.width * ratio));
      const height = Math.max(1, Math.round(rect.height * ratio));
      if (canvas.width !== width || canvas.height !== height) { canvas.width = width; canvas.height = height; }
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      return { width: rect.width, height: rect.height };
    }

    function drawSky(canvas, ctx, isMission) {
      const { width: w, height: h } = resizeCanvas(canvas, ctx);
      ctx.clearRect(0, 0, w, h);
      const cx = w * 0.5, cy = h * 0.5;
      const radius = Math.min(w, h) * 0.36;
      const pairs = getPairs();
      ctx.save();
      ctx.beginPath(); ctx.rect(0, 0, w, h); ctx.clip();
      const diagonal = Math.hypot(w, h);
      // Every pair contributes one transmission pattern; adding them gives
      // the multi-baseline response when more telescopes are present.
      pairs.filter(pairIsVisible).forEach((pair) => {
        ctx.save(); ctx.translate(cx, cy); ctx.rotate(pair.angle);
        for (let x = -diagonal; x <= diagonal; x += 3) {
          const angularCoordinate = x / diagonal * state.skyScale;
          const phase = angularCoordinate * (pair.length / referenceBaseline) * Math.PI + totalPhase(pair.second) - totalPhase(pair.first) - Math.PI;
          const pass = Math.pow(Math.sin(phase / 2), 2);
          ctx.fillStyle = `rgba(63, 169, 245, ${0.025 + pass * 0.12 / Math.max(1, pairs.filter(pairIsVisible).length)})`;
          ctx.fillRect(x, -diagonal, 4, diagonal * 2);
        }
        ctx.restore();
      });
      ctx.restore();
      // baseline and array
      pairs.filter(pairIsVisible).forEach((pair, index) => {
        const firstPosition = objectDisplayPosition(pair.first);
        const secondPosition = objectDisplayPosition(pair.second);
        const firstX = cx + firstPosition.x * radius, firstY = cy + firstPosition.y * radius;
        const secondX = cx + secondPosition.x * radius, secondY = cy + secondPosition.y * radius;
        ctx.setLineDash([6, 6]); ctx.strokeStyle = pair.colour; ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.moveTo(firstX, firstY); ctx.lineTo(secondX, secondY); ctx.stroke(); ctx.setLineDash([]);
      });
      state.telescopes.forEach((telescope) => {
        const position = objectDisplayPosition(telescope);
        const x = cx + position.x * radius, y = cy + position.y * radius;
        ctx.fillStyle = 'rgba(13, 37, 59, .96)'; ctx.strokeStyle = '#f5b546'; ctx.lineWidth = 2;
        ctx.beginPath(); ctx.arc(x, y, 15, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
        if (telescope.id === state.selected) { ctx.strokeStyle = '#62b8ff'; ctx.lineWidth = 3; ctx.beginPath(); ctx.arc(x, y, 20, 0, Math.PI * 2); ctx.stroke(); }
        // The marker shows the user-controlled delay only. The geometric
        // contribution is intentionally kept visible only in the sky map.
        const markerAngle = -Math.PI / 2 + telescope.phase;
        ctx.fillStyle = telescope.id === state.selected ? '#62b8ff' : '#f5b546';
        ctx.beginPath(); ctx.arc(x + Math.cos(markerAngle) * 23, y + Math.sin(markerAngle) * 23, 3.5, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = '#dbeafe'; ctx.font = '10px Inter, sans-serif'; ctx.textAlign = 'center'; ctx.fillText(telescope.id, x, y + 3);
      });
      // star, fixed at orbit centre
      const leak = stellarLeak();
      const glow = 18 + Math.max(0.08, leak) * 48;
      const starGradient = ctx.createRadialGradient(cx, cy, 0, cx, cy, glow);
      starGradient.addColorStop(0, 'rgba(255, 249, 207, 1)'); starGradient.addColorStop(.25, 'rgba(245, 181, 70, .95)'); starGradient.addColorStop(1, 'rgba(245, 181, 70, 0)');
      ctx.fillStyle = starGradient; ctx.beginPath(); ctx.arc(cx, cy, glow, 0, 2 * Math.PI); ctx.fill();
      ctx.fillStyle = '#fff6cc'; ctx.beginPath(); ctx.arc(cx, cy, 7 + leak * 9, 0, 2 * Math.PI); ctx.fill();
      state.stars.filter((star) => !star.primary).forEach((star) => {
        const sx = cx + star.x * radius, sy = cy + star.y * radius;
        if (star.id === state.selected) { ctx.strokeStyle = '#62b8ff'; ctx.lineWidth = 2; ctx.setLineDash([3, 3]); ctx.beginPath(); ctx.arc(sx, sy, 24, 0, 2 * Math.PI); ctx.stroke(); ctx.setLineDash([]); }
        const starSignal = getPairs().filter(pairIsVisible).reduce((sum, pair) => sum + sourceTransmission(star, pair), 0) / Math.max(1, getPairs().filter(pairIsVisible).length);
        const starSize = 3 + Math.min(10, Math.max(0, Math.log10(star.contrast) + 2) * 2.2);
        const starGlow = ctx.createRadialGradient(sx, sy, 0, sx, sy, 16 + starSignal * 14);
        starGlow.addColorStop(0, `rgba(255, 207, 119, ${Math.min(1, .25 + star.contrast * 0.12 + starSignal)})`); starGlow.addColorStop(1, 'rgba(245, 181, 70, 0)');
        ctx.fillStyle = starGlow; ctx.beginPath(); ctx.arc(sx, sy, 18, 0, 2 * Math.PI); ctx.fill();
        ctx.fillStyle = `rgba(255, 226, 153, ${Math.min(1, .35 + star.contrast * .06 + starSignal)})`; ctx.beginPath(); ctx.arc(sx, sy, starSize, 0, 2 * Math.PI); ctx.fill();
        ctx.fillStyle = 'rgba(218,241,255,.9)'; ctx.font = '11px Inter, sans-serif'; ctx.textAlign = 'left'; ctx.fillText(star.id, sx + 13, sy - 10);
      });
      // The orbit is centred on the star, so every planet remains on the same reference orbit.
      ctx.strokeStyle = 'rgba(148, 180, 220, .24)'; ctx.lineWidth = 1; ctx.setLineDash([3, 5]); ctx.beginPath(); ctx.arc(cx, cy, radius * .52, 0, Math.PI * 2); ctx.stroke(); ctx.setLineDash([]);
      state.planets.forEach((planet) => {
        const px = cx + planet.x * radius;
        const py = cy + planet.y * radius;
      if (planet.id === state.selected) { ctx.strokeStyle = '#62b8ff'; ctx.lineWidth = 2; ctx.setLineDash([3, 3]); ctx.beginPath(); ctx.arc(px, py, 18, 0, 2 * Math.PI); ctx.stroke(); ctx.setLineDash([]); }
      const activePairs = getPairs().filter(pairIsVisible);
      const transmission = activePairs.length ? activePairs.reduce((sum, pair) => sum + sourceTransmission(planet, pair), 0) / activePairs.length : 0;
      const visibility = Math.min(1, transmission / (leak + .06));
      const planetGlow = ctx.createRadialGradient(px, py, 1, px, py, 22);
      planetGlow.addColorStop(0, `rgba(115, 220, 255, ${0.3 + visibility * .65})`); planetGlow.addColorStop(1, 'rgba(115, 220, 255, 0)');
      ctx.fillStyle = planetGlow; ctx.beginPath(); ctx.arc(px, py, 22, 0, Math.PI * 2); ctx.fill();
      const planetSize = 2.5 + Math.max(0, Math.log10(planet.contrast) + 8) * .7;
      ctx.fillStyle = `rgba(155, 233, 255, ${Math.min(1, .12 + planet.contrast * 1e5 + visibility * .78)})`; ctx.beginPath(); ctx.arc(px, py, planetSize + visibility * 3, 0, 2 * Math.PI); ctx.fill();
