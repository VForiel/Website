    }

    function updateReadout() {
      const leak = stellarLeak(), planet = planetTransmission(), contrast = planet / (leak + 0.006);
      const selected = selectedObject();
      const telescope = selectedTelescope();
      $('[data-selected-panel]').hidden = !selected;
      $('[data-phase-label]').textContent = `${((telescope?.phase || 0) / Math.PI).toFixed(2)}π`;
      const geometry = baselineGeometry();
      $('[data-map-angle]').textContent = `${Math.round(geometry.angle * 180 / Math.PI)}°`;
      $('[data-wave-phase]').textContent = `Δφ = ${(phaseError() / Math.PI).toFixed(2)}π`;
      $('[data-leak]').textContent = formatNumber(leak);
      $('[data-planet]').textContent = formatNumber(planet);
      $('[data-contrast]').textContent = contrast > 10 ? 'excellent' : contrast.toFixed(1);
      $('[data-null-depth]').textContent = formatNumber(leak);
      const lock = $('[data-action="lock"]');
      if (!state.locked) lock.disabled = phaseError() > .16;
      $('[data-selection]').textContent = selected ? `${selected.id}${telescope ? ` · ${lang === 'fr' ? 'phase' : 'phase'} ${(telescope.phase / Math.PI).toFixed(2)}π` : ''}` : (lang === 'fr' ? 'Aucun objet sélectionné' : 'No object selected');
      $('[data-delete]').disabled = !state.selected;
      phaseInput.disabled = !telescope;
      const contrastInput = $('[data-object-contrast]');
      const contrastLabel = $('[data-contrast-label]');
      const contrastHelp = $('[data-contrast-help]');
      $('[data-phase-control]').hidden = !telescope;
      $('[data-contrast-control]').hidden = !selected || telescope;
      const positionControls = $('[data-position-controls]');
      positionControls.hidden = !selected;
      if (selected) {
        const unit = objectPositionUnit(selected);
        $('[data-position-unit]').textContent = unit;
        $('[data-position-x]').value = objectPositionValue(selected, 'x').toFixed(2);
        $('[data-position-y]').value = objectPositionValue(selected, 'y').toFixed(2);
        $('[data-position-x-label]').textContent = unit;
        $('[data-position-y-label]').textContent = unit;
      }
      contrastInput.disabled = !selected || telescope;
      if (selected && !telescope && selected.contrast) {
        const exponent = Math.log10(selected.contrast);
        contrastInput.min = selected.id.startsWith('S') ? '-2' : '-8';
        contrastInput.max = selected.id.startsWith('S') ? '1' : '-4';
        contrastInput.value = String(exponent);
        contrastLabel.textContent = `10^${exponent.toFixed(1)}`;
        contrastHelp.textContent = selected.id.startsWith('S') ? (lang === 'fr' ? 'Étoile secondaire : 10⁻² à 10¹.' : 'Secondary star: 10⁻² to 10¹.') : (lang === 'fr' ? 'Planète : 10⁻⁴ à 10⁻⁸.' : 'Planet: 10⁻⁴ to 10⁻⁸.');
      } else { contrastLabel.textContent = '—'; contrastHelp.textContent = lang === 'fr' ? 'Sélectionnez une étoile ou une planète.' : 'Select a star or planet.'; }
      $('[data-selection-help]').textContent = selected ? (telescope ? (lang === 'fr' ? `Déplacez ${selected.id} ou ajustez son délai en phase.` : `Drag ${selected.id} or adjust its phase delay.`) : (lang === 'fr' ? `Déplacez ${selected.id} sur la carte.` : `Drag ${selected.id} on the map.`)) : (lang === 'fr' ? 'Sélectionnez un télescope dans la scène.' : 'Select a telescope in the scene.');
