    }

    function drawKernel() {
      const { width: w, height: h } = resizeCanvas(kernelCanvas, kernelCtx);
      kernelCtx.clearRect(0, 0, w, h);
      const mid = h / 2, left = 34, right = w - 24;
      kernelCtx.strokeStyle = 'rgba(156, 183, 220, .2)'; kernelCtx.setLineDash([4, 6]); kernelCtx.beginPath(); kernelCtx.moveTo(left, mid); kernelCtx.lineTo(right, mid); kernelCtx.stroke(); kernelCtx.setLineDash([]);
