      ctx.strokeStyle = 'rgba(219,234,254,.7)'; ctx.lineWidth = 2; ctx.beginPath(); ctx.moveTo(w * .36, 24); ctx.lineTo(w * .64, 24); ctx.moveTo(w * .36, h - 25); ctx.lineTo(w * .64, h - 25); ctx.stroke();
