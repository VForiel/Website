---
// SpaceInvaders.astro
---

<div id="space-invaders-container" class="easter-egg-container hidden">
    <div class="game-wrapper">
        <div class="game-header">
            <h2>Space Invaders</h2>
            <div class="game-stats">
                <span id="game-score">Score: 0</span>
                <span id="game-level">Level: 1</span>
                <span id="game-accuracy">Acc: 0%</span>
            </div>
            <button id="close-game" class="close-btn" aria-label="Close game"
                >✕</button
            >
        </div>
        <canvas id="game-canvas" width="800" height="600"></canvas>
        <div id="game-over-screen" class="overlay hidden">
            <h3>Game Over!</h3>
            <p>Score: <span id="final-score">0</span></p>
            <p>Level: <span id="final-level">1</span></p>
            <p>Accuracy: <span id="final-accuracy">0</span>%</p>
            <button id="restart-game" class="btn">Play Again</button>
        </div>
        <div id="start-screen" class="overlay">
            <h3>Ready to defend the galaxy?</h3>
            <p>Use your mouse to move left and right.</p>
            <p>Click to shoot.</p>
            <button id="start-game" class="btn">Start Game</button>
        </div>
    </div>
</div>

<style>
    .easter-egg-container {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.85);
        z-index: 9999;
        display: flex;
        justify-content: center;
        align-items: center;
        backdrop-filter: blur(5px);
    }
    .easter-egg-container.hidden {
        display: none;
    }
    .game-wrapper {
        position: relative;
        background: #111;
        border: 2px solid var(--color-primary);
        border-radius: var(--radius-lg);
        overflow: hidden;
        box-shadow: 0 0 30px rgba(var(--color-primary-rgb), 0.3);
        max-width: 100vw;
        max-height: 100vh;
    }
    .game-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: var(--space-4);
        background: #222;
        color: #fff;
        border-bottom: 2px solid var(--color-primary);
    }
    .game-header h2 {
        margin: 0;
        font-size: var(--text-lg);
        color: var(--color-primary);
        font-family: monospace;
        letter-spacing: 2px;
    }
    .game-stats {
        display: flex;
        gap: var(--space-6);
        font-family: monospace;
        font-size: var(--text-md);
    }
    .close-btn {
        background: none;
        border: none;
        color: #aaa;
        font-size: var(--text-xl);
        cursor: pointer;
        transition: color 0.2s;
        line-height: 1;
    }
    .close-btn:hover {
        color: #fff;
    }
    canvas {
        display: block;
        background: #000;
        cursor: crosshair;
        max-width: 100%;
        max-height: calc(100vh - 80px); /* header height approx */
    }
    .overlay {
        position: absolute;
        inset: 0;
        top: 60px; /* Below header */
        background: rgba(0, 0, 0, 0.8);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: white;
        text-align: center;
    }
    .overlay.hidden {
        display: none;
    }
    .overlay h3 {
        font-size: var(--text-3xl);
        color: var(--color-primary);
        margin-bottom: var(--space-4);
        font-family: monospace;
    }
    .overlay p {
        font-size: var(--text-lg);
        margin-bottom: var(--space-2);
        font-family: monospace;
    }
    .btn {
        margin-top: var(--space-6);
        background: var(--color-primary);
        color: white;
        border: none;
        padding: var(--space-3) var(--space-8);
        font-size: var(--text-lg);
        font-family: monospace;
        text-transform: uppercase;
        border-radius: var(--radius-sm);
        cursor: pointer;
        transition:
            transform 0.1s,
            filter 0.2s;
    }
    .btn:hover {
        filter: brightness(1.2);
        transform: scale(1.05);
    }
    .btn:active {
        transform: scale(0.95);
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const container = document.getElementById("space-invaders-container");
        const closeBtn = document.getElementById("close-game");
        const startBtn = document.getElementById("start-game");
        const restartBtn = document.getElementById("restart-game");
        const canvas = document.getElementById(
            "game-canvas",
        ) as HTMLCanvasElement;

        if (!container || !canvas) return;

        const ctx = canvas.getContext("2d");
        if (!ctx) return;

        // UI Elements
        const scoreEl = document.getElementById("game-score");
        const levelEl = document.getElementById("game-level");
        const finalScoreEl = document.getElementById("final-score");
        const finalLevelEl = document.getElementById("final-level");
        const accuracyEl = document.getElementById("game-accuracy");
        const finalAccuracyEl = document.getElementById("final-accuracy");
        const startScreen = document.getElementById("start-screen");
        const gameOverScreen = document.getElementById("game-over-screen");

        // Game State
        let isPlaying = false;
        let score = 0;
        let level = 1;
        let animationId: number;
        let lastTime = 0;
        let shotsFired = 0;
        let shotsHit = 0;
        let shotTimer = 0;
        const BASE_SHOT_INTERVAL = 150; // ms between shots
        let nextShotInterval = BASE_SHOT_INTERVAL;
        let levelTextTimer = 0;
        const LEVEL_TEXT_DURATION = 2000; // ms

        let cooldownTimer = 0;
        const COOLDOWN = 180; // ms
        let isShooting = false;

        // Simple Audio Synthesizer
        const AudioContext =
            window.AudioContext || (window as any).webkitAudioContext;
        const audioCtx = new AudioContext();

        function playSound(type: "shoot" | "explosion" | "victory") {
            if (audioCtx.state === "suspended") return; // Don't try to play if locked

            const oscillator = audioCtx.createOscillator();
            const gainNode = audioCtx.createGain();

            oscillator.connect(gainNode);
            gainNode.connect(audioCtx.destination);

            const now = audioCtx.currentTime;

            if (type === "shoot") {
                // Short high-pitched pew
                oscillator.type = "square";
                oscillator.frequency.setValueAtTime(800, now);
                oscillator.frequency.exponentialRampToValueAtTime(
                    300,
                    now + 0.1,
                );

                gainNode.gain.setValueAtTime(0.05, now); // Low volume
                gainNode.gain.exponentialRampToValueAtTime(0.01, now + 0.1);

                oscillator.start(now);
                oscillator.stop(now + 0.1);
            } else if (type === "explosion") {
                // Lower pitched, noisy boom
                oscillator.type = "sawtooth";
                oscillator.frequency.setValueAtTime(200, now);
                oscillator.frequency.exponentialRampToValueAtTime(
                    50,
                    now + 0.2,
                );

                gainNode.gain.setValueAtTime(0.1, now);
                gainNode.gain.exponentialRampToValueAtTime(0.01, now + 0.2);

                oscillator.start(now);
                oscillator.stop(now + 0.2);
            } else if (type === "victory") {
                // Happy ascending chime
                oscillator.type = "sine";

                // C major arpeggio very fast
                oscillator.frequency.setValueAtTime(523.25, now); // C5
                oscillator.frequency.setValueAtTime(659.25, now + 0.1); // E5
                oscillator.frequency.setValueAtTime(783.99, now + 0.2); // G5
                oscillator.frequency.setValueAtTime(1046.5, now + 0.3); // C6

                gainNode.gain.setValueAtTime(0.1, now);
                gainNode.gain.linearRampToValueAtTime(0.01, now + 0.5);

                oscillator.start(now);
                oscillator.stop(now + 0.5);
            }
        }

        // Entities
        const player = {
            x: canvas.width / 2,
            y: canvas.height - 40,
            width: 40,
            height: 20,
            color: "#4ade80", // bright green approx
            speed: 5,
        };

        let bullets: {
            x: number;
            y: number;
            radius: number;
            speed: number;
            color: string;
        }[] = [];
        let enemies: {
            x: number;
            y: number;
            width: number;
            height: number;
            speed: number;
            color: string;
            points: number;
        }[] = [];
        let particles: {
            x: number;
            y: number;
            vx: number;
            vy: number;
            life: number;
            maxLife: number;
            color: string;
            size: number;
        }[] = [];

        let enemyDirection = 1; // 1 right, -1 left
        let enemySpeedMultiplier = 1;

        // Input
        let mouseX = player.x;

        // Custom event from Footer
        document.addEventListener("open-easter-egg", () => {
            container.classList.remove("hidden");
            // Give time for display:block to apply before calculating canvas dimensions if needed
            setTimeout(() => initGame(), 50);
        });

        closeBtn.addEventListener("click", () => {
            container.classList.add("hidden");
            stopGame();
        });

        startBtn.addEventListener("click", () => {
            if (audioCtx.state === "suspended") audioCtx.resume();
            startScreen.classList.add("hidden");
            startGame();
        });

        restartBtn.addEventListener("click", () => {
            if (audioCtx.state === "suspended") audioCtx.resume();
            gameOverScreen.classList.add("hidden");
            initGame();
            startGame();
        });

        canvas.addEventListener("mousemove", (e) => {
            if (!isPlaying) return;
            const rect = canvas.getBoundingClientRect();
            // Scale mouse coordinates to match canvas internal resolution
            const scaleX = canvas.width / rect.width;
            mouseX = (e.clientX - rect.left) * scaleX;
            // Clamp player to screen
            mouseX = Math.max(
                player.width / 2,
                Math.min(canvas.width - player.width / 2, mouseX),
            );
        });

        canvas.addEventListener("mousedown", () => {
            if (!isPlaying) return;
            if (audioCtx.state === "suspended") audioCtx.resume();

            // Fire instantly on first click if ready
            if (cooldownTimer <= 0) {
                shoot();
            }
            isShooting = true;
        });

        canvas.addEventListener("mouseup", () => {
            isShooting = false;
        });

        canvas.addEventListener("mouseleave", () => {
            isShooting = false;
        });

        function initLevel() {
            enemies = [];
            bullets = [];
            particles = [];
            enemyDirection = 1;
            enemySpeedMultiplier = 1 + level * 0.15;

            const rows = 3 + Math.min(Math.floor(level / 2), 4);
            const cols = 8 + Math.min(Math.floor(level / 3), 4);

            const totalWidth = cols * 60;
            const startX = (canvas.width - totalWidth) / 2 + 30; // Center formation
            const startY = 60;
            const paddingX = 60;
            const paddingY = 40;

            for (let r = 0; r < rows; r++) {
                for (let c = 0; c < cols; c++) {
                    const type = rows - r;
                    let color = "#fff";
                    let points = 10;

                    if (r === 0) {
                        color = "#f87171";
                        points = 30;
                    } // Top row red
                    else if (r === 1) {
                        color = "#fbbf24";
                        points = 20;
                    } // Yellow
                    else {
                        color = "#60a5fa";
                        points = 10;
                    } // Blue

                    enemies.push({
                        x: startX + c * paddingX,
                        y: startY + r * paddingY,
                        width: 30,
                        height: 20,
                        speed: 1.0,
                        color: color,
                        points: points,
                    });
                }
            }
        }

        function initGame() {
            score = 0;
            level = 1;
            shotsFired = 0;
            shotsHit = 0;
            updateUI();
            initLevel();
            player.x = canvas.width / 2;
            mouseX = player.x;
            draw();
        }

        function startGame() {
            isPlaying = true;
            lastTime = performance.now();
            loop(lastTime);
        }

        function stopGame() {
            isPlaying = false;
            cancelAnimationFrame(animationId);
        }

        function gameOver() {
            stopGame();
            const accuracy =
                shotsFired > 0 ? Math.round((shotsHit / shotsFired) * 100) : 0;
            if (finalScoreEl) finalScoreEl.textContent = score.toString();
            if (finalLevelEl) finalLevelEl.textContent = level.toString();
            if (finalAccuracyEl)
                finalAccuracyEl.textContent = accuracy.toString();
            gameOverScreen.classList.remove("hidden");
        }

        function nextLevel() {
            level++;
            levelTextTimer = LEVEL_TEXT_DURATION;
            playSound("victory");
            updateUI();
            initLevel();
        }

        function updateUI() {
            const accuracy =
                shotsFired > 0 ? Math.round((shotsHit / shotsFired) * 100) : 0;
            if (scoreEl) scoreEl.textContent = `Score: ${score}`;
            if (levelEl) levelEl.textContent = `Level: ${level}`;
            if (accuracyEl) accuracyEl.textContent = `Acc: ${accuracy}%`;
        }

        function shoot() {
            if (bullets.length > 5) return;

            cooldownTimer = COOLDOWN;
            shotsFired++;
            updateUI(); // Immediate UI update for accuracy

            bullets.push({
                x: player.x,
                y: player.y - player.height,
                radius: 3,
                speed: 10,
                color: "#fff",
            });
            playSound("shoot");
        }

        function createExplosion(x: number, y: number, color: string) {
            const count = 15;
            for (let i = 0; i < count; i++) {
                const angle = Math.random() * Math.PI * 2;
                const speed = 1 + Math.random() * 4;
                particles.push({
                    x,
                    y,
                    vx: Math.cos(angle) * speed,
                    vy: Math.sin(angle) * speed,
                    life: 1,
                    maxLife: 20 + Math.random() * 20,
                    color,
                    size: 1 + Math.random() * 2,
                });
            }
        }

        function update(dt: number) {
            if (levelTextTimer > 0) {
                levelTextTimer -= dt;
            }

            if (cooldownTimer > 0) {
                cooldownTimer -= dt;
            }

            // Handle continuous shooting if mouse is held down
            if (isShooting && cooldownTimer <= 0) {
                shoot();
            }

            // Smoothly move player to mouse X
            player.x += (mouseX - player.x) * 0.3; // Snappier

            // Update bullets
            for (let i = bullets.length - 1; i >= 0; i--) {
                const b = bullets[i];
                // Adjust speed independently of framerate simply here, though fixed step is better
                const timeScale = Math.min(dt / 16.66, 2);
                b.y -= b.speed * timeScale;

                if (b.y < 0) {
                    bullets.splice(i, 1);
                }
            }

            // Update particles
            for (let i = particles.length - 1; i >= 0; i--) {
                const p = particles[i];
                const timeScale = Math.min(dt / 16.66, 2);
                p.x += p.vx * timeScale;
                p.y += p.vy * timeScale;
                p.life += timeScale;
                if (p.life >= p.maxLife) {
                    particles.splice(i, 1);
                }
            }

            // Update enemies
            if (enemies.length === 0) {
                nextLevel();
                return;
            }

            let hitEdge = false;
            for (const enemy of enemies) {
                if (
                    enemy.x + enemy.width / 2 > canvas.width - 20 ||
                    enemy.x - enemy.width / 2 < 20
                ) {
                    hitEdge = true;
                    break;
                }
            }

            const timeScale = Math.min(dt / 16.66, 2);

            if (hitEdge) {
                enemyDirection *= -1;
                // Move down
                for (const enemy of enemies) {
                    enemy.y += 20;
                    // Clamp inside bounds
                    enemy.x = Math.max(
                        enemy.width / 2 + 20,
                        Math.min(canvas.width - enemy.width / 2 - 20, enemy.x),
                    );

                    if (enemy.y + enemy.height > player.y - 40) {
                        // Gave a little grace area
                        gameOver();
                        return;
                    }
                }
            }

            for (const enemy of enemies) {
                enemy.x +=
                    enemy.speed *
                    enemyDirection *
                    enemySpeedMultiplier *
                    timeScale;
            }

            // Collision detection
            for (let i = enemies.length - 1; i >= 0; i--) {
                const enemy = enemies[i];
                let enemyHit = false;

                for (let j = bullets.length - 1; j >= 0; j--) {
                    const bullet = bullets[j];

                    if (
                        bullet.x > enemy.x - enemy.width / 2 &&
                        bullet.x < enemy.x + enemy.width / 2 &&
                        bullet.y > enemy.y - enemy.height / 2 &&
                        bullet.y < enemy.y + enemy.height / 2
                    ) {
                        createExplosion(enemy.x, enemy.y, enemy.color);
                        playSound("explosion");
                        score += enemy.points;
                        shotsHit++;
                        updateUI();

                        bullets.splice(j, 1);
                        enemyHit = true;
                        break;
                    }
                }

                if (enemyHit) {
                    enemies.splice(i, 1);
                }
            }
        }

        function drawPlayer() {
            // Apply primary color from astro styles, we hardcoded fallback green
            ctx.fillStyle = player.color;
            ctx.beginPath();
            // Ship body (triangle)
            ctx.moveTo(player.x, player.y - player.height / 2);
            ctx.lineTo(
                player.x + player.width / 2,
                player.y + player.height / 2,
            );
            ctx.lineTo(
                player.x - player.width / 2,
                player.y + player.height / 2,
            );
            ctx.closePath();
            ctx.fill();

            // Ship core
            ctx.fillStyle = "#fff";
            ctx.fillRect(player.x - 4, player.y + player.height / 4, 8, 4);
        }

        function drawEnemies() {
            for (const enemy of enemies) {
                ctx.fillStyle = enemy.color;

                const w = enemy.width;
                const h = enemy.height;
                const x = enemy.x - w / 2;
                const y = enemy.y - h / 2;

                // Classic space invader simplified shape
                ctx.fillRect(x + w * 0.2, y, w * 0.6, h * 0.3); // Top
                ctx.fillRect(x, y + h * 0.3, w, h * 0.4); // Middle full
                ctx.fillRect(x, y + h * 0.7, w * 0.2, h * 0.3); // Left leg
                ctx.fillRect(x + w * 0.8, y + h * 0.7, w * 0.2, h * 0.3); // Right leg

                // Eyes (cutout)
                ctx.fillStyle = "#111"; // Same as background
                ctx.fillRect(x + w * 0.2, y + h * 0.4, w * 0.2, h * 0.2);
                ctx.fillRect(x + w * 0.6, y + h * 0.4, w * 0.2, h * 0.2);
            }
        }

        function drawBullets() {
            for (const bullet of bullets) {
                ctx.fillStyle = bullet.color;
                ctx.beginPath();
                ctx.arc(bullet.x, bullet.y, bullet.radius, 0, Math.PI * 2);
                ctx.fill();

                // Subtle glow
                ctx.shadowBlur = 5;
                ctx.shadowColor = bullet.color;
                ctx.fill();
                ctx.shadowBlur = 0;
            }
        }

        function drawParticles() {
            for (const p of particles) {
                ctx.fillStyle = p.color;
                ctx.globalAlpha = Math.max(0, 1 - p.life / p.maxLife);
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                ctx.fill();
            }
            ctx.globalAlpha = 1;
        }

        function draw() {
            ctx.fillStyle = "rgba(17, 17, 17, 0.4)"; // Motion blur effect over dark bg
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            drawStars();
            drawParticles();
            drawBullets();
            drawEnemies();
            drawPlayer();

            // Draw level text animation
            if (levelTextTimer > 0) {
                const alpha = Math.min(1, levelTextTimer / 500); // Fade out last 500ms
                const scale = 1 + (1 - levelTextTimer / LEVEL_TEXT_DURATION); // Slight grow

                ctx.save();
                ctx.globalAlpha = alpha;
                ctx.translate(canvas.width / 2, canvas.height / 2);
                ctx.scale(scale, scale);

                ctx.fillStyle = "#4ade80"; // var(--color-primary)
                ctx.font = "bold 48px monospace";
                ctx.textAlign = "center";
                ctx.textBaseline = "middle";
                ctx.fillText(`WAVE ${level}`, 0, 0);

                ctx.restore();
            }
        }

        // Starfield
        const stars = Array(70)
            .fill(0)
            .map(() => ({
                x: Math.random() * canvas.width,
                y: Math.random() * canvas.height,
                size: Math.random() * 1.5 + 0.5,
                speed: 0.2 + Math.random() * 0.8,
            }));

        function drawStars() {
            ctx.fillStyle = "#fff";
            for (const star of stars) {
                star.y += star.speed;
                if (star.y > canvas.height) {
                    star.y = 0;
                    star.x = Math.random() * canvas.width;
                }
                ctx.globalAlpha = 0.3 + Math.random() * 0.7;
                ctx.fillRect(star.x, star.y, star.size, star.size);
            }
            ctx.globalAlpha = 1;
        }

        function loop(timestamp: number) {
            if (!isPlaying) return;

            // Initial last time setup to avoid huge jump on first frame
            if (!lastTime) lastTime = timestamp;
            let dt = timestamp - lastTime;

            // Limit dt to max 30ms to prevent glitches if tab is inactive
            if (dt > 30) dt = 16.66;

            lastTime = timestamp;

            update(dt);
            draw();

            animationId = requestAnimationFrame(loop);
        }
    });
</script>
