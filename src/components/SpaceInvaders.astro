---
// SpaceInvaders.astro
---

<div id="space-invaders-container" class="easter-egg-container hidden">
    <div class="game-wrapper">
        <div class="game-header">
            <h2>Space Invaders</h2>
            <div class="game-stats">
                <span id="game-score">Score: 0</span>
                <span id="game-level">Level: 1</span>
                <span id="game-accuracy">Acc: 0%</span>
            </div>
            <button id="close-game" class="close-btn" aria-label="Close game"
                >✕</button
            >
        </div>
        <canvas id="game-canvas" width="800" height="600"></canvas>
        <div id="game-over-screen" class="overlay hidden">
            <h3>Game Over!</h3>
            <p>Score: <span id="final-score">0</span></p>
            <p>Level: <span id="final-level">1</span></p>
            <p>Accuracy: <span id="final-accuracy">0</span>%</p>
            <button id="restart-game" class="btn">Play Again</button>
        </div>
        <div id="start-screen" class="overlay">
            <h3>Ready to defend the galaxy?</h3>
            <p>Move with your mouse or finger.</p>
            <p>Click or hold to shoot.</p>
            <button id="start-game" class="btn">Start Game</button>
        </div>
    </div>
</div>

<style>
    .easter-egg-container {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.85);
        z-index: 9999;
        display: flex;
        justify-content: center;
        align-items: center;
        backdrop-filter: blur(5px);
    }
    .easter-egg-container.hidden {
        display: none;
    }
    .game-wrapper {
        position: relative;
        background: #111;
        border: 2px solid var(--color-primary);
        border-radius: var(--radius-lg);
        overflow: hidden;
        box-shadow: 0 0 30px rgba(var(--color-primary-rgb), 0.3);
        max-width: 100vw;
        max-height: 100vh;
    }
    .game-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: var(--space-4);
        padding: var(--space-4);
        background: #222;
        color: #fff;
        border-bottom: 2px solid var(--color-primary);
    }
    .game-header h2 {
        margin: 0;
        font-size: var(--text-lg);
        color: var(--color-primary);
        font-family: monospace;
        letter-spacing: 2px;
    }
    .game-stats {
        display: flex;
        gap: var(--space-6);
        font-family: monospace;
        font-size: var(--text-md);
    }
    .close-btn {
        background: none;
        border: none;
        color: #aaa;
        font-size: var(--text-xl);
        cursor: pointer;
        transition: color 0.2s;
        line-height: 1;
    }
    .close-btn:hover {
        color: #fff;
    }
    canvas {
        display: block;
        background: #000;
        cursor: crosshair;
        max-width: 100%;
        max-height: calc(100vh - 80px); /* header height approx */
        /* Le doigt pilote le vaisseau : pas de défilement ni de zoom sur le canvas */
        touch-action: none;
        user-select: none;
        -webkit-user-select: none;
    }
    .overlay {
        position: absolute;
        inset: 0;
        top: 60px; /* Below header */
        background: rgba(0, 0, 0, 0.8);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: white;
        text-align: center;
    }
    .overlay.hidden {
        display: none;
    }
    .overlay h3 {
        font-size: var(--text-3xl);
        color: var(--color-primary);
        margin-bottom: var(--space-4);
        font-family: monospace;
    }
    .overlay p {
        font-size: var(--text-lg);
        margin-bottom: var(--space-2);
        font-family: monospace;
    }
    .btn {
        margin-top: var(--space-6);
        background: var(--color-primary);
        color: white;
        border: none;
        padding: var(--space-3) var(--space-8);
        font-size: var(--text-lg);
        font-family: monospace;
        text-transform: uppercase;
        border-radius: var(--radius-sm);
        cursor: pointer;
        transition:
            transform 0.1s,
            filter 0.2s;
    }
    .btn:hover {
        filter: brightness(1.2);
        transform: scale(1.05);
    }
    .btn:active {
        transform: scale(0.95);
    }

    @media (max-width: 640px) {
        .game-header {
            padding: var(--space-2) var(--space-3);
        }
        .game-header h2 {
            display: none;
        }
        .game-stats {
            gap: var(--space-3);
            font-size: var(--text-sm);
        }
        .overlay {
            top: 44px;
        }
        .overlay h3 {
            font-size: var(--text-xl);
        }
        .overlay p {
            font-size: var(--text-sm);
        }
    }
</style>

<script>
    const container = document.getElementById("space-invaders-container");
    const closeBtn = document.getElementById("close-game");
    const startBtn = document.getElementById("start-game");
    const restartBtn = document.getElementById("restart-game");
    const canvas = document.getElementById("game-canvas") as HTMLCanvasElement;
    // Canvas opaque : le navigateur n'a pas à composer la transparence
    const ctx = canvas?.getContext("2d", { alpha: false });

    if (container && canvas && ctx) setup(container, canvas, ctx);

    function setup(
        container: HTMLElement,
        canvas: HTMLCanvasElement,
        ctx: CanvasRenderingContext2D,
    ) {
        // UI Elements
        const scoreEl = document.getElementById("game-score");
        const levelEl = document.getElementById("game-level");
        const finalScoreEl = document.getElementById("final-score");
        const finalLevelEl = document.getElementById("final-level");
        const accuracyEl = document.getElementById("game-accuracy");
        const finalAccuracyEl = document.getElementById("final-accuracy");
        const startScreen = document.getElementById("start-screen")!;
        const gameOverScreen = document.getElementById("game-over-screen")!;

        const W = canvas.width;
        const H = canvas.height;
        const FRAME = 1000 / 60; // durée de référence d'une frame (ms)
        const MAX_DT = 50; // au-delà (onglet en pause, lag), on ne rattrape pas

        // Game State
        let isPlaying = false;
        let score = 0;
        let level = 1;
        let animationId = 0;
        let lastTime = 0;
        let shotsFired = 0;
        let shotsHit = 0;
        let uiDirty = false;
        let levelTextTimer = 0;
        const LEVEL_TEXT_DURATION = 2000; // ms

        let cooldownTimer = 0;
        const COOLDOWN = 180; // ms
        const MAX_BULLETS = 6;
        let isShooting = false;

        // Simple Audio Synthesizer — créé au premier geste, pas au chargement de la page
        let audioCtx: AudioContext | null = null;

        function unlockAudio() {
            if (!audioCtx) {
                const Ctor =
                    window.AudioContext || (window as any).webkitAudioContext;
                if (!Ctor) return;
                audioCtx = new Ctor();
            }
            if (audioCtx.state === "suspended") audioCtx.resume();
        }

        function playSound(type: "shoot" | "explosion" | "victory") {
            if (!audioCtx || audioCtx.state !== "running") return;

            const oscillator = audioCtx.createOscillator();
            const gainNode = audioCtx.createGain();

            oscillator.connect(gainNode);
            gainNode.connect(audioCtx.destination);

            const now = audioCtx.currentTime;

            if (type === "shoot") {
                // Short high-pitched pew
                oscillator.type = "square";
                oscillator.frequency.setValueAtTime(800, now);
                oscillator.frequency.exponentialRampToValueAtTime(
                    300,
                    now + 0.1,
                );

                gainNode.gain.setValueAtTime(0.05, now); // Low volume
                gainNode.gain.exponentialRampToValueAtTime(0.01, now + 0.1);

                oscillator.start(now);
                oscillator.stop(now + 0.1);
            } else if (type === "explosion") {
                // Lower pitched, noisy boom
                oscillator.type = "sawtooth";
                oscillator.frequency.setValueAtTime(200, now);
                oscillator.frequency.exponentialRampToValueAtTime(
                    50,
                    now + 0.2,
                );

                gainNode.gain.setValueAtTime(0.1, now);
                gainNode.gain.exponentialRampToValueAtTime(0.01, now + 0.2);

                oscillator.start(now);
                oscillator.stop(now + 0.2);
            } else if (type === "victory") {
                // Happy ascending chime
                oscillator.type = "sine";

                // C major arpeggio very fast
                oscillator.frequency.setValueAtTime(523.25, now); // C5
                oscillator.frequency.setValueAtTime(659.25, now + 0.1); // E5
                oscillator.frequency.setValueAtTime(783.99, now + 0.2); // G5
                oscillator.frequency.setValueAtTime(1046.5, now + 0.3); // C6

                gainNode.gain.setValueAtTime(0.1, now);
                gainNode.gain.linearRampToValueAtTime(0.01, now + 0.5);

                oscillator.start(now);
                oscillator.stop(now + 0.5);
            }

            // Libère les nœuds audio une fois le son terminé
            oscillator.onended = () => {
                oscillator.disconnect();
                gainNode.disconnect();
            };
        }

        // Entities
        const player = {
            x: W / 2,
            y: H - 40,
            width: 40,
            height: 20,
            color: "#4ade80", // bright green approx
        };

        type Bullet = { x: number; y: number; speed: number };
        type Enemy = {
            x: number;
            y: number;
            width: number;
            height: number;
            speed: number;
            sprite: HTMLCanvasElement;
            color: string;
            points: number;
        };
        type Particle = {
            x: number;
            y: number;
            vx: number;
            vy: number;
            life: number;
            maxLife: number;
            color: string;
            size: number;
        };

        let bullets: Bullet[] = [];
        let enemies: Enemy[] = [];
        let particles: Particle[] = [];
        const MAX_PARTICLES = 300;

        let enemyDirection = 1; // 1 right, -1 left
        let enemySpeedMultiplier = 1;

        // Sprites pré-rendus : un drawImage par entité au lieu de plusieurs tracés
        const ENEMY_W = 30;
        const ENEMY_H = 20;

        function makeEnemySprite(color: string) {
            const c = document.createElement("canvas");
            c.width = ENEMY_W;
            c.height = ENEMY_H;
            const g = c.getContext("2d")!;
            const w = ENEMY_W;
            const h = ENEMY_H;

            // Classic space invader simplified shape
            g.fillStyle = color;
            g.fillRect(w * 0.2, 0, w * 0.6, h * 0.3); // Top
            g.fillRect(0, h * 0.3, w, h * 0.4); // Middle full
            g.fillRect(0, h * 0.7, w * 0.2, h * 0.3); // Left leg
            g.fillRect(w * 0.8, h * 0.7, w * 0.2, h * 0.3); // Right leg

            // Eyes (cutout)
            g.fillStyle = "#111"; // Same as background
            g.fillRect(w * 0.2, h * 0.4, w * 0.2, h * 0.2);
            g.fillRect(w * 0.6, h * 0.4, w * 0.2, h * 0.2);
            return c;
        }

        // Balle avec halo, rendue une seule fois (shadowBlur est très coûteux par frame)
        const BULLET_SPRITE_SIZE = 16;
        const bulletSprite = (() => {
            const c = document.createElement("canvas");
            c.width = c.height = BULLET_SPRITE_SIZE;
            const g = c.getContext("2d")!;
            const r = BULLET_SPRITE_SIZE / 2;
            g.shadowBlur = 5;
            g.shadowColor = "#fff";
            g.fillStyle = "#fff";
            g.beginPath();
            g.arc(r, r, 3, 0, Math.PI * 2);
            g.fill();
            g.fill();
            return c;
        })();

        const ENEMY_TYPES = [
            { color: "#f87171", points: 30 }, // Top row red
            { color: "#fbbf24", points: 20 }, // Yellow
            { color: "#60a5fa", points: 10 }, // Blue
        ].map((t) => ({ ...t, sprite: makeEnemySprite(t.color) }));

        // Input
        let pointerX = player.x;

        function setPointerX(clientX: number) {
            const rect = canvas.getBoundingClientRect();
            // Scale pointer coordinates to match canvas internal resolution
            const x = (clientX - rect.left) * (W / rect.width);
            pointerX = Math.max(
                player.width / 2,
                Math.min(W - player.width / 2, x),
            );
        }

        // Custom event from Footer
        document.addEventListener("open-easter-egg", () => {
            document.dispatchEvent(
                new CustomEvent("secret-found", { detail: "invaders" }),
            );
            container.classList.remove("hidden");
            startScreen.classList.remove("hidden");
            gameOverScreen.classList.add("hidden");
            initGame();
        });

        closeBtn?.addEventListener("click", () => {
            container.classList.add("hidden");
            stopGame();
            audioCtx?.suspend();
        });

        startBtn?.addEventListener("click", () => {
            unlockAudio();
            startScreen.classList.add("hidden");
            startGame();
        });

        restartBtn?.addEventListener("click", () => {
            unlockAudio();
            gameOverScreen.classList.add("hidden");
            initGame();
            startGame();
        });

        // Pointer events : souris, doigt et stylet avec le même code
        canvas.addEventListener("pointermove", (e) => {
            if (!isPlaying) return;
            setPointerX(e.clientX);
        });

        canvas.addEventListener("pointerdown", (e) => {
            if (!isPlaying) return;
            unlockAudio();
            setPointerX(e.clientX);
            canvas.setPointerCapture(e.pointerId);

            // Fire instantly on first press if ready
            if (cooldownTimer <= 0) {
                shoot();
            }
            isShooting = true;
        });

        const stopShooting = () => {
            isShooting = false;
        };
        canvas.addEventListener("pointerup", stopShooting);
        canvas.addEventListener("pointercancel", stopShooting);
        canvas.addEventListener("contextmenu", (e) => e.preventDefault());

        // Pause automatique quand l'onglet est masqué, reprise au retour
        let pausedByVisibility = false;
        document.addEventListener("visibilitychange", () => {
            if (document.hidden && isPlaying) {
                pausedByVisibility = true;
                stopGame();
            } else if (!document.hidden && pausedByVisibility) {
                pausedByVisibility = false;
                if (!container.classList.contains("hidden")) startGame();
            }
        });

        function initLevel() {
            enemies = [];
            bullets = [];
            particles = [];
            enemyDirection = 1;
            enemySpeedMultiplier = 1 + level * 0.15;

            const rows = 3 + Math.min(Math.floor(level / 2), 4);
            const cols = 8 + Math.min(Math.floor(level / 3), 4);

            const paddingX = 60;
            const paddingY = 40;
            const startX = (W - cols * paddingX) / 2 + 30; // Center formation
            const startY = 60;

            for (let r = 0; r < rows; r++) {
                const type = ENEMY_TYPES[Math.min(r, ENEMY_TYPES.length - 1)];
                for (let c = 0; c < cols; c++) {
                    enemies.push({
                        x: startX + c * paddingX,
                        y: startY + r * paddingY,
                        width: ENEMY_W,
                        height: ENEMY_H,
                        speed: 1.0,
                        sprite: type.sprite,
                        color: type.color,
                        points: type.points,
                    });
                }
            }
        }

        function initGame() {
            score = 0;
            level = 1;
            shotsFired = 0;
            shotsHit = 0;
            levelTextTimer = 0;
            cooldownTimer = 0;
            isShooting = false;
            updateUI();
            initLevel();
            player.x = W / 2;
            pointerX = player.x;
            ctx.fillStyle = "#111";
            ctx.fillRect(0, 0, W, H);
            draw();
        }

        function startGame() {
            if (isPlaying) return;
            isPlaying = true;
            lastTime = 0;
            animationId = requestAnimationFrame(loop);
        }

        function stopGame() {
            isPlaying = false;
            isShooting = false;
            cancelAnimationFrame(animationId);
        }

        function getAccuracy() {
            return shotsFired > 0
                ? Math.round((shotsHit / shotsFired) * 100)
                : 0;
        }

        function gameOver() {
            stopGame();
            updateUI();
            const accuracy = getAccuracy();
            if (finalScoreEl) finalScoreEl.textContent = score.toString();
            if (finalLevelEl) finalLevelEl.textContent = level.toString();
            if (finalAccuracyEl)
                finalAccuracyEl.textContent = accuracy.toString();
            gameOverScreen.classList.remove("hidden");
        }

        function nextLevel() {
            level++;
            levelTextTimer = LEVEL_TEXT_DURATION;
            playSound("victory");
            uiDirty = true;
            initLevel();
        }

        // Écritures DOM regroupées : au plus une fois par frame
        function updateUI() {
            uiDirty = false;
            if (scoreEl) scoreEl.textContent = `Score: ${score}`;
            if (levelEl) levelEl.textContent = `Level: ${level}`;
            if (accuracyEl) accuracyEl.textContent = `Acc: ${getAccuracy()}%`;
        }

        function shoot() {
            if (bullets.length >= MAX_BULLETS) return;

            cooldownTimer = COOLDOWN;
            shotsFired++;
            uiDirty = true;

            bullets.push({
                x: player.x,
                y: player.y - player.height,
                speed: 10,
            });
            playSound("shoot");
        }

        function createExplosion(x: number, y: number, color: string) {
            const count = Math.min(15, MAX_PARTICLES - particles.length);
            for (let i = 0; i < count; i++) {
                const angle = Math.random() * Math.PI * 2;
                const speed = 1 + Math.random() * 4;
                particles.push({
                    x,
                    y,
                    vx: Math.cos(angle) * speed,
                    vy: Math.sin(angle) * speed,
                    life: 0,
                    maxLife: 20 + Math.random() * 20,
                    color,
                    size: 2 + Math.random() * 3,
                });
            }
        }

        function update(dt: number) {
            const timeScale = dt / FRAME;

            if (levelTextTimer > 0) levelTextTimer -= dt;
            if (cooldownTimer > 0) cooldownTimer -= dt;

            // Handle continuous shooting while the pointer is held down
            if (isShooting && cooldownTimer <= 0) {
                shoot();
            }

            // Lissage du mouvement du joueur, indépendant du framerate
            player.x += (pointerX - player.x) * (1 - Math.pow(0.7, timeScale));

            // Update bullets (compaction en place, sans splice)
            let n = 0;
            for (const b of bullets) {
                b.y -= b.speed * timeScale;
                if (b.y >= 0) bullets[n++] = b;
            }
            bullets.length = n;

            // Update particles
            n = 0;
            for (const p of particles) {
                p.x += p.vx * timeScale;
                p.y += p.vy * timeScale;
                p.life += timeScale;
                if (p.life < p.maxLife) particles[n++] = p;
            }
            particles.length = n;

            updateStars(timeScale);

            // Update enemies
            if (enemies.length === 0) {
                nextLevel();
                return;
            }

            let minX = Infinity;
            let maxX = -Infinity;
            for (const enemy of enemies) {
                if (enemy.x < minX) minX = enemy.x;
                if (enemy.x > maxX) maxX = enemy.x;
            }
            const hitEdge =
                maxX + ENEMY_W / 2 > W - 20 || minX - ENEMY_W / 2 < 20;

            if (hitEdge) {
                enemyDirection *= -1;
                // Move down
                for (const enemy of enemies) {
                    enemy.y += 20;
                    // Clamp inside bounds
                    enemy.x = Math.max(
                        enemy.width / 2 + 20,
                        Math.min(W - enemy.width / 2 - 20, enemy.x),
                    );

                    if (enemy.y + enemy.height > player.y - 40) {
                        // Gave a little grace area
                        gameOver();
                        return;
                    }
                }
            }

            const dx = enemyDirection * enemySpeedMultiplier * timeScale;
            for (const enemy of enemies) {
                enemy.x += enemy.speed * dx;
            }

            // Collision detection
            if (bullets.length > 0) {
                n = 0;
                for (const enemy of enemies) {
                    let enemyHit = false;
                    const hw = enemy.width / 2;
                    const hh = enemy.height / 2;

                    for (let j = bullets.length - 1; j >= 0; j--) {
                        const bullet = bullets[j];

                        if (
                            bullet.x > enemy.x - hw &&
                            bullet.x < enemy.x + hw &&
                            bullet.y > enemy.y - hh &&
                            bullet.y < enemy.y + hh
                        ) {
                            createExplosion(enemy.x, enemy.y, enemy.color);
                            playSound("explosion");
                            score += enemy.points;
                            shotsHit++;
                            uiDirty = true;

                            bullets[j] = bullets[bullets.length - 1];
                            bullets.pop();
                            enemyHit = true;
                            break;
                        }
                    }

                    if (!enemyHit) enemies[n++] = enemy;
                }
                enemies.length = n;
            }
        }

        function drawPlayer() {
            ctx.fillStyle = player.color;
            ctx.beginPath();
            // Ship body (triangle)
            ctx.moveTo(player.x, player.y - player.height / 2);
            ctx.lineTo(
                player.x + player.width / 2,
                player.y + player.height / 2,
            );
            ctx.lineTo(
                player.x - player.width / 2,
                player.y + player.height / 2,
            );
            ctx.closePath();
            ctx.fill();

            // Ship core
            ctx.fillStyle = "#fff";
            ctx.fillRect(player.x - 4, player.y + player.height / 4, 8, 4);
        }

        function drawEnemies() {
            for (const enemy of enemies) {
                ctx.drawImage(
                    enemy.sprite,
                    (enemy.x - ENEMY_W / 2) | 0,
                    (enemy.y - ENEMY_H / 2) | 0,
                );
            }
        }

        function drawBullets() {
            const half = BULLET_SPRITE_SIZE / 2;
            for (const bullet of bullets) {
                ctx.drawImage(
                    bulletSprite,
                    (bullet.x - half) | 0,
                    (bullet.y - half) | 0,
                );
            }
        }

        function drawParticles() {
            // Carrés plutôt que des arcs : beaucoup moins coûteux, rendu identique à cette taille
            for (const p of particles) {
                ctx.fillStyle = p.color;
                ctx.globalAlpha = 1 - p.life / p.maxLife;
                ctx.fillRect(p.x - p.size / 2, p.y - p.size / 2, p.size, p.size);
            }
            ctx.globalAlpha = 1;
        }

        function draw() {
            ctx.fillStyle = "rgba(17, 17, 17, 0.4)"; // Motion blur effect over dark bg
            ctx.fillRect(0, 0, W, H);

            drawStars();
            drawParticles();
            drawBullets();
            drawEnemies();
            drawPlayer();

            // Draw level text animation
            if (levelTextTimer > 0) {
                const alpha = Math.min(1, levelTextTimer / 500); // Fade out last 500ms
                const scale = 1 + (1 - levelTextTimer / LEVEL_TEXT_DURATION); // Slight grow

                ctx.save();
                ctx.globalAlpha = alpha;
                ctx.translate(W / 2, H / 2);
                ctx.scale(scale, scale);

                ctx.fillStyle = "#4ade80"; // var(--color-primary)
                ctx.font = "bold 48px monospace";
                ctx.textAlign = "center";
                ctx.textBaseline = "middle";
                ctx.fillText(`WAVE ${level}`, 0, 0);

                ctx.restore();
            }
        }

        // Starfield, répartie en quelques niveaux d'opacité pour limiter les changements d'état
        const STAR_LAYERS = [0.35, 0.6, 0.9];
        const stars = Array.from({ length: 70 }, (_, i) => ({
            x: Math.random() * W,
            y: Math.random() * H,
            size: Math.random() * 1.5 + 0.5,
            speed: 0.2 + Math.random() * 0.8,
            layer: i % STAR_LAYERS.length,
        }));

        function updateStars(timeScale: number) {
            for (const star of stars) {
                star.y += star.speed * timeScale;
                if (star.y > H) {
                    star.y = 0;
                    star.x = Math.random() * W;
                }
            }
        }

        function drawStars() {
            ctx.fillStyle = "#fff";
            for (let l = 0; l < STAR_LAYERS.length; l++) {
                // Léger scintillement par couche plutôt que par étoile
                ctx.globalAlpha = STAR_LAYERS[l] * (0.8 + Math.random() * 0.2);
                for (const star of stars) {
                    if (star.layer === l) {
                        ctx.fillRect(star.x, star.y, star.size, star.size);
                    }
                }
            }
            ctx.globalAlpha = 1;
        }

        function loop(timestamp: number) {
            if (!isPlaying) return;

            // Initial last time setup to avoid huge jump on first frame
            if (!lastTime) lastTime = timestamp;
            const dt = Math.min(timestamp - lastTime, MAX_DT);
            lastTime = timestamp;

            update(dt);
            if (!isPlaying) return; // game over pendant l'update

            draw();
            if (uiDirty) updateUI();

            animationId = requestAnimationFrame(loop);
        }
    }
</script>
