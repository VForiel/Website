---
// src/components/PoppyEasterEgg.astro
// Easter Egg poétique combinant la mise au point optique (TDAH) et la Constellation Poppy (Philippine)

interface Props {
    lang?: string;
}

const { lang = "fr" } = Astro.props;
const isEn = lang === "en";
---

<div
    id="poppy-easter-egg"
    class="poppy-egg-overlay"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
>
    <!-- Canvas pour l'animation des étoiles, de la collimation et de la constellation -->
    <canvas id="poppy-canvas" class="poppy-canvas"></canvas>

    <!-- Bouton de fermeture supérieur -->
    <button
        id="poppy-close-btn"
        class="poppy-close-btn"
        aria-label={isEn ? "Close easter egg" : "Fermer l'easter egg"}
        title={isEn ? "Close (Esc)" : "Fermer (Échap)"}
    >
        ✕
    </button>

    <!-- Télémétrie optique / HUD en haut -->
    <div class="poppy-hud" id="poppy-hud" aria-live="polite">
        <span class="poppy-hud-pulse">●</span>
        <span id="poppy-hud-text" class="poppy-hud-text">
            {
                isEn
                    ? "[ACT 1/3] BEAM SCATTERING — ADHD SPECTRUM"
                    : "[ACTE 1/3] DISPERSION DU FAISCEAU — SPECTRE TDAH"
            }
        </span>
    </div>

    <!-- Carte du message personnel (apparaît à l'acte 3) -->
    <div class="poppy-card-wrapper" id="poppy-card-wrapper">
        <div class="poppy-card">
            <div class="poppy-card-header">
                <span class="poppy-badge">
                    <span class="poppy-badge-dot">✦</span>
                    <span class="poppy-badge-label">
                        {
                            isEn
                                ? "Constellation of Poppy — α-0306"
                                : "Constellation de Poppy — α-0306"
                        }
                    </span>
                </span>
                <span class="poppy-card-coords">α: 19h 25m | δ: +42° 18'</span>
            </div>

            <h2 class="poppy-card-title">
                {
                    isEn
                        ? "A Constellation for Poppy ✦"
                        : "Une constellation pour Poppy ✦"
                }
            </h2>

            <div class="poppy-card-body">
                <p class="poppy-text-main">
                    {
                        isEn
                            ? "This Easter egg is dedicated to my dearest Philippine (Poppy), who spends her days soothing the world of the little ones and brought order back into mine. 💖"
                            : "Cet œuf de Pâques est destiné à ma chère et tendre Philippine (Poppy), qui passe ses journées à apaiser le monde des plus petits et qui a remis de l'ordre dans le mien. 💖"
                    }
                </p>
                <p class="poppy-text-dedication">
                    {
                        isEn
                            ? "Her kindness, empathy, curiosity, open-mindedness, and all the other qualities she brings together truly deserve a constellation in her honor. 🌹"
                            : "Sa bienveillance, son empathie, sa curiosité, son ouverture d'esprit et toutes les autres qualités qu'elle réunit méritent bien une constellation en son honneur. 🌹"
                    }
                </p>
            </div>

            <div class="poppy-card-footer">
                <span class="poppy-status-tag">
                    <span class="tag-bullet">✓</span>
                    {
                        isEn
                            ? "Wavefront calibrated • Optimal focus"
                            : "Front d'onde calibré • Focale optimale"
                    }
                </span>
                <button
                    type="button"
                    id="poppy-dismiss-btn"
                    class="poppy-btn-dismiss"
                >
                    {isEn ? "Close (Esc)" : "Fermer (Échap)"}
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .poppy-egg-overlay {
        position: fixed;
        inset: 0;
        z-index: 99999;
        background-color: rgba(10, 14, 23, 0.94);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-items: center;
        overflow: hidden;
    }

    .poppy-egg-overlay.is-active {
        opacity: 1;
        pointer-events: auto;
    }

    .poppy-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
        z-index: 1;
        cursor: crosshair;
    }

    /* Bouton fermer en haut à droite */
    .poppy-close-btn {
        position: absolute;
        top: var(--space-4, 1rem);
        right: var(--space-4, 1rem);
        z-index: 10;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: var(--color-neutral-300, #cbd5e1);
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        cursor: pointer;
        transition:
            background 0.2s ease,
            border-color 0.2s ease,
            color 0.2s ease,
            transform 0.2s ease;
    }

    .poppy-close-btn:hover {
        background: rgba(255, 77, 109, 0.2);
        border-color: rgba(255, 77, 109, 0.5);
        color: #fff;
        transform: rotate(90deg);
    }

    /* HUD télémétrie en haut */
    .poppy-hud {
        position: absolute;
        top: var(--space-4, 1rem);
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
        display: flex;
        align-items: center;
        gap: var(--space-2, 0.5rem);
        background: rgba(15, 23, 42, 0.7);
        border: 1px solid rgba(255, 183, 3, 0.25);
        border-radius: 9999px;
        padding: 0.35rem 0.9rem;
        font-family: monospace;
        font-size: var(--text-xs, 0.75rem);
        letter-spacing: 0.08em;
        color: var(--color-accent, hsl(35, 85%, 65%));
        box-shadow: 0 0 15px rgba(255, 183, 3, 0.15);
        pointer-events: none;
        transition:
            border-color 0.4s ease,
            color 0.4s ease;
    }

    .poppy-hud-pulse {
        color: #ff4d6d;
        font-size: 0.65rem;
        animation: hudBlink 1.2s infinite ease-in-out;
    }

    @keyframes hudBlink {
        0%,
        100% {
            opacity: 1;
            transform: scale(1);
        }
        50% {
            opacity: 0.3;
            transform: scale(0.8);
        }
    }

    /* Conteneur de la carte de message */
    .poppy-card-wrapper {
        position: relative;
        z-index: 10;
        width: 100%;
        max-width: 38rem;
        padding: var(--space-4, 1rem);
        margin-bottom: var(--space-6, 1.5rem);
        opacity: 0;
        transform: translateY(24px);
        transition:
            opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
            transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        pointer-events: none;
    }

    .poppy-card-wrapper.is-visible {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
    }

    .poppy-card {
        background: linear-gradient(
            145deg,
            rgba(18, 24, 42, 0.38) 0%,
            rgba(12, 16, 28, 0.48) 100%
        );
        border: 1px solid rgba(255, 183, 3, 0.32);
        border-radius: var(--radius-lg, 0.75rem);
        padding: var(--space-6, 1.5rem);
        box-shadow:
            0 8px 32px rgba(0, 0, 0, 0.5),
            0 0 25px rgba(255, 77, 109, 0.15),
            inset 0 0 25px rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        position: relative;
        overflow: hidden;
    }

    .poppy-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(
            90deg,
            transparent,
            rgba(255, 77, 109, 0.8) 30%,
            rgba(255, 183, 3, 0.9) 70%,
            transparent
        );
    }

    .poppy-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: var(--space-2, 0.5rem);
        margin-bottom: var(--space-3, 0.75rem);
        flex-wrap: wrap;
    }

    .poppy-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: rgba(255, 77, 109, 0.12);
        border: 1px solid rgba(255, 77, 109, 0.3);
        border-radius: 9999px;
        padding: 0.2rem 0.65rem;
        font-size: 0.7rem;
        font-weight: 500;
        color: #ff758f;
        letter-spacing: 0.03em;
    }

    .poppy-badge-dot {
        color: var(--color-accent, hsl(35, 85%, 65%));
    }

    .poppy-card-coords {
        font-family: monospace;
        font-size: 0.7rem;
        color: var(--color-text-muted, hsl(220, 6%, 50%));
        letter-spacing: 0.05em;
    }

    .poppy-card-title {
        font-size: var(--text-xl, 1.333rem);
        font-weight: 600;
        color: #fff;
        margin: 0 0 var(--space-3, 0.75rem) 0;
        background: linear-gradient(120deg, #ffffff 40%, #ffccd5 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .poppy-card-body {
        margin-bottom: var(--space-5, 1.25rem);
        display: flex;
        flex-direction: column;
        gap: var(--space-2, 0.5rem);
    }

    .poppy-text-main {
        font-size: var(--text-base, 1rem);
        line-height: 1.6;
        color: var(--color-neutral-100, #f1f5f9);
        margin: 0;
        font-weight: 400;
        text-shadow: 0 2px 6px rgba(0, 0, 0, 0.9);
    }

    .poppy-text-dedication {
        font-size: var(--text-sm, 0.875rem);
        line-height: 1.5;
        color: var(--color-text-secondary, hsl(220, 8%, 68%));
        margin: var(--space-2, 0.5rem) 0 0 0;
        padding-top: var(--space-2, 0.5rem);
        border-top: 1px dashed rgba(255, 255, 255, 0.15);
        text-shadow: 0 2px 6px rgba(0, 0, 0, 0.9);
    }

    .poppy-heart {
        display: inline-block;
        animation: heartPulse 1.8s infinite ease-in-out;
        transform-origin: center;
        margin-left: 0.2rem;
    }

    @keyframes heartPulse {
        0%,
        100% {
            transform: scale(1);
        }
        25% {
            transform: scale(1.2);
        }
        40% {
            transform: scale(1);
        }
        60% {
            transform: scale(1.15);
        }
    }

    .poppy-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: var(--space-3, 0.75rem);
        flex-wrap: wrap;
        padding-top: var(--space-3, 0.75rem);
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .poppy-status-tag {
        font-size: 0.75rem;
        color: #70e000;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-family: monospace;
    }

    .tag-bullet {
        font-weight: bold;
    }

    .poppy-btn-dismiss {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.18);
        color: #fff;
        padding: 0.35rem 0.85rem;
        border-radius: var(--radius-md, 0.5rem);
        font-size: 0.8rem;
        cursor: pointer;
        transition:
            background 0.2s ease,
            border-color 0.2s ease;
    }

    .poppy-btn-dismiss:hover {
        background: rgba(255, 77, 109, 0.25);
        border-color: rgba(255, 77, 109, 0.6);
    }

    @media (max-width: 640px) {
        .poppy-card {
            padding: var(--space-4, 1rem);
        }
        .poppy-card-title {
            font-size: 1.15rem;
        }
        .poppy-text-main {
            font-size: 0.9rem;
        }
        .poppy-card-footer {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<script>
    // Logique interactive et physique de l'Easter Egg "Poppy"
    interface StarNode {
        x: number;
        y: number;
        vx: number;
        vy: number;
        startX?: number;
        startY?: number;
        targetX: number;
        targetY: number;
        size: number;
        color: string;
        glowColor: string;
        isConstellation: boolean;
        constellationIndex?: number;
        name?: string;
        pulsePhase: number;
    }

    interface ConstellationLine {
        from: number;
        to: number;
        type: "petal" | "stem" | "leaf" | "cross";
    }

    class PoppyEasterEggController {
        private overlay: HTMLElement | null = null;
        private canvas: HTMLCanvasElement | null = null;
        private ctx: CanvasRenderingContext2D | null = null;
        private hudText: HTMLElement | null = null;
        private cardWrapper: HTMLElement | null = null;
        private closeBtn: HTMLElement | null = null;
        private dismissBtn: HTMLElement | null = null;

        private isOpen = false;
        private animId = 0;
        private startTime = 0;
        private width = 0;
        private height = 0;
        private dpr = 1;

        private stars: StarNode[] = [];
        private lines: ConstellationLine[] = [];
        private keyBuffer = "";
        private isEnglish = false;
        private bgClickTimestamps: number[] = [];

        // Gestion des 3 actes
        private currentAct: 1 | 2 | 3 = 1;
        private act1StartTime = 0;
        private act1ScanDuration = 2800; // 2.8 secondes d'analyse du bruit avant d'autoriser le clic
        private act2StartTime = 0;
        private act3StartTime = 0;
        private act2Duration = 4800; // 4.8 secondes pour un chargement optique ralenti et immersif

        // Position de la constellation (centre géométrique)
        private cx = 0;
        private cy = 0;
        private scale = 1;

        constructor() {
            this.initElements();
            this.initTriggers();
            this.initConstellationTopology();
        }

        private initElements() {
            this.overlay = document.getElementById("poppy-easter-egg");
            this.canvas = document.getElementById(
                "poppy-canvas",
            ) as HTMLCanvasElement;
            if (this.canvas) {
                this.ctx = this.canvas.getContext("2d");
            }
            this.hudText = document.getElementById("poppy-hud-text");
            this.cardWrapper = document.getElementById("poppy-card-wrapper");
            this.closeBtn = document.getElementById("poppy-close-btn");
            this.dismissBtn = document.getElementById("poppy-dismiss-btn");

            this.isEnglish = document.documentElement.lang === "en";

            this.closeBtn?.addEventListener("click", () => this.close());
            this.dismissBtn?.addEventListener("click", () => this.close());

            // Attendre un clic/toucher sur l'écran pendant l'Acte 1, APRÈS la fin de l'analyse du bruit
            this.overlay?.addEventListener("pointerdown", (e) => {
                if (!this.isOpen || this.currentAct !== 1) return;

                const target = e.target as HTMLElement | null;
                if (
                    target &&
                    (target.closest("#poppy-close-btn") ||
                        target.closest("#poppy-dismiss-btn"))
                ) {
                    return;
                }

                const now = performance.now();
                // N'autoriser le clic qu'une fois la progression de l'analyse terminée (2.8s)
                if (now - this.act1StartTime < this.act1ScanDuration) return;

                this.startAct2();
            });

            window.addEventListener("resize", () => {
                if (this.isOpen) {
                    this.resize();
                    this.updateConstellationTargets();
                }
            });
        }

        private startAct2() {
            if (this.currentAct !== 1) return;
            this.currentAct = 2;
            this.act2StartTime = performance.now();

            // Mémoriser la position exacte de départ de chaque étoile pour une progression continue sur 4.8s
            this.stars.forEach((star) => {
                star.startX = star.x;
                star.startY = star.y;
            });
        }

        private initTriggers() {
            // 1. Déclencheur Clavier : taper 'poppy' n'importe où
            window.addEventListener("keydown", (e) => {
                const target = e.target as HTMLElement;
                const tag = target?.tagName?.toLowerCase();
                if (
                    tag === "input" ||
                    tag === "textarea" ||
                    target?.isContentEditable
                ) {
                    return;
                }

                if (e.key === "Escape" && this.isOpen) {
                    this.close();
                    return;
                }

                this.keyBuffer = (this.keyBuffer + e.key.toLowerCase()).slice(
                    -8,
                );
                if (this.keyBuffer.includes("poppy")) {
                    this.keyBuffer = "";
                    this.open();
                }
            });

            // 2. Déclencheur URL : #poppy ou ?poppy dans la barre d'adresse
            const checkUrlTrigger = () => {
                const hash = window.location.hash.toLowerCase();
                const search = window.location.search.toLowerCase();
                if (hash.includes("poppy") || search.includes("poppy")) {
                    // Délai doux de 1.2s pour laisser la page se charger avant la surprise
                    setTimeout(() => {
                        this.open();
                    }, 1200);
                }
            };
            checkUrlTrigger();
            window.addEventListener("hashchange", checkUrlTrigger);

            // 3. Déclencheur Souris/Tactile : 10 clics en moins de 3 secondes sur le fond du site
            window.addEventListener("pointerdown", (e) => {
                if (this.isOpen) return;

                const target = e.target as HTMLElement | null;
                if (!target) return;

                // Ignorer les clics sur les éléments interactifs (liens, boutons, inputs, etc.)
                const isInteractive = Boolean(
                    target.closest(
                        "a, button, input, textarea, select, [role='button'], nav, .header, #polaris-modal",
                    ),
                );
                if (isInteractive) return;

                const now = performance.now();
                this.bgClickTimestamps.push(now);

                // Ne conserver que les clics effectués dans la fenêtre glissante des 3000ms
                this.bgClickTimestamps = this.bgClickTimestamps.filter(
                    (t) => now - t <= 3000,
                );

                if (this.bgClickTimestamps.length >= 10) {
                    this.bgClickTimestamps = [];
                    this.open();
                }
            });

            // 4. Événement custom (pour compatibilité ou tests)
            window.addEventListener("trigger-poppy-easter-egg", () => {
                this.open();
            });
        }

        private initConstellationTopology() {
            // Définition des connexions de la Constellation Poppy
            // 0: Cœur, 1..3: Pétale haut, 4..6: Pétale gauche, 7..9: Pétale droit, 10..12: Pétale bas, 13..15: Tige, 16: Feuille
            this.lines = [
                // Pétale haut
                { from: 0, to: 2, type: "petal" },
                { from: 2, to: 1, type: "petal" },
                { from: 1, to: 3, type: "petal" },
                { from: 3, to: 0, type: "petal" },

                // Pétale gauche
                { from: 0, to: 5, type: "petal" },
                { from: 5, to: 4, type: "petal" },
                { from: 4, to: 6, type: "petal" },
                { from: 6, to: 0, type: "petal" },

                // Pétale droit
                { from: 0, to: 8, type: "petal" },
                { from: 8, to: 7, type: "petal" },
                { from: 7, to: 9, type: "petal" },
                { from: 9, to: 0, type: "petal" },

                // Pétale bas
                { from: 0, to: 11, type: "petal" },
                { from: 11, to: 10, type: "petal" },
                { from: 10, to: 12, type: "petal" },
                { from: 12, to: 0, type: "petal" },

                // Liens inter-pétales (astronomique)
                { from: 2, to: 5, type: "cross" },
                { from: 3, to: 8, type: "cross" },

                // Tige
                { from: 0, to: 13, type: "stem" },
                { from: 13, to: 14, type: "stem" },
                { from: 14, to: 15, type: "stem" },

                // Feuille
                { from: 14, to: 16, type: "leaf" },
            ];
        }

        private resize() {
            if (!this.canvas) return;
            this.dpr = Math.min(window.devicePixelRatio || 1, 2);
            this.width = window.innerWidth;
            this.height = window.innerHeight;

            this.canvas.width = this.width * this.dpr;
            this.canvas.height = this.height * this.dpr;

            if (this.ctx) {
                this.ctx.setTransform(1, 0, 0, 1, 0, 0);
                this.ctx.scale(this.dpr, this.dpr);
            }

            // Calcul du centre de la constellation
            this.cx = this.width / 2;
            const isSmall = this.width < 768;
            this.cy = isSmall ? this.height * 0.32 : this.height * 0.36;
            this.scale = isSmall
                ? Math.min(this.width * 0.38, 140)
                : Math.min(this.width * 0.25, this.height * 0.3, 210);
        }

        private getNormalizedConstellationCoordinates(): {
            x: number;
            y: number;
            color: string;
            glow: string;
            size: number;
            name: string;
        }[] {
            return [
                // 0: Cœur (Pistil / Veilleuse)
                {
                    x: 0,
                    y: 0,
                    color: "#ff4d6d",
                    glow: "rgba(255, 77, 109, 0.9)",
                    size: 5.5,
                    name: "α-Poppis (Le Cœur)",
                },
                // Pétale haut
                {
                    x: 0,
                    y: -0.78,
                    color: "#ffd166",
                    glow: "rgba(255, 209, 102, 0.8)",
                    size: 4.2,
                    name: "β-Clarté",
                },
                {
                    x: -0.34,
                    y: -0.52,
                    color: "#ffb703",
                    glow: "rgba(255, 183, 3, 0.7)",
                    size: 3.5,
                    name: "δ-Focale",
                },
                {
                    x: 0.34,
                    y: -0.52,
                    color: "#ffb703",
                    glow: "rgba(255, 183, 3, 0.7)",
                    size: 3.5,
                    name: "ε-Lumière",
                },
                // Pétale gauche
                {
                    x: -0.74,
                    y: -0.06,
                    color: "#ff758f",
                    glow: "rgba(255, 117, 143, 0.8)",
                    size: 4,
                    name: "ζ-Écoute",
                },
                {
                    x: -0.52,
                    y: -0.36,
                    color: "#ffb703",
                    glow: "rgba(255, 183, 3, 0.6)",
                    size: 3.2,
                    name: "η-Regard",
                },
                {
                    x: -0.46,
                    y: 0.22,
                    color: "#ff758f",
                    glow: "rgba(255, 117, 143, 0.6)",
                    size: 3.2,
                    name: "θ-Patience",
                },
                // Pétale droit
                {
                    x: 0.74,
                    y: -0.06,
                    color: "#ff758f",
                    glow: "rgba(255, 117, 143, 0.8)",
                    size: 4,
                    name: "ι-Douceur",
                },
                {
                    x: 0.52,
                    y: -0.36,
                    color: "#ffb703",
                    glow: "rgba(255, 183, 3, 0.6)",
                    size: 3.2,
                    name: "κ-Compréhension",
                },
                {
                    x: 0.46,
                    y: 0.22,
                    color: "#ff758f",
                    glow: "rgba(255, 117, 143, 0.6)",
                    size: 3.2,
                    name: "λ-Soin",
                },
                // Pétale bas
                {
                    x: 0,
                    y: 0.38,
                    color: "#ffd166",
                    glow: "rgba(255, 209, 102, 0.7)",
                    size: 3.8,
                    name: "μ-Boussole",
                },
                {
                    x: -0.28,
                    y: 0.26,
                    color: "#ffb703",
                    glow: "rgba(255, 183, 3, 0.6)",
                    size: 3.2,
                    name: "ν-Ancrage",
                },
                {
                    x: 0.28,
                    y: 0.26,
                    color: "#ffb703",
                    glow: "rgba(255, 183, 3, 0.6)",
                    size: 3.2,
                    name: "ξ-Calme",
                },
                // Tige
                {
                    x: 0,
                    y: 0.62,
                    color: "#70e000",
                    glow: "rgba(112, 224, 0, 0.7)",
                    size: 3.2,
                    name: "ο-Bienveillance",
                },
                {
                    x: -0.05,
                    y: 0.95,
                    color: "#52b788",
                    glow: "rgba(82, 183, 136, 0.7)",
                    size: 3.2,
                    name: "π-Résilience",
                },
                {
                    x: 0.02,
                    y: 1.28,
                    color: "#38b000",
                    glow: "rgba(56, 176, 0, 0.8)",
                    size: 3.6,
                    name: "ρ-Racines",
                },
                // Feuille
                {
                    x: 0.28,
                    y: 0.84,
                    color: "#9ef01a",
                    glow: "rgba(158, 240, 26, 0.7)",
                    size: 3.2,
                    name: "σ-Éveil (3-6 ans)",
                },
            ];
        }

        private updateConstellationTargets() {
            const rawCoords = this.getNormalizedConstellationCoordinates();
            rawCoords.forEach((coord, i) => {
                if (this.stars[i]) {
                    this.stars[i].targetX = this.cx + coord.x * this.scale;
                    this.stars[i].targetY = this.cy + coord.y * this.scale;
                }
            });
        }

        private spawnParticles() {
            this.stars = [];
            const rawCoords = this.getNormalizedConstellationCoordinates();

            // 1. Les 17 étoiles de la constellation
            rawCoords.forEach((coord, i) => {
                this.stars.push({
                    x: Math.random() * this.width,
                    y: Math.random() * this.height,
                    vx: (Math.random() - 0.5) * 6,
                    vy: (Math.random() - 0.5) * 6,
                    targetX: this.cx + coord.x * this.scale,
                    targetY: this.cy + coord.y * this.scale,
                    size: coord.size,
                    color: coord.color,
                    glowColor: coord.glow,
                    isConstellation: true,
                    constellationIndex: i,
                    name: coord.name,
                    pulsePhase: Math.random() * Math.PI * 2,
                });
            });

            // 2. 65 étoiles de fond (le bruit mental / le ciel lointain)
            const countBackground = Math.min(
                65,
                Math.floor((this.width * this.height) / 14000),
            );
            for (let i = 0; i < countBackground; i++) {
                this.stars.push({
                    x: Math.random() * this.width,
                    y: Math.random() * this.height,
                    vx: (Math.random() - 0.5) * 4,
                    vy: (Math.random() - 0.5) * 4,
                    targetX: 0,
                    targetY: 0,
                    size: Math.random() * 1.8 + 0.8,
                    color: "rgba(255, 255, 255, 0.8)",
                    glowColor: "rgba(200, 220, 255, 0.4)",
                    isConstellation: false,
                    pulsePhase: Math.random() * Math.PI * 2,
                });
            }
        }

        public open() {
            if (this.isOpen) return;
            this.isOpen = true;
            this.bgClickTimestamps = [];
            this.currentAct = 1;
            this.act1StartTime = performance.now();
            this.act2StartTime = 0;
            this.act3StartTime = 0;

            this.overlay?.classList.add("is-active");
            this.overlay?.setAttribute("aria-hidden", "false");
            document.body.style.overflow = "hidden";

            this.resize();
            this.spawnParticles();

            this.cardWrapper?.classList.remove("is-visible");
            this.animate();
        }

        public close() {
            if (!this.isOpen) return;
            this.isOpen = false;
            this.bgClickTimestamps = [];

            this.overlay?.classList.remove("is-active");
            this.overlay?.setAttribute("aria-hidden", "true");
            this.cardWrapper?.classList.remove("is-visible");
            document.body.style.overflow = "";

            cancelAnimationFrame(this.animId);
        }

        private animate = () => {
            if (!this.isOpen || !this.ctx) return;

            const now = performance.now();
            this.ctx.clearRect(0, 0, this.width, this.height);

            if (this.currentAct === 1) {
                // Acte 1 : Dispersion en attente du clic de l'utilisateur
                this.renderAct1(now - this.act1StartTime);
            } else if (this.currentAct === 2) {
                // Acte 2 : Chargement et collimation ralentie
                const elapsed2 = now - this.act2StartTime;
                if (elapsed2 >= this.act2Duration) {
                    // Transition automatique vers l'Acte 3 à la fin du chargement
                    this.currentAct = 3;
                    this.act3StartTime = now;
                    this.renderAct3(0);
                } else {
                    this.renderAct2(elapsed2);
                }
            } else {
                // Acte 3 : Constellation stabilisée et affichage du message
                this.renderAct3(now - this.act3StartTime);
            }

            this.animId = requestAnimationFrame(this.animate);
        };

        // --- ACTE 1 : LA DISPERSION (ANALYSE DU BRUIT TDAH PUIS ATTENTE DU CLIC) ---
        private renderAct1(elapsed: number) {
            if (!this.ctx) return;

            const isScanning = elapsed < this.act1ScanDuration;
            const scanProgress = Math.min(1, elapsed / this.act1ScanDuration);
            const scanPct = Math.round(scanProgress * 100);

            if (this.hudText) {
                if (isScanning) {
                    this.hudText.textContent = this.isEnglish
                        ? `[ACT 1/3] ANALYZING ADHD NOISE... ${scanPct}%`
                        : `[ACTE 1/3] ANALYSE DU BRUIT TDAH... ${scanPct}%`;
                    this.hudText.style.color = "hsl(35, 85%, 65%)";
                } else {
                    this.hudText.textContent = this.isEnglish
                        ? "✦ [ACT 1/3] READY • TAP ANYWHERE TO FOCUS ✦"
                        : "✦ [ACTE 1/3] PRÊT • CLIQUEZ POUR RÉGLER LA FOCALE ✦";
                    this.hudText.style.color = "#ffd166";
                }
            }

            // Mouvement brownien et vibrations erratiques
            this.stars.forEach((star) => {
                const jitterX = (Math.random() - 0.5) * 3;
                const jitterY = (Math.random() - 0.5) * 3;

                star.x += star.vx + jitterX;
                star.y += star.vy + jitterY;

                // Rebond doux aux bordures
                if (star.x < 0 || star.x > this.width) star.vx *= -1;
                if (star.y < 0 || star.y > this.height) star.vy *= -1;

                this.drawStar(star, 1);
            });

            // Lignes de bruit éphémères entre particules proches
            this.drawNoiseConnections();

            // Balayage d'analyse optique pendant le calcul du bruit (0% -> 100%)
            if (isScanning) {
                const scanY = scanProgress * this.height;
                this.ctx.save();
                this.ctx.strokeStyle = "rgba(100, 200, 255, 0.45)";
                this.ctx.lineWidth = 1.5;
                this.ctx.shadowColor = "rgba(100, 200, 255, 0.7)";
                this.ctx.shadowBlur = 10;
                this.ctx.beginPath();
                this.ctx.moveTo(0, scanY);
                this.ctx.lineTo(this.width, scanY);
                this.ctx.stroke();
                this.ctx.restore();
            }

            // Invitation visuelle au centre dès que l'analyse est à 100%
            if (!isScanning) {
                const readyElapsed = elapsed - this.act1ScanDuration;
                const pulse = 1 + 0.12 * Math.sin(readyElapsed * 0.005);
                this.ctx.save();
                this.ctx.strokeStyle = "rgba(255, 183, 3, 0.45)";
                this.ctx.lineWidth = 1.5;
                this.ctx.setLineDash([4, 6]);
                this.ctx.beginPath();
                this.ctx.arc(this.cx, this.cy, 55 * pulse, 0, Math.PI * 2);
                this.ctx.stroke();

                this.ctx.setLineDash([]);
                this.ctx.strokeStyle = "rgba(255, 183, 3, 0.7)";
                this.ctx.beginPath();
                this.ctx.moveTo(this.cx - 8, this.cy);
                this.ctx.lineTo(this.cx + 8, this.cy);
                this.ctx.moveTo(this.cx, this.cy - 8);
                this.ctx.lineTo(this.cx, this.cy + 8);
                this.ctx.stroke();

                this.ctx.font = "12px monospace";
                this.ctx.fillStyle = "rgba(255, 210, 120, 0.85)";
                this.ctx.textAlign = "center";
                this.ctx.fillText(
                    this.isEnglish
                        ? "✦ TAP ANYWHERE TO FOCUS ✦"
                        : "✦ CLIQUEZ POUR RÉGLER LA FOCALE ✦",
                    this.cx,
                    this.cy + 75,
                );
                this.ctx.restore();
            }
        }

        // --- ACTE 2 : LA COLLIMATION (CHARGEMENT RALENTI & MISE AU POINT) ---
        private renderAct2(elapsed: number) {
            if (!this.ctx) return;

            const progress = Math.min(1, elapsed / this.act2Duration);

            if (this.hudText) {
                const pct = Math.round(progress * 100);
                let stepLabel = "";
                if (progress < 0.35) {
                    stepLabel = this.isEnglish
                        ? "ANALYZING WAVEFRONT"
                        : "ANALYSE DU FRONT D'ONDE";
                } else if (progress < 0.75) {
                    stepLabel = this.isEnglish
                        ? "OPTICAL COLLIMATION"
                        : "COLLIMATION OPTIQUE";
                } else {
                    stepLabel = this.isEnglish
                        ? "LOCKING BEAMS"
                        : "CAPTURE DES FAISCEAUX";
                }
                this.hudText.textContent = `[ACTE 2/3] ${stepLabel}... ${pct}%`;
                this.hudText.style.color =
                    progress > 0.8 ? "#ff758f" : "#70e000";
            }

            // Onde circulaire de collimation qui s'étend depuis le centre
            const maxRadius = Math.max(this.width, this.height) * 0.75;
            const waveRadius = progress * maxRadius;

            // Réticule d'instrumentation optique au centre
            this.drawOpticalReticle(progress);

            // Interpolation progressive étalée sur l'ensemble des 4.8 secondes
            const ease =
                progress < 0.5
                    ? 4 * Math.pow(progress, 3)
                    : 1 - Math.pow(-2 * progress + 2, 3) / 2;

            this.stars.forEach((star) => {
                if (star.isConstellation) {
                    const startX = star.startX ?? star.x;
                    const startY = star.startY ?? star.y;

                    // Légère ondulation organique qui s'estompe au fur et à mesure de l'approche
                    const wobble = (1 - progress) * 6;
                    const wobbleX =
                        Math.sin(elapsed * 0.0025 + star.pulsePhase) * wobble;
                    const wobbleY =
                        Math.cos(elapsed * 0.003 + star.pulsePhase) * wobble;

                    star.x = startX + (star.targetX - startX) * ease + wobbleX;
                    star.y = startY + (star.targetY - startY) * ease + wobbleY;
                } else {
                    // Les étoiles de fond dérivent calmement
                    star.x +=
                        Math.sin(elapsed * 0.001 + star.pulsePhase) * 0.25;
                    star.y +=
                        Math.cos(elapsed * 0.0012 + star.pulsePhase) * 0.25;
                }

                // Fade des étoiles de fond
                const opacity = star.isConstellation
                    ? 1
                    : Math.max(0.2, 1 - progress * 0.65);
                this.drawStar(star, opacity);
            });

            // Dessin de l'onde de choc optique
            if (waveRadius < maxRadius) {
                this.ctx.save();
                this.ctx.beginPath();
                this.ctx.arc(this.cx, this.cy, waveRadius, 0, Math.PI * 2);
                this.ctx.strokeStyle = `rgba(255, 183, 3, ${Math.max(0, 0.45 * (1 - progress))})`;
                this.ctx.lineWidth = 2.5;
                this.ctx.shadowColor = "rgba(255, 77, 109, 0.6)";
                this.ctx.shadowBlur = 15;
                this.ctx.stroke();
                this.ctx.restore();
            }
        }

        // --- ACTE 3 : LA CONSTELLATION POPPY ET LE MESSAGE ---
        private renderAct3(elapsed: number) {
            if (!this.ctx) return;

            const lineProgress = Math.min(1, elapsed / 1000);

            if (this.hudText) {
                this.hudText.textContent = this.isEnglish
                    ? "✦ CONSTELLATION OF POPPY — PERFECT ALIGNMENT ✦"
                    : "✦ CONSTELLATION DE POPPY — ALIGNEMENT PARFAIT ✦";
                this.hudText.style.color = "#ff758f";
            }

            // Stabilisation parfaite des étoiles cibles avec micro-mouvements poétiques
            this.stars.forEach((star) => {
                if (star.isConstellation) {
                    star.x += (star.targetX - star.x) * 0.2;
                    star.y += (star.targetY - star.y) * 0.2;
                } else {
                    // Dérive très lente des étoiles de fond
                    star.x += Math.sin(elapsed * 0.001 + star.pulsePhase) * 0.2;
                    star.y += Math.cos(elapsed * 0.001 + star.pulsePhase) * 0.2;
                }
            });

            // Dessiner les lignes célestes de la Constellation Poppy
            this.drawConstellationLines(lineProgress);

            // Dessiner les étoiles de fond apaisées
            this.stars
                .filter((s) => !s.isConstellation)
                .forEach((star) => {
                    this.drawStar(star, 0.25);
                });

            // Dessiner les étoiles de la constellation
            this.stars
                .filter((s) => s.isConstellation)
                .forEach((star) => {
                    const isHeart = star.constellationIndex === 0;
                    if (isHeart) {
                        // Pulsation cardiaque pour le cœur (Poppy)
                        const heartScale = 1 + 0.3 * Math.sin(elapsed * 0.004);
                        this.drawHeartGlow(star, heartScale);
                    }
                    this.drawStar(star, 1);
                });

            // Faire apparaître la carte de message à t >= 800ms
            if (
                elapsed >= 800 &&
                this.cardWrapper &&
                !this.cardWrapper.classList.contains("is-visible")
            ) {
                this.cardWrapper.classList.add("is-visible");
            }
        }

        private drawStar(star: StarNode, opacity: number) {
            if (!this.ctx) return;
            this.ctx.save();
            this.ctx.globalAlpha = opacity;

            // Halo starlight
            const radGrad = this.ctx.createRadialGradient(
                star.x,
                star.y,
                0,
                star.x,
                star.y,
                star.size * 3.5,
            );
            radGrad.addColorStop(0, star.glowColor);
            radGrad.addColorStop(1, "transparent");

            this.ctx.fillStyle = radGrad;
            this.ctx.beginPath();
            this.ctx.arc(star.x, star.y, star.size * 3.5, 0, Math.PI * 2);
            this.ctx.fill();

            // Point central brillant
            this.ctx.fillStyle = star.color;
            this.ctx.beginPath();
            this.ctx.arc(star.x, star.y, star.size, 0, Math.PI * 2);
            this.ctx.fill();

            this.ctx.restore();
        }

        private drawHeartGlow(star: StarNode, heartScale: number) {
            if (!this.ctx) return;
            this.ctx.save();

            const radius = 28 * heartScale;
            const haloGrad = this.ctx.createRadialGradient(
                star.x,
                star.y,
                0,
                star.x,
                star.y,
                radius,
            );
            haloGrad.addColorStop(0, "rgba(255, 77, 109, 0.7)");
            haloGrad.addColorStop(0.5, "rgba(255, 183, 3, 0.3)");
            haloGrad.addColorStop(1, "transparent");

            this.ctx.fillStyle = haloGrad;
            this.ctx.beginPath();
            this.ctx.arc(star.x, star.y, radius, 0, Math.PI * 2);
            this.ctx.fill();

            this.ctx.restore();
        }

        private drawConstellationLines(progress: number) {
            if (!this.ctx) return;
            this.ctx.save();

            this.lines.forEach((line) => {
                const starA = this.stars[line.from];
                const starB = this.stars[line.to];
                if (!starA || !starB) return;

                const currentBX = starA.x + (starB.x - starA.x) * progress;
                const currentBY = starA.y + (starB.y - starA.y) * progress;

                this.ctx!.beginPath();
                this.ctx!.moveTo(starA.x, starA.y);
                this.ctx!.lineTo(currentBX, currentBY);

                if (line.type === "stem") {
                    this.ctx!.strokeStyle = "rgba(112, 224, 0, 0.65)";
                    this.ctx!.lineWidth = 2.2;
                } else if (line.type === "leaf") {
                    this.ctx!.strokeStyle = "rgba(158, 240, 26, 0.75)";
                    this.ctx!.lineWidth = 1.8;
                } else if (line.type === "cross") {
                    this.ctx!.strokeStyle = "rgba(255, 183, 3, 0.35)";
                    this.ctx!.lineWidth = 1.2;
                    this.ctx!.setLineDash([3, 4]);
                } else {
                    // Pétales
                    this.ctx!.strokeStyle = "rgba(255, 117, 143, 0.7)";
                    this.ctx!.lineWidth = 2;
                    this.ctx!.setLineDash([]);
                }

                this.ctx!.shadowColor = "rgba(255, 77, 109, 0.5)";
                this.ctx!.shadowBlur = 8;
                this.ctx!.stroke();
            });

            this.ctx.restore();
        }

        private drawOpticalReticle(progress: number) {
            if (!this.ctx) return;
            this.ctx.save();

            const baseRadius = this.scale * (0.8 + progress * 0.4);
            const rot = progress * Math.PI * 0.25;

            this.ctx.translate(this.cx, this.cy);
            this.ctx.rotate(rot);

            // Cercles concentriques fins
            this.ctx.strokeStyle = `rgba(255, 183, 3, ${0.25 * (1 - progress * 0.5)})`;
            this.ctx.lineWidth = 1;

            [0.5, 0.85, 1.2].forEach((ratio) => {
                this.ctx!.beginPath();
                this.ctx!.arc(0, 0, baseRadius * ratio, 0, Math.PI * 2);
                this.ctx!.stroke();
            });

            // Graduations angulaires (style télescope)
            const tickCount = 16;
            for (let i = 0; i < tickCount; i++) {
                const angle = (i * Math.PI * 2) / tickCount;
                const r1 = baseRadius * 1.15;
                const r2 = baseRadius * (i % 4 === 0 ? 1.28 : 1.22);

                this.ctx.beginPath();
                this.ctx.moveTo(Math.cos(angle) * r1, Math.sin(angle) * r1);
                this.ctx.lineTo(Math.cos(angle) * r2, Math.sin(angle) * r2);
                this.ctx.stroke();
            }

            this.ctx.restore();
        }

        private drawNoiseConnections() {
            if (!this.ctx) return;
            this.ctx.save();
            this.ctx.strokeStyle = "rgba(100, 180, 255, 0.12)";
            this.ctx.lineWidth = 0.8;

            const threshold = 90;
            const sample = this.stars.slice(0, 30);
            for (let i = 0; i < sample.length; i++) {
                for (let j = i + 1; j < sample.length; j++) {
                    const dx = sample[i].x - sample[j].x;
                    const dy = sample[i].y - sample[j].y;
                    const dist = Math.sqrt(dx * dx + dy * dy);
                    if (dist < threshold) {
                        this.ctx.beginPath();
                        this.ctx.moveTo(sample[i].x, sample[i].y);
                        this.ctx.lineTo(sample[j].x, sample[j].y);
                        this.ctx.stroke();
                    }
                }
            }
            this.ctx.restore();
        }
    }

    // Instancier le contrôleur au chargement du DOM
    if (typeof window !== "undefined") {
        document.addEventListener("DOMContentLoaded", () => {
            new PoppyEasterEggController();
        });
    }
</script>
