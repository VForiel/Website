---
// Recherche dans le site et le catalogue des projets : Ctrl/⌘+K ou « / », ou la loupe du header

interface Props {
    lang?: "fr" | "en";
}

const { lang = "fr" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const copy = {
    fr: {
        label: "Rechercher dans le site",
        placeholder: "Titre, VF·12, tag…",
        pages: "Pages",
        projects: "Catalogue",
        empty: "Aucun objet trouvé dans le catalogue.",
        hints: "↑↓ naviguer · ↵ ouvrir · Échap fermer",
        close: "Fermer",
    },
    en: {
        label: "Search the site",
        placeholder: "Title, VF·12, tag…",
        pages: "Pages",
        projects: "Catalogue",
        empty: "No object found in the catalogue.",
        hints: "↑↓ navigate · ↵ open · Esc close",
        close: "Close",
    },
}[lang];
---

<dialog
    class="search"
    data-search
    data-index={`${base}/${lang}/catalogue.json`}
    data-label-pages={copy.pages}
    data-label-projects={copy.projects}
    aria-label={copy.label}
>
    <div class="search__panel">
        <div class="search__field">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <circle cx="11" cy="11" r="7"></circle>
                <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
            </svg>
            <input
                type="search"
                class="search__input"
                placeholder={copy.placeholder}
                aria-label={copy.label}
                autocomplete="off"
                spellcheck="false"
                role="combobox"
                aria-expanded="true"
                aria-controls="search-results"
            />
            <form method="dialog">
                <button class="search__close" aria-label={copy.close}>Esc</button>
            </form>
        </div>
        <ul class="search__results" id="search-results" role="listbox"></ul>
        <p class="search__empty" hidden>{copy.empty}</p>
        <p class="search__hints" aria-hidden="true">{copy.hints}</p>
    </div>
</dialog>

<style>
    .search {
        width: min(38rem, calc(100vw - 2rem));
        max-height: min(32rem, calc(100dvh - 4rem));
        margin: 12vh auto auto;
        padding: 0;
        color: var(--color-text);
        background: var(--color-background);
        border: 1px solid var(--color-border);
        box-shadow: var(--shadow-xl);
    }

    .search::backdrop {
        background: hsla(226, 40%, 3%, 0.6);
    }

    :global(.light-theme) .search::backdrop {
        background: hsla(40, 20%, 30%, 0.25);
    }

    .search__panel {
        display: flex;
        flex-direction: column;
        max-height: inherit;
    }

    .search__field {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        padding: var(--space-4) var(--space-5);
        border-bottom: 1px solid var(--color-border);
        color: var(--color-text-muted);
    }

    .search__input {
        flex: 1;
        min-width: 0;
        border: none;
        outline: none;
        background: none;
        color: var(--color-text);
        font-family: var(--font-serif);
        font-size: var(--text-xl);
    }

    .search__input::placeholder {
        color: var(--color-text-muted);
    }

    .search__input::-webkit-search-cancel-button {
        display: none;
    }

    .search__close {
        padding: 0.1rem 0.4rem;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        background: none;
        color: var(--color-text-muted);
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        cursor: pointer;
    }

    .search__results {
        overflow-y: auto;
        padding-block: var(--space-2);
    }

    .search__results :global(.search__group) {
        padding: var(--space-3) var(--space-5) var(--space-1);
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-text-muted);
    }

    .search__results :global(.search__item) {
        display: grid;
        grid-template-columns: 4.5rem minmax(0, 1fr);
        gap: var(--space-1) var(--space-4);
        align-items: baseline;
        padding: var(--space-2) var(--space-5);
        border-left: 2px solid transparent;
        cursor: pointer;
    }

    .search__results :global(.search__item[aria-selected="true"]) {
        border-left-color: var(--color-primary);
        background: rgba(var(--color-primary-rgb), 0.06);
    }

    .search__results :global(.search__ref) {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-text-muted);
    }

    .search__results :global(.search__item[aria-selected="true"] .search__ref) {
        color: var(--color-primary);
    }

    .search__results :global(.search__title) {
        font-family: var(--font-serif);
        font-size: var(--text-lg);
        line-height: 1.3;
    }

    .search__results :global(.search__detail) {
        grid-column: 2;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--color-text-muted);
    }

    .search__empty {
        padding: var(--space-6) var(--space-5);
        font-family: var(--font-serif);
        font-style: italic;
        color: var(--color-text-secondary);
    }

    .search__hints {
        padding: var(--space-3) var(--space-5);
        border-top: 1px solid var(--color-border-subtle);
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        color: var(--color-text-muted);
        max-width: none;
    }

    @media (hover: none) {
        .search__hints {
            display: none;
        }
    }
</style>

<script>
    interface Entry {
        kind: "page" | "project";
        title: string;
        href: string;
        ref: string;
        detail: string;
        keywords: string;
    }

    const dialog = document.querySelector<HTMLDialogElement>("[data-search]");

    if (dialog) {
        const input = dialog.querySelector<HTMLInputElement>(".search__input")!;
        const list = dialog.querySelector<HTMLUListElement>(".search__results")!;
        const empty = dialog.querySelector<HTMLElement>(".search__empty")!;
        const labels = { page: dialog.dataset.labelPages ?? "", project: dialog.dataset.labelProjects ?? "" };

        let index: Entry[] | null = null;
        let results: Entry[] = [];
        let selected = 0;

        // Comparaison sans accents ni casse ; « vf12 », « VF 12 » et « VF·12 » se valent
        const normalize = (text: string) =>
            text.normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/[·\s-]+/g, " ").toLowerCase().trim();
        const compact = (text: string) => normalize(text).replace(/ /g, "");

        async function loadIndex() {
            if (index) return index;
            const response = await fetch(dialog!.dataset.index!);
            index = (await response.json()) as Entry[];
            return index;
        }

        function score(entry: Entry, query: string): number {
            if (!query) return entry.kind === "page" ? 1 : 0;
            const title = normalize(entry.title);
            if (compact(entry.ref) === compact(query)) return 100;
            if (title.startsWith(query)) return 50;
            if (title.includes(query)) return 30;
            if (compact(entry.ref).includes(compact(query))) return 20;
            const words = query.split(" ");
            const haystack = normalize(`${entry.title} ${entry.keywords} ${entry.detail}`);
            return words.every((word) => haystack.includes(word)) ? 10 : 0;
        }

        function render() {
            list.replaceChildren();
            empty.hidden = results.length > 0;
            let group = "";
            results.forEach((entry, position) => {
                if (entry.kind !== group) {
                    group = entry.kind;
                    const heading = document.createElement("li");
                    heading.className = "search__group";
                    heading.setAttribute("role", "presentation");
                    heading.textContent = labels[entry.kind];
                    list.append(heading);
                }
                const item = document.createElement("li");
                item.className = "search__item";
                item.id = `search-option-${position}`;
                item.setAttribute("role", "option");
                item.setAttribute("aria-selected", String(position === selected));
                const ref = document.createElement("span");
                ref.className = "search__ref";
                ref.textContent = entry.kind === "project" ? entry.ref : "§";
                const title = document.createElement("span");
                title.className = "search__title";
                title.textContent = entry.title;
                item.append(ref, title);
                if (entry.detail) {
                    const detail = document.createElement("span");
                    detail.className = "search__detail";
                    detail.textContent = entry.detail;
                    item.append(detail);
                }
                item.addEventListener("click", () => open(position));
                item.addEventListener("pointermove", () => select(position));
                list.append(item);
            });
            input.setAttribute("aria-activedescendant", results.length ? `search-option-${selected}` : "");
        }

        function update() {
            const query = normalize(input.value);
            const ranked = (index ?? [])
                .map((entry, order) => ({ entry, order, value: score(entry, query) }))
                .filter((item) => item.value > 0 || (!query && item.entry.kind === "project" && item.order < 13));
            // Sans requête : les pages puis les projets les plus récents ; sinon par pertinence
            if (query) ranked.sort((a, b) => b.value - a.value || a.order - b.order);
            results = ranked.slice(0, query ? 10 : 12).map((item) => item.entry);
            // Les groupes restent contigus : pages d'abord, puis projets
            results.sort((a, b) => (a.kind === b.kind ? 0 : a.kind === "page" ? -1 : 1));
            selected = 0;
            render();
        }

        function select(position: number) {
            if (position === selected || !results.length) return;
            selected = (position + results.length) % results.length;
            list.querySelectorAll(".search__item").forEach((item, i) => {
                item.setAttribute("aria-selected", String(i === selected));
                if (i === selected) item.scrollIntoView({ block: "nearest" });
            });
            input.setAttribute("aria-activedescendant", `search-option-${selected}`);
        }

        function open(position: number) {
            const entry = results[position];
            if (entry) window.location.href = entry.href;
        }

        async function show() {
            if (dialog!.open) return;
            dialog!.showModal();
            input.value = "";
            await loadIndex();
            update();
            input.focus();
        }

        input.addEventListener("input", update);
        input.addEventListener("keydown", (event) => {
            if (event.key === "ArrowDown") select(selected + 1);
            else if (event.key === "ArrowUp") select(selected - 1);
            else if (event.key === "Enter") open(selected);
            else return;
            event.preventDefault();
        });

        // Clic sur le fond : fermeture
        dialog.addEventListener("click", (event) => {
            if (event.target === dialog) dialog.close();
        });

        document.addEventListener("keydown", (event) => {
            const typing = event.target instanceof HTMLElement && event.target.closest("input, textarea, [contenteditable]");
            if ((event.key === "k" && (event.ctrlKey || event.metaKey)) || (event.key === "/" && !typing)) {
                event.preventDefault();
                show();
            }
        });

        document.querySelectorAll("[data-search-open]").forEach((button) => button.addEventListener("click", show));
    }
</script>
