---
// Liste des publications et présentations, à la manière d'une base bibliographique (ADS)
import { getCollection } from "astro:content";
import Section from "./Section.astro";
import CopyButton from "./CopyButton.astro";
import { parsePartialDate, formatPartialDate, dateToTimestamp } from "../utils/dates";

interface Props {
    lang: "fr" | "en";
}

const { lang } = Astro.props;

const t = {
    fr: {
        title: "Publications",
        lead: "Articles, actes de conférence et présentations.",
        articles: "Articles",
        talks: "Présentations",
        noArticles: "Aucun article publié pour l'instant. Un article est en cours de finalisation.",
        noTalks: "Aucune présentation pour l'instant.",
        bibtex: "BibTeX",
        link: "Lien",
        types: { talk: "Exposé", poster: "Poster", article: "Article", proceedings: "Actes", thesis: "Thèse" },
        status: { published: "Publié", accepted: "Accepté", submitted: "Soumis", "in-prep": "En préparation", upcoming: "À venir" },
    },
    en: {
        title: "Publications",
        lead: "Articles, conference proceedings and talks.",
        articles: "Articles",
        talks: "Talks",
        noArticles: "No published article yet. One article is being finalised.",
        noTalks: "No talk yet.",
        bibtex: "BibTeX",
        link: "Link",
        types: { talk: "Talk", poster: "Poster", article: "Article", proceedings: "Proceedings", thesis: "Thesis" },
        status: { published: "Published", accepted: "Accepted", submitted: "Submitted", "in-prep": "In preparation", upcoming: "Upcoming" },
    },
}[lang];

const entries = (await getCollection("publications")).sort(
    (a, b) => dateToTimestamp(b.data.date) - dateToTimestamp(a.data.date),
);
const articles = entries.filter((e) => ["article", "proceedings", "thesis"].includes(e.data.type));
const talks = entries.filter((e) => ["talk", "poster"].includes(e.data.type));

const formatDate = (date: string) => formatPartialDate(parsePartialDate(date), lang);
const year = (date: string) => parsePartialDate(date)?.date.getFullYear();
---

<Section>
    <div class="page-header">
        <h1>{t.title}</h1>
        <p class="lead">{t.lead}</p>
    </div>
</Section>

<Section>
    <section class="pub-block">
        <div class="section-head">
            <h2 class="section-head__title">
                <span class="section-head__index">01</span>
                {t.articles}
            </h2>
        </div>

        {
            articles.length === 0 ? (
                <p class="pub-empty">{t.noArticles}</p>
            ) : (
                <ol class="pub-list">
                    {articles.map(({ data }) => (
                        <li class="pub">
                            <span class="pub__year">{year(data.date)}</span>
                            <div class="pub__body">
                                <p class="pub__citation">
                                    {data.authors.map((author, i) => (
                                        <>
                                            {i > 0 && (i === data.authors.length - 1 ? " & " : ", ")}
                                            {/Foriel/.test(author) ? <strong>{author}</strong> : author}
                                        </>
                                    ))}
                                    {data.authors.length > 0 && ". "}
                                    {data.title && <span class="pub__title">{data.title}.</span>}{" "}
                                    <em>{data.venue}</em>.
                                </p>
                                <p class="pub__meta">
                                    <span>{t.types[data.type]}</span>
                                    {data.status && <span>{t.status[data.status]}</span>}
                                    {data.doi && <a href={`https://doi.org/${data.doi}`} class="link-underline">DOI</a>}
                                    {data.arxiv && <a href={`https://arxiv.org/abs/${data.arxiv}`} class="link-underline">arXiv</a>}
                                    {data.ads && <a href={data.ads} class="link-underline">ADS</a>}
                                    {data.url && <a href={data.url} class="link-underline">{t.link}</a>}
                                    {data.bibtex && (
                                        <span class="pub__bibtex">
                                            {t.bibtex}
                                            <CopyButton text={data.bibtex} lang={lang} />
                                        </span>
                                    )}
                                </p>
                            </div>
                        </li>
                    ))}
                </ol>
            )
        }
    </section>

    <section class="pub-block">
        <div class="section-head">
            <h2 class="section-head__title">
                <span class="section-head__index">02</span>
                {t.talks}
            </h2>
        </div>

        {
            talks.length === 0 ? (
                <p class="pub-empty">{t.noTalks}</p>
            ) : (
                <ol class="pub-list">
                    {talks.map(({ data }) => (
                        <li class="pub">
                            <span class="pub__year">{formatDate(data.date)}</span>
                            <div class="pub__body">
                                <p class="pub__citation">
                                    {data.title && <span class="pub__title">{data.title}. </span>}
                                    <span class="pub__venue">{data.venue}</span>
                                    {data.location && <span class="pub__location"> · {data.location}</span>}
                                </p>
                                <p class="pub__meta">
                                    <span>{t.types[data.type]}</span>
                                    {data.status && <span>{t.status[data.status]}</span>}
                                    {data.url && <a href={data.url} class="link-underline">{t.link}</a>}
                                    {data.bibtex && (
                                        <span class="pub__bibtex">
                                            {t.bibtex}
                                            <CopyButton text={data.bibtex} lang={lang} />
                                        </span>
                                    )}
                                </p>
                            </div>
                        </li>
                    ))}
                </ol>
            )
        }
    </section>
</Section>

<style>
    .page-header {
        padding-block: var(--space-4) var(--space-10);
    }

    .page-header h1 {
        font-size: clamp(2.5rem, 6vw, 4.25rem);
        margin-block-end: var(--space-4);
    }

    .lead {
        font-size: var(--text-xl);
        color: var(--color-text-secondary);
        max-width: 52ch;
    }

    .pub-block + .pub-block {
        margin-block-start: var(--space-16);
    }

    .pub-list {
        display: flex;
        flex-direction: column;
    }

    .pub {
        display: grid;
        grid-template-columns: 9rem minmax(0, 1fr);
        gap: var(--space-6);
        padding-block: var(--space-5);
        border-bottom: 1px solid var(--color-border-subtle);
    }

    .pub__year {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--color-text-muted);
        padding-block-start: 0.35rem;
    }

    .pub__citation {
        font-size: var(--text-base);
        max-width: 70ch;
        color: var(--color-text-secondary);
    }

    .pub__title,
    .pub__venue {
        font-family: var(--font-serif);
        font-size: var(--text-xl);
        color: var(--color-text);
    }

    .pub__location {
        color: var(--color-text-muted);
    }

    .pub__meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2) var(--space-5);
        margin-block-start: var(--space-2);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.04em;
        color: var(--color-text-muted);
    }

    .pub__bibtex {
        display: inline-flex;
        align-items: center;
    }

    .pub-empty {
        font-family: var(--font-serif);
        font-size: var(--text-lg);
        font-style: italic;
        color: var(--color-text-secondary);
    }

    @media (max-width: 640px) {
        .pub {
            grid-template-columns: 1fr;
            gap: var(--space-2);
        }
    }
</style>
