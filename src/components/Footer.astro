---
import { withLocalePrefix } from "../i18n/config";
import type { Locale } from "../i18n/config";

interface Props {
    lang?: Locale;
}

const { lang = "fr" } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="footer">
    <div class="container">
        <div class="footer__content">
            <div class="footer__section">
                <h3 class="footer__heading">Vincent Foriel</h3>
                <p class="footer__text">
                    {
                        lang === "en"
                            ? "PhD student in astronomical instrumentation, high-contrast imaging and optical simulation"
                            : "Doctorant en instrumentation astronomique, imagerie à haut contraste et simulation optique"
                    }
                </p>
                <div class="footer__hint">
                    <button
                        class="footer__hint-icon"
                        aria-label="Secret"
                        id="hint-toggle">✦</button
                    >
                    <p class="footer__hint-text" id="hint-text">
                        {
                            lang === "en"
                                ? "This site hides 4 secrets. Space is not merely something to admire — between light and darkness, the constellations within are true compasses, for every traveler, of every origin."
                                : "Ce site cache 4 secrets. L’espace ne demande pas seulement à être admiré — entre lumière et ténèbres, les constellations en son sein sont autant de boussoles, pour tout voyageur, de toute origine."
                        }
                    </p>
                </div>
            </div>

            <div class="footer__section">
                <h3 class="footer__heading">Contact</h3>
                <ul class="footer__links">
                    <li>
                        <a
                            href="mailto:vincent.foriel@gmail.com"
                            class="footer__link"
                        >
                            vincent.foriel@gmail.com
                        </a>
                    </li>
                    <li>
                        <a
                            href="https://github.com/VForiel"
                            class="footer__link"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            GitHub
                        </a>
                    </li>
                    <li>
                        <a
                            href="https://www.linkedin.com/in/vincent-foriel"
                            class="footer__link"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            LinkedIn
                        </a>
                    </li>
                </ul>
            </div>

            <div class="footer__section">
                <h3 class="footer__heading">Navigation</h3>
                <ul class="footer__links">
                    <li>
                        <a
                            href={withLocalePrefix("/", lang)}
                            class="footer__link">Accueil</a
                        >
                    </li>
                    <li>
                        <a
                            href={withLocalePrefix("/about", lang)}
                            class="footer__link">À propos</a
                        >
                    </li>
                    <li>
                        <a
                            href={withLocalePrefix("/expertise", lang)}
                            class="footer__link">Expertise</a
                        >
                    </li>
                    <li>
                        <a
                            href={withLocalePrefix("/portfolio", lang)}
                            class="footer__link">Portfolio</a
                        >
                    </li>
                    <li>
                        <a
                            href={withLocalePrefix("/cv", lang)}
                            class="footer__link">CV</a
                        >
                    </li>
                    <li>
                        <a
                            href={withLocalePrefix("/contact", lang)}
                            class="footer__link">Contact</a
                        >
                    </li>
                </ul>
            </div>
        </div>

        <div class="footer__bottom">
            <p class="footer__copyright">
                © {currentYear} Vincent Foriel. {
                    lang === "en"
                        ? "All rights reserved."
                        : "Tous droits réservés."
                }
            </p>
        </div>
    </div>
</footer>

<style>
    .footer {
        margin-block-start: var(--space-32);
        padding-block: var(--space-16);
        background-color: var(--color-background-secondary);
        border-top: 1px solid var(--color-border);
    }

    .footer__content {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: var(--space-12);
        margin-block-end: var(--space-12);
    }

    .footer__section {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
    }

    .footer__heading {
        font-size: var(--text-sm);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-text);
    }

    .footer__text {
        font-size: var(--text-sm);
        color: var(--color-text-secondary);
        line-height: 1.6;
    }

    .footer__links {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
    }

    .footer__link {
        font-size: var(--text-sm);
        color: var(--color-text-secondary);
        transition: color var(--transition-fast);
    }

    .footer__link:hover {
        color: var(--color-primary);
    }

    .footer__bottom {
        padding-block-start: var(--space-8);
        border-top: 1px solid var(--color-border-subtle);
    }

    .footer__copyright {
        font-size: var(--text-xs);
        color: var(--color-text-muted);
        text-align: center;
    }

    .footer__hint {
        margin-block-start: var(--space-2);
    }

    .footer__hint-icon {
        background: none;
        border: none;
        color: var(--color-text-muted);
        opacity: 0.3;
        font-size: 0.7rem;
        cursor: pointer;
        padding: 0;
        transition:
            opacity var(--transition-fast),
            color var(--transition-fast);
    }

    .footer__hint-icon:hover {
        opacity: 0.6;
        color: var(--color-accent);
    }

    .footer__hint-text {
        font-size: 0.65rem;
        color: var(--color-text-muted);
        opacity: 0;
        max-height: 0;
        overflow: hidden;
        font-style: italic;
        line-height: 1.6;
        transition:
            opacity var(--transition-slow),
            max-height var(--transition-slow);
    }

    .footer__hint-text.visible {
        opacity: 0.45;
        max-height: 5em;
        margin-block-start: var(--space-2);
    }

    @media (max-width: 768px) {
        .footer__content {
            grid-template-columns: 1fr;
            gap: var(--space-8);
        }
    }
</style>

<script>
    document.getElementById("hint-toggle")?.addEventListener("click", () => {
        document.getElementById("hint-text")?.classList.toggle("visible");
    });
</script>
