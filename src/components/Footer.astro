---
import { withLocalePrefix } from "../i18n/config";
import type { Locale } from "../i18n/config";

interface Props {
    lang?: Locale;
}

const { lang = "fr" } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="footer">
    <div class="spectrum" aria-hidden="true">
        <div class="spectrum__band">
            <span class="spectrum__line" tabindex="0" data-label={lang === "en" ? "K · 393.4 nm · ionised calcium" : "K · 393,4 nm · calcium ionisé"}></span>
            <span class="spectrum__line" tabindex="0" data-label={lang === "en" ? "H · 396.8 nm · ionised calcium" : "H · 396,8 nm · calcium ionisé"}></span>
            <span class="spectrum__line" tabindex="0" data-label={lang === "en" ? "Hδ · 410.2 nm · hydrogen" : "Hδ · 410,2 nm · hydrogène"}></span>
            <span class="spectrum__line" tabindex="0" data-label={lang === "en" ? "G · 430.8 nm · iron and CH molecule" : "G · 430,8 nm · fer et molécule CH"}></span>
            <span class="spectrum__line" tabindex="0" data-label={lang === "en" ? "Hγ · 434.0 nm · hydrogen" : "Hγ · 434,0 nm · hydrogène"}></span>
            <span class="spectrum__line" tabindex="0" data-label={lang === "en" ? "F · Hβ · 486.1 nm · hydrogen" : "F · Hβ · 486,1 nm · hydrogène"}></span>
            <span class="spectrum__line" tabindex="0" data-label={lang === "en" ? "b · 517.7 nm · magnesium" : "b · 517,7 nm · magnésium"}></span>
            <span class="spectrum__line" tabindex="0" data-label={lang === "en" ? "E · 527.0 nm · iron" : "E · 527,0 nm · fer"}></span>
            <span class="spectrum__line" tabindex="0" data-label={lang === "en" ? "D · 589.3 nm · sodium" : "D · 589,3 nm · sodium"}></span>
            <span class="spectrum__line" tabindex="0" data-label={lang === "en" ? "C · Hα · 656.3 nm · hydrogen" : "C · Hα · 656,3 nm · hydrogène"}></span>
            <span class="spectrum__line" tabindex="0" data-label={lang === "en" ? "B · 686.7 nm · oxygen in Earth's atmosphere" : "B · 686,7 nm · oxygène de l'atmosphère terrestre"}></span>
        </div>
        <div class="container spectrum__scale">
            <span>400 nm</span>
            <span>500</span>
            <span>600</span>
            <span>700</span>
        </div>
    </div>
    <div class="container">
        <div class="footer__content">
            <div class="footer__section">
                <h3 class="footer__heading">Vincent Foriel</h3>
                <p class="footer__text">
                    {
                        lang === "en"
                            ? "PhD student in astronomical instrumentation, high-contrast imaging and optical simulation"
                            : "Doctorant en instrumentation astronomique, imagerie à haut contraste et simulation optique"
                    }
                </p>
                <div class="footer__hint">
                    <button
                        class="footer__hint-icon"
                        aria-label="Secret"
                        id="hint-toggle">✦</button
                    >
                    <p class="footer__hint-text" id="hint-text">
                        {
                            lang === "en" ? (
                                <>
                                    <b>This site hides 5 secrets.</b>
                                    <br />
                                    Space is not merely something to admire.
                                    <br />
                                    Between light and darkness,
                                    <br />
                                    when the frenzy of the stars makes the
                                    night bloom,
                                    <br />
                                    constellations become true compasses,
                                    <br />
                                    for every traveler, of every origin.
                                </>
                            ) : (
                                <>
                                    <b>Ce site cache 5 secrets.</b>
                                    <br />
                                    L’espace ne demande pas seulement à être
                                    admiré.
                                    <br />
                                    Entre lumière et ténèbres,
                                    <br />
                                    quand la frénésie des étoiles fait fleurir
                                    la nuit,
                                    <br />
                                    les constellations deviennent autant de
                                    boussoles,
                                    <br />
                                    pour tout voyageur, de toute origine.
                                </>
                            )
                        }
                    
                    <span
                        class="footer__secrets"
                        data-secrets
                        data-template={lang === "en" ? "{n} of {total} secrets found" : "{n} secret{s} sur {total} trouvé{s}"}
                        data-complete={lang === "en" ? "All {total} secrets found. Well travelled." : "Les {total} secrets sont trouvés. Bon voyage."}
                        hidden
                    ></span>
                    </p>
                </div>
            </div>

            <div class="footer__section">
                <h3 class="footer__heading">Contact</h3>
                <ul class="footer__links">
                    <li>
                        <a
                            href="mailto:vincent.foriel@gmail.com"
                            class="footer__link"
                        >
                            vincent.foriel@gmail.com
                        </a>
                    </li>
                    <li>
                        <a
                            href="https://github.com/VForiel"
                            class="footer__link"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            GitHub
                        </a>
                    </li>
                    <li>
                        <a
                            href="https://www.linkedin.com/in/vincentforiel/"
                            class="footer__link"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            LinkedIn
                        </a>
                    </li>
                </ul>
            </div>

            <div class="footer__section">
                <h3 class="footer__heading">Navigation</h3>
                <ul class="footer__links">
                    <li>
                        <a
                            href={withLocalePrefix("/", lang)}
                            class="footer__link">Accueil</a
                        >
                    </li>
                    <li>
                        <a
                            href={withLocalePrefix("/about", lang)}
                            class="footer__link">À propos</a
                        >
                    </li>
                    <li>
                        <a
                            href={withLocalePrefix("/expertise", lang)}
                            class="footer__link">Expertise</a
                        >
                    </li>
                    <li>
                        <a
                            href={withLocalePrefix("/portfolio", lang)}
                            class="footer__link">Portfolio</a
                        >
                    </li>
                    <li>
                        <a
                            href={withLocalePrefix("/cv", lang)}
                            class="footer__link">CV</a
                        >
                    </li>
                    <li>
                        <a
                            href={withLocalePrefix("/contact", lang)}
                            class="footer__link">Contact</a
                        >
                    </li>
                </ul>
            </div>
        </div>

        <div class="footer__bottom">
            <p class="footer__copyright">
                © {currentYear} Vincent Foriel. {
                    lang === "en"
                        ? "All rights reserved."
                        : "Tous droits réservés."
                }
            </p>
            <p class="footer__colophon">
                {
                    lang === "en"
                        ? "Set in Newsreader, IBM Plex Sans & IBM Plex Mono. Above: the solar spectrum and its Fraunhofer lines."
                        : "Composé en Newsreader, IBM Plex Sans et IBM Plex Mono. En haut : le spectre solaire et ses raies de Fraunhofer."
                }
            </p>
        </div>
    </div>
</footer>

<style>
    .footer {
        margin-block-start: var(--space-24);
        padding-block: 0 var(--space-8);
        background-color: var(--color-surface);
    }

    /* Spectre visible 380-750 nm ; raies de Fraunhofer placées à (λ - 380) / 370 */
    .spectrum {
        margin-block-end: var(--space-16);
    }

    .spectrum__band {
        height: 10px;
    }

    /* Dégradé et raies dessinés sur un pseudo-élément : le filtre ne touche pas les étiquettes */
    .spectrum__band::before {
        content: "";
        position: absolute;
        inset: 0;
        --line: hsl(226, 30%, 4%);
        background:
            linear-gradient(var(--line), var(--line)) 3.62% 0 / 2px 100% no-repeat,  /* K  393.4 */
            linear-gradient(var(--line), var(--line)) 4.54% 0 / 2px 100% no-repeat,  /* H  396.8 */
            linear-gradient(var(--line), var(--line)) 8.16% 0 / 1px 100% no-repeat,  /* Hδ 410.2 */
            linear-gradient(var(--line), var(--line)) 13.73% 0 / 2px 100% no-repeat, /* G  430.8 */
            linear-gradient(var(--line), var(--line)) 14.59% 0 / 1px 100% no-repeat, /* Hγ 434.0 */
            linear-gradient(var(--line), var(--line)) 28.68% 0 / 2px 100% no-repeat, /* F  486.1 */
            linear-gradient(var(--line), var(--line)) 37.22% 0 / 1px 100% no-repeat, /* b  517.7 */
            linear-gradient(var(--line), var(--line)) 39.73% 0 / 1px 100% no-repeat, /* E  527.0 */
            linear-gradient(var(--line), var(--line)) 56.57% 0 / 3px 100% no-repeat, /* D  589.3 */
            linear-gradient(var(--line), var(--line)) 74.68% 0 / 2px 100% no-repeat, /* C  656.3 */
            linear-gradient(var(--line), var(--line)) 82.89% 0 / 2px 100% no-repeat, /* B  686.7 */
            linear-gradient(
                90deg,
                rgb(70, 0, 80) 0%,
                rgb(106, 0, 255) 10.8%,
                rgb(0, 70, 255) 18.9%,
                rgb(0, 213, 255) 27%,
                rgb(0, 255, 146) 32.4%,
                rgb(94, 255, 0) 40.5%,
                rgb(225, 255, 0) 51.4%,
                rgb(255, 223, 0) 56.8%,
                rgb(255, 119, 0) 64.9%,
                rgb(255, 0, 0) 73%,
                rgb(190, 0, 0) 83.8%,
                rgb(60, 0, 0) 100%
            );
        filter: saturate(0.7) brightness(0.85);
    }

    /* Raies survolables : un trait doré monte et l'étiquette donne la raie et son origine */
    .spectrum__band {
        position: relative;
    }

    .spectrum__line {
        position: absolute;
        top: -10px;
        bottom: 0;
        width: 12px;
        transform: translateX(-50%);
        cursor: help;
        outline: none;
    }

    .spectrum__line::before {
        content: "";
        position: absolute;
        left: 50%;
        bottom: 0;
        width: 1px;
        height: 10px;
        background: var(--color-primary);
        transform: scaleY(0);
        transform-origin: bottom;
        transition: transform 0.2s ease, height 0.2s ease;
    }

    .spectrum__line::after {
        content: attr(data-label);
        position: absolute;
        bottom: calc(100% + 6px);
        left: 50%;
        transform: translateX(-50%);
        padding: 0.2rem 0.5rem;
        white-space: nowrap;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.03em;
        color: var(--color-text);
        background: var(--color-background);
        border: 1px solid var(--color-border);
        /* Hors de la mise en page tant qu'elle est cachée : elle déborderait de l'écran sur mobile */
        display: none;
        pointer-events: none;
        z-index: 2;
    }

    .spectrum__line:hover::before,
    .spectrum__line:focus-visible::before {
        transform: scaleY(1);
        height: 20px;
    }

    .spectrum__line:hover::after,
    .spectrum__line:focus-visible::after {
        display: block;
    }

    /* Étiquettes des raies extrêmes : ancrées pour rester dans l'écran */
    .spectrum__line:nth-child(-n + 2)::after {
        left: 0;
        transform: none;
    }

    .spectrum__line:nth-child(n + 11)::after {
        left: auto;
        right: 0;
        transform: none;
    }

    .spectrum__line:nth-child(1) { left: 3.62%; }
    .spectrum__line:nth-child(2) { left: 4.54%; }
    .spectrum__line:nth-child(3) { left: 8.16%; }
    .spectrum__line:nth-child(4) { left: 13.73%; }
    .spectrum__line:nth-child(5) { left: 14.59%; }
    .spectrum__line:nth-child(6) { left: 28.68%; }
    .spectrum__line:nth-child(7) { left: 37.22%; }
    .spectrum__line:nth-child(8) { left: 39.73%; }
    .spectrum__line:nth-child(9) { left: 56.57%; }
    .spectrum__line:nth-child(10) { left: 74.68%; }
    .spectrum__line:nth-child(11) { left: 82.89%; }

    /* Petit écran : l'étiquette devient une bulle fixée en bas, sur toute la largeur */
    @media (max-width: 640px) {
        .spectrum__line::after,
        .spectrum__line:nth-child(-n + 2)::after,
        .spectrum__line:nth-child(n + 11)::after {
            position: fixed;
            left: var(--space-4);
            right: var(--space-4);
            bottom: var(--space-4);
            transform: none;
            white-space: normal;
            text-align: center;
            z-index: 200;
        }
    }

    :global(.light-theme) .spectrum__band::before {
        filter: saturate(0.75);
    }

    /* Graduations à 400, 500, 600 et 700 nm */
    .spectrum__scale {
        position: relative;
        height: 1.5rem;
        max-width: none;
        padding: 0;
        font-family: var(--font-mono);
        font-size: 0.625rem;
        color: var(--color-text-muted);
    }

    .spectrum__scale span {
        position: absolute;
        top: var(--space-1);
        transform: translateX(-50%);
        white-space: nowrap;
    }

    .spectrum__scale span:nth-child(1) { left: 5.41%; }
    .spectrum__scale span:nth-child(2) { left: 32.43%; }
    .spectrum__scale span:nth-child(3) { left: 59.46%; }
    .spectrum__scale span:nth-child(4) { left: 86.49%; }

    .footer__content {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: var(--space-12);
        margin-block-end: var(--space-12);
    }

    .footer__section {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
    }

    .footer__heading {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 400;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-text-muted);
    }

    .footer__section:first-child .footer__heading {
        font-family: var(--font-serif);
        font-size: var(--text-2xl);
        text-transform: none;
        letter-spacing: 0;
        color: var(--color-text);
    }

    .footer__text {
        font-size: var(--text-sm);
        color: var(--color-text-secondary);
        line-height: 1.6;
    }

    .footer__links {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
    }

    .footer__link {
        font-size: var(--text-sm);
        color: var(--color-text-secondary);
        transition: color var(--transition-fast);
    }

    .footer__link:hover {
        color: var(--color-primary);
    }

    .footer__bottom {
        display: flex;
        justify-content: space-between;
        gap: var(--space-4) var(--space-8);
        flex-wrap: wrap;
        padding-block-start: var(--space-8);
        border-top: 1px solid var(--color-border-subtle);
    }

    .footer__colophon {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-text-muted);
        max-width: 60ch;
    }

    .footer__copyright {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--color-text-muted);
        max-width: none;
    }

    .footer__hint {
        margin-block-start: var(--space-2);
    }

    .footer__hint-icon {
        background: none;
        border: none;
        color: var(--color-text-muted);
        opacity: 0.3;
        font-size: 0.7rem;
        cursor: pointer;
        min-width: 24px;
        min-height: 24px;
        padding: 0;
        transition:
            opacity var(--transition-fast),
            color var(--transition-fast);
    }

    .footer__hint-icon:hover {
        opacity: 0.6;
        color: var(--color-accent);
    }

    .footer__secrets {
        display: block;
        margin-block-start: var(--space-3);
        font-style: normal;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.04em;
        color: var(--color-primary);
        opacity: 0.8;
    }

    .footer__hint-text {
        font-size: 0.65rem;
        color: var(--color-text-muted);
        opacity: 0;
        max-height: 0;
        overflow: hidden;
        font-style: italic;
        line-height: 1.6;
        transition:
            opacity var(--transition-slow),
            max-height var(--transition-slow);
    }

    .footer__hint-text.visible {
        opacity: 0.45;
        max-height: 16em;
        margin-block-start: var(--space-2);
    }

    @media (max-width: 768px) {
        .footer__content {
            grid-template-columns: 1fr;
            gap: var(--space-8);
        }
    }
</style>

<script>
    import { foundSecrets, TOTAL_SECRETS } from "../scripts/secrets";

    document.getElementById("hint-toggle")?.addEventListener("click", () => {
        document.getElementById("hint-text")?.classList.toggle("visible");
    });

    // Compte des secrets découverts, affiché dès le premier
    const counter = document.querySelector<HTMLElement>("[data-secrets]");
    function showSecrets() {
        if (!counter) return;
        const n = foundSecrets().length;
        counter.hidden = n === 0;
        const template = n >= TOTAL_SECRETS ? counter.dataset.complete! : counter.dataset.template!;
        counter.textContent =
            "✦ " +
            template
                .replaceAll("{n}", String(n))
                .replaceAll("{total}", String(TOTAL_SECRETS))
                .replaceAll("{s}", n > 1 ? "s" : "");
    }
    showSecrets();
    document.addEventListener("secrets-updated", showSecrets);
</script>
