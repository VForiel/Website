---
interface Props {
  title: string;
  description: string;
  date?: Date;
  tags?: string[];
  image?: string;
  href?: string;
}

const { title, description, date, tags = [], image, href } = Astro.props;

const formattedDate = date ? new Intl.DateTimeFormat('fr-FR', { year: 'numeric', month: 'long' }).format(date) : null;
---

<article class="project-card">
  {image && (
    <div class="project-card__image">
      <img src={image} alt={title} loading="lazy" />
    </div>
  )}
  
  <div class="project-card__content">
    <h3 class="project-card__title">{title}</h3>
    
    {formattedDate && (
      <time class="project-card__date" datetime={date?.toISOString()}>
        {formattedDate}
      </time>
    )}
    
    <p class="project-card__description">{description}</p>
    
    {tags.length > 0 && (
      <ul class="project-card__tags">
        {tags.map((tag) => (
          <li class="project-card__tag">{tag}</li>
        ))}
      </ul>
    )}
    
    {href && (
      <a href={href} class="project-card__link" target="_blank" rel="noopener noreferrer">
        En savoir plus →
      </a>
    )}
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all var(--transition-base);
    height: 100%;
  }

  .project-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .project-card__image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--color-background-secondary);
  }

  .project-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .project-card:hover .project-card__image img {
    transform: scale(1.05);
  }

  .project-card__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    flex-grow: 1;
  }

  .project-card__title {
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-text);
  }

  .project-card__date {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .project-card__description {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1. 6;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: auto;
  }

  .project-card__tag {
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-3);
    background-color: var(--color-background-secondary);
    color: var(--color-text-secondary);
    border-radius: var(--radius-sm);
    font-weight: 500;
  }

  .project-card__link {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-primary);
    margin-block-start: var(--space-2);
    transition: color var(--transition-fast);
  }

  .project-card__link:hover {
    color: var(--color-primary-dark);
  }
</style>
