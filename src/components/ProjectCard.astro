---
interface Props {
  title: string;
  description: string;
  start_date?: Date;
  end_date?: Date;
  tags?: string[];
  image?: string;
  projectSlug?: string;  // Internal project page link
  externalUrl?: string;  // External URL (GitHub, etc.)
  lang?: 'fr' | 'en';
}

const { title, description, start_date, end_date, tags = [], image, projectSlug, externalUrl, lang = 'fr' } = Astro.props;

const formattedDate = end_date ? new Intl.DateTimeFormat(lang === 'fr' ? 'fr-FR' : 'en-US', { year: 'numeric', month: 'long' }).format(end_date) : null;
const projectLink = projectSlug ? `/${lang}/projects/${projectSlug}` : null;
const readMoreLabel = lang === 'fr' ? 'Lire la suite →' : 'Read more →';
const externalLinkLabel = lang === 'fr' ? 'Voir le projet →' : 'View project →';
---

<article class="project-card">
  {projectLink && <a href={projectLink} class="project-card__link-overlay" aria-label={title}></a>}
  
  {image && (
    <div class="project-card__image">
      <img src={image} alt={title} loading="lazy" />
    </div>
  )}
  
  <div class="project-card__content">
    <h3 class="project-card__title">{title}</h3>
    
    {formattedDate && (
      <time class="project-card__date" datetime={end_date?.toISOString()}>
        {formattedDate}
      </time>
    )}
    
    <p class="project-card__description">{description}</p>
    
    {tags.length > 0 && (
      <ul class="project-card__tags">
        {tags.map((tag) => (
          <li class="project-card__tag">{tag}</li>
        ))}
      </ul>
    )}
    
    <div class="project-card__actions">
      {projectLink && (
        <span class="project-card__read-more">{readMoreLabel}</span>
      )}
      {externalUrl && (
        <a 
          href={externalUrl} 
          class="project-card__external" 
          target="_blank" 
          rel="noopener noreferrer"
          onclick="event.stopPropagation()"
        >
          {externalLinkLabel}
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all var(--transition-base);
    height: 100%;
    position: relative;
    cursor: pointer;
  }

  .project-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .project-card__link-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .project-card__image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--color-background-secondary);
  }

  .project-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .project-card:hover .project-card__image img {
    transform: scale(1.05);
  }

  .project-card__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    flex-grow: 1;
  }

  .project-card__title {
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-text);
  }

  .project-card__date {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .project-card__description {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: auto;
  }

  .project-card__tag {
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-3);
    background-color: var(--color-background-secondary);
    color: var(--color-text-secondary);
    border-radius: var(--radius-sm);
    font-weight: 500;
  }

  .project-card__actions {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    margin-block-start: var(--space-2);
  }

  .project-card__read-more {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-primary);
  }

  .project-card__external {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-primary);
    position: relative;
    z-index: 2;
    transition: color var(--transition-fast);
  }

  .project-card__external:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }
</style>
