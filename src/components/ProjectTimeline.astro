---
interface Props {
  projects: Array<{
    slug: string;
    data: {
      title: string;
      description: string;
      date: Date;
      tags: string[];
      image?: any;
    };
  }>;
  lang: 'fr' | 'en';
}

const { projects, lang } = Astro.props;

// Extract all unique tags from all projects
const allTags = [...new Set(projects.flatMap(p => p.data.tags))].sort();

// Format date based on language
const formatDate = (date: Date) => {
  const options: Intl.DateTimeFormatOptions = { 
    year: 'numeric', 
    month: lang === 'fr' ? 'long' : 'long'
  };
  return new Intl.DateTimeFormat(lang === 'fr' ? 'fr-FR' : 'en-US', options).format(date);
};

const labels = {
  fr: {
    filterLabel: 'Filtrer par tags',
    allProjects: 'Tous les projets',
    noProjects: 'Aucun projet ne correspond aux filtres sélectionnés'
  },
  en: {
    filterLabel: 'Filter by tags',
    allProjects: 'All projects',
    noProjects: 'No projects match the selected filters'
  }
};

const t = labels[lang];
---

<div class="timeline-container">
  <div class="timeline-header">
    <h2 class="section-title">{t.allProjects}</h2>
    <div class="tag-filter">
      <span class="filter-label">{t.filterLabel}:</span>
      <div class="tag-list" id="tag-filter">
        {allTags.map(tag => (
          <button 
            class="tag-button active" 
            data-tag={tag}
            type="button"
          >
            {tag}
          </button>
        ))}
      </div>
    </div>
  </div>

  <div class="timeline" id="timeline">
    {projects.map((project) => {
      const cleanSlug = project.slug.replace(new RegExp(`${lang}$`), '');
      return (
        <div class="timeline-item" data-tags={JSON.stringify(project.data.tags)}>
          <div class="timeline-date">
            <span>{formatDate(project.data.date)}</span>
          </div>
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <a href={`/${lang}/projects/${cleanSlug}`} class="timeline-card">
              <div class="mobile-date">{formatDate(project.data.date)}</div>
              <h3>{project.data.title}</h3>
              <p class="description">{project.data.description}</p>
              <div class="project-tags">
                {project.data.tags.map(tag => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </a>
          </div>
        </div>
      );
    })}
  </div>

  <div class="no-results" id="no-results" style="display: none;">
    <p>{t.noProjects}</p>
  </div>
</div>

<script>
  // Tag filtering logic
  const tagButtons = document.querySelectorAll('.tag-button');
  const timelineItems = document.querySelectorAll('.timeline-item');
  const noResults = document.getElementById('no-results');
  
  let selectedTags = new Set(Array.from(tagButtons).map(btn => btn.getAttribute('data-tag')));

  tagButtons.forEach(button => {
    button.addEventListener('click', () => {
      const tag = button.getAttribute('data-tag');
      
      if (selectedTags.has(tag)) {
        selectedTags.delete(tag);
        button.classList.remove('active');
      } else {
        selectedTags.add(tag);
        button.classList.add('active');
      }
      
      filterProjects();
    });
  });

  function filterProjects() {
    let visibleCount = 0;
    
    timelineItems.forEach(item => {
      const itemTags = JSON.parse(item.getAttribute('data-tags') || '[]');
      const hasMatchingTag = itemTags.some(tag => selectedTags.has(tag));
      
      if (selectedTags.size === 0 || hasMatchingTag) {
        item.style.display = 'grid';
        item.classList.add('visible');
        visibleCount++;
      } else {
        item.style.display = 'none';
        item.classList.remove('visible');
      }
    });
    
    if (visibleCount === 0) {
      noResults.style.display = 'block';
    } else {
      noResults.style.display = 'none';
    }
  }

  // Initial state: all visible
  filterProjects();

  // Intersection Observer for scroll animations
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('animate-in');
      }
    });
  }, {
    threshold: 0.1
  });

  timelineItems.forEach(item => {
    observer.observe(item);
  });
</script>

<style>
  .timeline-container {
    width: 100%;
  }

  .timeline-header {
    margin-block-end: var(--space-12);
  }

  .section-title {
    font-size: var(--text-2xl);
    margin-block-end: var(--space-6);
  }

  .tag-filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--color-background-secondary);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
  }

  .filter-label {
    font-weight: 500;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag-button {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    border: 2px solid var(--color-border);
    background: transparent;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tag-button:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    transform: translateY(-1px);
  }

  .tag-button.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: white;
  }

  .timeline {
    position: relative;
    padding-block: var(--space-8);
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 180px 40px 1fr;
    gap: var(--space-6);
    margin-block-end: var(--space-10);
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.5s ease;
    position: relative;
  }

  .timeline-item.visible {
    opacity: 1;
  }

  .timeline-item.animate-in {
    opacity: 1;
    transform: translateY(0);
  }

  .timeline-date {
    text-align: right;
    padding-top: 4px;
  }

  .timeline-date span {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    display: inline-block;
  }

  .timeline-marker {
    position: relative;
    width: 40px;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  /* Vertical line segment */
  .timeline-marker::before {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    top: 0;
    height: calc(100% + var(--space-10) + 40px);
    width: 2px;
    background: var(--color-primary);
    z-index: 0;
  }

  /* Gradient for first item */
  .timeline-item:first-child .timeline-marker::before {
    background: linear-gradient(
      to bottom,
      transparent,
      var(--color-primary) 10%
    );
  }

  /* Gradient for last item */
  .timeline-item:last-child .timeline-marker::before {
    height: 100%;
    background: linear-gradient(
      to bottom,
      var(--color-primary),
      var(--color-primary) 80%,
      transparent
    );
  }

  /* Marker circle */
  .timeline-marker::after {
    content: '';
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-primary);
    border: 3px solid var(--color-background);
    box-shadow: 0 0 0 2px var(--color-primary);
    transition: all 0.3s ease;
    margin-top: 4px;
    position: relative;
    z-index: 1;
  }

  .mobile-date {
    display: none;
  }

  .timeline-item:hover .timeline-marker::after {
    transform: scale(1.3);
    box-shadow: 0 0 0 4px var(--color-primary-light);
  }

  .timeline-content {
    padding-block-start: 0;
  }

  .timeline-card {
    display: block;
    padding: var(--space-6);
    background: var(--color-background-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: all 0.3s ease;
    text-decoration: none;
    color: inherit;
  }

  .timeline-card:hover {
    transform: translateX(8px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-primary);
  }

  .timeline-card h3 {
    font-size: var(--text-xl);
    margin-block-end: var(--space-3);
    color: var(--color-text);
  }

  .timeline-card .description {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    margin-block-end: var(--space-4);
    line-height: 1.6;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .project-tags .tag {
    padding: var(--space-1) var(--space-3);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  .no-results {
    text-align: center;
    padding: var(--space-12);
    color: var(--color-text-secondary);
  }

  .no-results p {
    font-size: var(--text-lg);
  }

  /* Responsive design */
  @media (max-width: 768px) {

    .timeline-item {
      grid-template-columns: 40px 1fr;
      gap: var(--space-4);
    }

    .timeline-date {
      display: none;
    }

    .mobile-date {
      display: block;
      font-size: var(--text-xs);
      color: var(--color-text-secondary);
      margin-block-end: var(--space-2);
      font-weight: 500;
    }

    .timeline-marker {
      width: 40px;
    }

    .timeline-card {
      padding: var(--space-4);
    }

    .timeline-card:hover {
      transform: translateX(4px);
    }

    .tag-filter {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
