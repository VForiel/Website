---
// Animated background with particles and connections
// Scientific/constellation theme
---

<div class="particles-bg" id="particles-bg">
    <canvas id="particles-canvas"></canvas>
</div>

<div id="polaris-modal" class="polaris-modal hidden">
    <div class="modal-content">
        <button id="close-polaris" class="close-btn" aria-label="Close"
            >✕</button
        >

        <!-- French -->
        <div class="polaris-lang" data-lang="fr">
            <div class="modal-header">
                <h3>L'Étoile Polaire</h3>
                <div class="header-line"></div>
            </div>
            <div class="modal-body">
                <p>
                    Bravo, vous avez repéré l'étoile polaire ! Cette étoile
                    indique le nord et a guidé les voyageurs pendant des
                    millénaires. Voici une petite anecdote personnelle :
                </p>
                <p>
                    J'ai un jour utilisé cette étoile pour guider une amie hors
                    d'une forêt, en pleine nuit de mars. Alors qu'elle s'était
                    isolée pour profiter du calme nocturne, son téléphone est
                    tombé et l'écran s'est brisé. Inquiet après 30 minutes sans
                    nouvelles, je l'ai appelée ; elle a pu décrocher grâce au
                    bouton physique du téléphone.
                </p>
                <p>
                    Elle était hors des sentiers, totalement égarée. Par chance,
                    le ciel était parfaitement dégagé. En consultant Google
                    Maps, j'ai repéré des chemins résidentiels à l'est de sa
                    dernière position connue. Je lui ai alors expliqué comment
                    trouver l'étoile polaire (en repérant la Grande Ourse puis
                    en prolongeant cinq fois son dernier segment), puis je lui
                    ai demandé de marcher droit devant elle en gardant l'étoile
                    sur sa gauche.
                </p>
                <p>
                    Quinze minutes plus tard, elle débouchait sur une route et
                    me donnait le nom d'une école, ce qui nous a permis de la
                    localiser précisément. Ce soir-là, une simple connaissance
                    d'astronomie lui a probablement évité une nuit glaciale en
                    forêt. Comme quoi, il n'y a aucun savoir inutile.
                </p>
            </div>
        </div>

        <!-- English -->
        <div class="polaris-lang" data-lang="en" style="display:none;">
            <div class="modal-header">
                <h3>The North Star</h3>
                <div class="header-line"></div>
            </div>
            <div class="modal-body">
                <p>
                    Well done, you've spotted the North Star! This star
                    indicates true north and has guided travelers for millennia.
                    Here's a personal anecdote about it:
                </p>
                <p>
                    I once used this star to guide a friend out of a forest on a
                    cold March night. She had stayed behind to enjoy the quiet
                    and the night sky, when her phone slipped and the screen
                    shattered. Worried after 30 minutes with no news, I called
                    her; she was able to answer using the physical button on the
                    side of her phone.
                </p>
                <p>
                    She was off-trail, completely lost. Luckily, the sky was
                    perfectly clear. Using Google Maps, I found small
                    residential paths east of her last known position. I then
                    explained how to find the North Star (by spotting the Big
                    Dipper and extending its last segment about five times), and
                    asked her to walk straight ahead, keeping the star to her
                    left.
                </p>
                <p>
                    Fifteen minutes later, she reached a road and gave me the
                    name of a school, which let us pinpoint her location. That
                    night, a simple piece of astronomical knowledge probably
                    saved her from spending a freezing night in the woods. No
                    knowledge is ever truly useless.
                </p>
            </div>
        </div>
    </div>
</div>

<script>
    class ParticleSystem {
        constructor(canvas) {
            this.canvas = canvas;
            this.ctx = canvas.getContext("2d");
            this.particles = [];
            this.shootingStars = [];
            this.binaryDigits = [];
            this.particleCount = window.innerWidth < 768 ? 40 : 100; // Drastically reduced for performance
            this.binaryCount = 40;
            this.maxDistance = 100;
            this.maxDistanceSquared = 100 * 100;
            this.mouse = {
                x: null,
                y: null,
                radius: 100,
                radiusSquared: 100 * 100,
            };
            this.lastShootingStar = 0;
            this.shootingStarInterval = 1500;
            this.isLightTheme = false;
            this.lastFrameTime = 0;
            this.targetFPS = 60;
            this.frameInterval = 1000 / 60; // ~16ms between frames

            this.constellation = [];
            this.showConstellation = false;
            this.isModalOpen = false;

            this.init();
            this.animate();
            this.addEventListeners();
            this.checkTheme();
        }

        init() {
            this.resize();
            this.createParticles();
            this.createBinaryDigits();
            this.createConstellation();
        }

        checkTheme() {
            this.isLightTheme =
                document.documentElement.classList.contains("light-theme");
            // Use MutationObserver instead of setInterval for efficiency
            const observer = new MutationObserver(() => {
                this.isLightTheme =
                    document.documentElement.classList.contains("light-theme");
            });
            observer.observe(document.documentElement, {
                attributes: true,
                attributeFilter: ["class"],
            });
        }

        resize() {
            this.canvas.width = window.innerWidth;
            this.canvas.height = window.innerHeight;
        }

        createParticles() {
            this.particles = [];
            for (let i = 0; i < this.particleCount; i++) {
                this.particles.push({
                    x: Math.random() * this.canvas.width,
                    y: Math.random() * this.canvas.height,
                    vx: (Math.random() - 0.5) * 0.375, // 1.5x speed
                    vy: (Math.random() - 0.5) * 0.375, // 1.5x speed
                    radius: Math.random() * 1.5 + 0.5,
                    opacity: Math.random() * 0.5 + 0.3,
                    baseVx: (Math.random() - 0.5) * 0.15, // 1.5x speed
                    baseVy: (Math.random() - 0.5) * 0.15, // 1.5x speed
                });
            }
        }

        createBinaryDigits() {
            // Create scattered binary nodes similar to particles
            this.binaryDigits = [];
            const numNodes = window.innerWidth < 768 ? 40 : 80;

            for (let i = 0; i < numNodes; i++) {
                this.binaryDigits.push({
                    x: Math.random() * this.canvas.width,
                    y: Math.random() * this.canvas.height,
                    vx: (Math.random() - 0.5) * 0.9, // 1.5x original speed
                    vy: (Math.random() - 0.5) * 0.9, // 1.5x original speed
                    baseVx: (Math.random() - 0.5) * 0.45, // 1.5x original speed
                    baseVy: (Math.random() - 0.5) * 0.45, // 1.5x original speed
                    value: Math.random() > 0.5 ? "1" : "0",
                    nextFlip: Date.now() + Math.random() * 700 + 300,
                });
            }
        }

        addEventListeners() {
            window.addEventListener("resize", () => this.handleResize());
            window.addEventListener("mousemove", (e) =>
                this.handleMouseMove(e),
            );
            window.addEventListener("click", (e) => this.handleClick(e));
            document.addEventListener("mouseleave", () =>
                this.handleMouseLeave(),
            );

            // Modal listeners
            document
                .getElementById("close-polaris")
                ?.addEventListener("click", () => this.closePolarisModal());
            document
                .getElementById("polaris-modal")
                ?.addEventListener("click", (e) => {
                    if (e.target === e.currentTarget) this.closePolarisModal();
                });
        }

        handleResize() {
            this.resize();
            this.createParticles();
            this.createBinaryDigits();
            this.createConstellation();
        }

        createConstellation() {
            if (this.isLightTheme) {
                this.constellation = [];
                return;
            }

            // Exact normalized positions (max norm = 1)
            // Coordinates provided by the user
            const relativePoints = [
                { x: -0.2335, y: 0.5948, id: 0 }, // Alkaid
                { x: -0.1665, y: 0.3001, id: 1 }, // Mizar
                { x: -0.0406, y: 0.2036, id: 2 }, // Alioth
                { x: 0.1009, y: 0.071, id: 3 }, // Megrez
                { x: 0.2765, y: 0.1219, id: 4 }, // Phecda
                { x: 0.3762, y: -0.1538, id: 5 }, // Merak
                { x: 0.2003, y: -0.2794, id: 6 }, // Dubhe
                { x: -0.5133, y: -0.8582, id: 7 }, // Polaris
            ];

            // Since max norm is 1, we can use scale = fraction of min(w,h)
            // and guarantee all stars fit with buffer on any rotation
            const minDim = Math.min(this.canvas.width, this.canvas.height);
            const buffer = 60;
            const maxScale = minDim / 2 - buffer; // max possible
            const scale = maxScale * (0.6 + Math.random() * 0.35);
            const rotation = Math.random() * Math.PI * 2;
            const centerX =
                buffer +
                scale +
                Math.random() * (this.canvas.width - 2 * (buffer + scale));
            const centerY =
                buffer +
                scale +
                Math.random() * (this.canvas.height - 2 * (buffer + scale));

            this.constellation = relativePoints.map((p) => {
                const cos = Math.cos(rotation);
                const sin = Math.sin(rotation);
                const rx = (p.x * cos - p.y * sin) * scale;
                const ry = (p.x * sin + p.y * cos) * scale;
                return {
                    x: centerX + rx,
                    y: centerY + ry,
                    radius: Math.random() * 0.5 + 1.0,
                    opacity: 0.4 + Math.random() * 0.4,
                    id: p.id,
                    isPolaris: p.id === 7,
                };
            });
        }

        handleClick(e) {
            if (this.isLightTheme || this.isModalOpen) return;
            const rect = this.canvas.getBoundingClientRect();
            const scaleX = this.canvas.width / rect.width;
            const scaleY = this.canvas.height / rect.height;
            const x = (e.clientX - rect.left) * scaleX;
            const y = (e.clientY - rect.top) * scaleY;

            const polaris = this.constellation.find((s) => s.isPolaris);
            if (polaris) {
                const distSq =
                    Math.pow(polaris.x - x, 2) + Math.pow(polaris.y - y, 2);
                if (distSq < 400) {
                    // 20px radius hit area
                    this.openPolarisModal();
                }
            }
        }

        openPolarisModal() {
            const modal = document.getElementById("polaris-modal");
            if (modal) {
                // Detect locale from current URL
                const lang = window.location.pathname.includes("/en")
                    ? "en"
                    : "fr";
                modal.querySelectorAll(".polaris-lang").forEach((el) => {
                    el.style.display = el.dataset.lang === lang ? "" : "none";
                });
                modal.classList.remove("hidden");
                this.isModalOpen = true;
            }
        }

        closePolarisModal() {
            const modal = document.getElementById("polaris-modal");
            if (modal) {
                modal.classList.add("hidden");
                this.isModalOpen = false;
            }
        }

        handleMouseMove(e) {
            const rect = this.canvas.getBoundingClientRect();
            const scaleX = this.canvas.width / rect.width;
            const scaleY = this.canvas.height / rect.height;
            this.mouse.x = (e.clientX - rect.left) * scaleX;
            this.mouse.y = (e.clientY - rect.top) * scaleY;
        }

        handleMouseLeave() {
            this.mouse.x = null;
            this.mouse.y = null;
        }

        // Spatial grid for efficient neighbor lookup
        buildSpatialGrid(items, cellSize) {
            const grid = new Map();
            const cols = Math.ceil(this.canvas.width / cellSize);

            for (let i = 0; i < items.length; i++) {
                const item = items[i];
                const cellX = Math.floor(item.x / cellSize);
                const cellY = Math.floor(item.y / cellSize);
                const key = cellY * cols + cellX;

                if (!grid.has(key)) {
                    grid.set(key, []);
                }
                grid.get(key).push(i);
            }
            return { grid, cols, cellSize };
        }

        getNeighborIndices(itemIndex, items, spatialData) {
            const { grid, cols, cellSize } = spatialData;
            const item = items[itemIndex];
            const cellX = Math.floor(item.x / cellSize);
            const cellY = Math.floor(item.y / cellSize);
            const neighbors = [];

            // Check 3x3 grid of cells around current cell
            for (let dy = -1; dy <= 1; dy++) {
                for (let dx = -1; dx <= 1; dx++) {
                    const key = (cellY + dy) * cols + (cellX + dx);
                    const cell = grid.get(key);
                    if (cell) {
                        for (const idx of cell) {
                            if (idx > itemIndex) {
                                // Only check each pair once
                                neighbors.push(idx);
                            }
                        }
                    }
                }
            }
            return neighbors;
        }

        updateBinaryDigits() {
            const now = Date.now();

            this.binaryDigits.forEach((node) => {
                // Apply base drift for continuous movement
                node.vx += (node.baseVx - node.vx) * 0.02;
                node.vy += (node.baseVy - node.vy) * 0.02;

                // Mouse interaction - gentle repulsion (light theme only)
                if (this.mouse.x !== null && this.mouse.y !== null) {
                    const dx = node.x - this.mouse.x;
                    const dy = node.y - this.mouse.y;
                    const distSq = dx * dx + dy * dy;
                    if (distSq < this.mouse.radiusSquared) {
                        const dist = Math.sqrt(distSq);
                        const angle = Math.atan2(dy, dx);
                        const force =
                            (this.mouse.radius - dist) / this.mouse.radius;
                        node.vx += Math.cos(angle) * force * 0.3;
                        node.vy += Math.sin(angle) * force * 0.3;
                    }
                }

                // Update position
                node.x += node.vx;
                node.y += node.vy;

                // Bounce off edges
                if (node.x < 0 || node.x > this.canvas.width) {
                    node.vx *= -1;
                    node.baseVx *= -1;
                    node.x = Math.max(0, Math.min(this.canvas.width, node.x));
                }
                if (node.y < 0 || node.y > this.canvas.height) {
                    node.vy *= -1;
                    node.baseVy *= -1;
                    node.y = Math.max(0, Math.min(this.canvas.height, node.y));
                }

                // Flip binary value
                if (now > node.nextFlip) {
                    node.value = node.value === "1" ? "0" : "1";
                    node.nextFlip = now + Math.random() * 700 + 300;
                }
            });
        }

        createShootingStar() {
            const now = Date.now();
            if (now - this.lastShootingStar < this.shootingStarInterval) return;

            // Random chance (20% when called)
            if (Math.random() > 0.2) return;

            this.lastShootingStar = now;

            // Start from top, left, or right edge
            const perimeter = this.canvas.width + this.canvas.height * 2;
            const spawnPos = Math.random() * perimeter;

            let x, y, angle;

            if (spawnPos < this.canvas.width) {
                // Top edge
                x = spawnPos;
                y = 0;
                // Angle: Generally down (45 to 135 degrees)
                angle = Math.PI / 4 + Math.random() * (Math.PI / 2);
            } else if (spawnPos < this.canvas.width + this.canvas.height) {
                // Left edge
                x = 0;
                y = spawnPos - this.canvas.width;
                // Angle: Down and Right (10 to 80 degrees)
                angle = 0.2 + Math.random() * (Math.PI / 2 - 0.4);
            } else {
                // Right edge
                x = this.canvas.width;
                y = spawnPos - (this.canvas.width + this.canvas.height);
                // Angle: Down and Left (100 to 170 degrees)
                angle = Math.PI / 2 + 0.2 + Math.random() * (Math.PI / 2 - 0.4);
            }

            const speed = 8 + Math.random() * 4; // Restored to original speed (Doubled from previous step)

            this.shootingStars.push({
                x,
                y,
                vx: Math.cos(angle) * speed,
                vy: Math.sin(angle) * speed,
                length: 40 + Math.random() * 30,
                opacity: 1,
                tail: [],
            });
        }

        updateShootingStars() {
            this.shootingStars = this.shootingStars.filter((star) => {
                // Update position
                star.x += star.vx;
                star.y += star.vy;

                // Add to tail
                star.tail.push({ x: star.x, y: star.y });
                if (star.tail.length > 15) {
                    star.tail.shift();
                }

                // Fade out near end of screen
                if (star.x < 0 || star.y > this.canvas.height) {
                    star.opacity -= 0.05;
                }

                // Remove if off screen or faded
                return (
                    star.opacity > 0 &&
                    star.x > -100 &&
                    star.y < this.canvas.height + 100
                );
            });
        }

        update() {
            // Try to create shooting star occasionally (dark theme only)
            if (!this.isLightTheme && Math.random() < 0.03) {
                this.createShootingStar();
            }

            // Update based on theme
            if (this.isLightTheme) {
                this.updateBinaryDigits();
            } else {
                this.updateShootingStars();
            }
            this.particles.forEach((particle) => {
                // Apply base drift for continuous movement
                particle.vx += (particle.baseVx - particle.vx) * 0.02;
                particle.vy += (particle.baseVy - particle.vy) * 0.02;

                // Update position
                particle.x += particle.vx;
                particle.y += particle.vy;

                // Bounce off edges
                if (particle.x < 0 || particle.x > this.canvas.width) {
                    particle.vx *= -1;
                    particle.baseVx *= -1;
                    particle.x = Math.max(
                        0,
                        Math.min(this.canvas.width, particle.x),
                    );
                }
                if (particle.y < 0 || particle.y > this.canvas.height) {
                    particle.vy *= -1;
                    particle.baseVy *= -1;
                    particle.y = Math.max(
                        0,
                        Math.min(this.canvas.height, particle.y),
                    );
                }
            });

            // Check hover for constellation (dark theme only)
            if (!this.isLightTheme && this.mouse.x !== null) {
                let hovering = false;
                for (const star of this.constellation) {
                    const distSq =
                        Math.pow(star.x - this.mouse.x, 2) +
                        Math.pow(star.y - this.mouse.y, 2);
                    if (distSq < 64) {
                        // 8px radius
                        hovering = true;
                        break;
                    }
                }
                this.showConstellation = hovering;
            } else {
                this.showConstellation = false;
            }
        }

        draw() {
            this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

            if (this.isLightTheme) {
                // Light theme: Scattered binary network
                const maxDistance = 350;
                const maxDistanceSquared = 350 * 350;
                const nodeRadius = 12; // Distance at which connections stop

                // Draw connections between nearby nodes using spatial grid
                this.ctx.lineWidth = 0.5;

                const spatialData = this.buildSpatialGrid(
                    this.binaryDigits,
                    maxDistance,
                );

                for (let i = 0; i < this.binaryDigits.length; i++) {
                    const neighbors = this.getNeighborIndices(
                        i,
                        this.binaryDigits,
                        spatialData,
                    );
                    for (const j of neighbors) {
                        const dx =
                            this.binaryDigits[i].x - this.binaryDigits[j].x;
                        const dy =
                            this.binaryDigits[i].y - this.binaryDigits[j].y;
                        const distanceSquared = dx * dx + dy * dy;
                        if (distanceSquared < maxDistanceSquared) {
                            const distance = Math.sqrt(distanceSquared);
                            // Calculate points that stop before reaching the nodes
                            const angle = Math.atan2(dy, dx);
                            const x1 =
                                this.binaryDigits[i].x -
                                Math.cos(angle) * nodeRadius;
                            const y1 =
                                this.binaryDigits[i].y -
                                Math.sin(angle) * nodeRadius;
                            const x2 =
                                this.binaryDigits[j].x +
                                Math.cos(angle) * nodeRadius;
                            const y2 =
                                this.binaryDigits[j].y +
                                Math.sin(angle) * nodeRadius;

                            const opacity = (1 - distance / maxDistance) * 0.25; // Increased from 0.15
                            this.ctx.strokeStyle = `rgba(100, 120, 150, ${opacity})`;
                            this.ctx.beginPath();
                            this.ctx.moveTo(x1, y1);
                            this.ctx.lineTo(x2, y2);
                            this.ctx.stroke();
                        }
                    }
                }

                // Draw binary digits only (no circles)
                this.ctx.font = '11px "Courier New", monospace';
                this.ctx.textAlign = "center";
                this.ctx.textBaseline = "middle";
                this.ctx.fillStyle = "rgba(80, 100, 130, 0.7)"; // Slightly increased opacity

                this.binaryDigits.forEach((node) => {
                    this.ctx.fillText(node.value, node.x, node.y);
                });
            } else {
                // Dark theme: Shooting stars and particles
                // Draw shooting stars first (behind particles)
                this.shootingStars.forEach((star) => {
                    // Draw tail gradient
                    if (star.tail.length > 1) {
                        for (let i = 0; i < star.tail.length - 1; i++) {
                            const progress = i / star.tail.length;
                            const opacity = progress * star.opacity * 0.5;

                            this.ctx.strokeStyle = `rgba(200, 230, 255, ${opacity})`;
                            this.ctx.lineWidth = 2 * (1 - progress);
                            this.ctx.beginPath();
                            this.ctx.moveTo(star.tail[i].x, star.tail[i].y);
                            this.ctx.lineTo(
                                star.tail[i + 1].x,
                                star.tail[i + 1].y,
                            );
                            this.ctx.stroke();
                        }
                    }

                    // Draw bright head (simple circle instead of gradient for performance)
                    this.ctx.fillStyle = `rgba(255, 255, 255, ${star.opacity})`;
                    this.ctx.beginPath();
                    this.ctx.arc(star.x, star.y, 3, 0, Math.PI * 2);
                    this.ctx.fill();
                    // Outer glow
                    this.ctx.fillStyle = `rgba(200, 230, 255, ${star.opacity * 0.4})`;
                    this.ctx.beginPath();
                    this.ctx.arc(star.x, star.y, 5, 0, Math.PI * 2);
                    this.ctx.fill();
                });
            }

            // Draw connections and particles (dark theme only)
            if (!this.isLightTheme) {
                this.ctx.strokeStyle = "rgba(100, 160, 255, 0.15)";
                this.ctx.lineWidth = 1;

                const spatialData = this.buildSpatialGrid(
                    this.particles,
                    this.maxDistance,
                );

                // Track connection count per particle (max 3)
                const connectionCount = new Uint8Array(this.particles.length);

                for (let i = 0; i < this.particles.length; i++) {
                    if (connectionCount[i] >= 3) continue;
                    const neighbors = this.getNeighborIndices(
                        i,
                        this.particles,
                        spatialData,
                    );
                    for (const j of neighbors) {
                        if (connectionCount[i] >= 3 || connectionCount[j] >= 3)
                            continue;
                        const dx = this.particles[i].x - this.particles[j].x;
                        const dy = this.particles[i].y - this.particles[j].y;
                        const distanceSquared = dx * dx + dy * dy;
                        if (distanceSquared < this.maxDistanceSquared) {
                            const distance = Math.sqrt(distanceSquared);
                            const opacity =
                                (1 - distance / this.maxDistance) * 0.2;
                            this.ctx.strokeStyle = `rgba(100, 160, 255, ${opacity})`;
                            this.ctx.beginPath();
                            this.ctx.moveTo(
                                this.particles[i].x,
                                this.particles[i].y,
                            );
                            this.ctx.lineTo(
                                this.particles[j].x,
                                this.particles[j].y,
                            );
                            this.ctx.stroke();
                            connectionCount[i]++;
                            connectionCount[j]++;
                        }
                    }
                }

                // Draw particles
                this.particles.forEach((particle) => {
                    this.ctx.fillStyle = `rgba(200, 220, 255, ${particle.opacity})`;
                    this.ctx.beginPath();
                    this.ctx.arc(
                        particle.x,
                        particle.y,
                        particle.radius,
                        0,
                        Math.PI * 2,
                    );
                    this.ctx.fill();
                });

                // --- DRAW POLARIS CONSTELLATION ---
                // Draw stars first (fixed)
                this.constellation.forEach((star) => {
                    this.ctx.fillStyle = `rgba(200, 220, 255, ${star.opacity})`;
                    this.ctx.beginPath();
                    this.ctx.arc(star.x, star.y, star.radius, 0, Math.PI * 2);
                    this.ctx.fill();

                    if (star.isPolaris) {
                        // Polaris has extra glow
                        this.ctx.shadowBlur = 10;
                        this.ctx.shadowColor = "rgba(100, 160, 255, 0.5)";
                        this.ctx.fill();
                        this.ctx.shadowBlur = 0;

                        this.ctx.fillStyle = `rgba(100, 160, 255, ${star.opacity * 0.3})`;
                        this.ctx.beginPath();
                        this.ctx.arc(
                            star.x,
                            star.y,
                            star.radius * 2.5,
                            0,
                            Math.PI * 2,
                        );
                        this.ctx.fill();
                    }
                });

                // Draw lines if hovered
                if (this.showConstellation) {
                    this.ctx.strokeStyle = "rgba(100, 160, 255, 0.35)";
                    this.ctx.lineWidth = 1;
                    this.ctx.setLineDash([4, 4]);

                    // Segments: 0-1-2-3-4-5-6-3 (Polaris)
                    // Segments:
                    // Handle: 0-1, 1-2, 2-3
                    // Bowl: 3-4, 4-5, 5-6, 6-3
                    const segments = [
                        [0, 1],
                        [1, 2],
                        [2, 3], // Handle
                        [3, 4],
                        [4, 5],
                        [5, 6],
                        [6, 3], // Bowl
                    ];

                    segments.forEach((seg) => {
                        const s1 = this.constellation[seg[0]];
                        const s2 = this.constellation[seg[1]];
                        this.ctx.beginPath();
                        this.ctx.moveTo(s1.x, s1.y);
                        this.ctx.lineTo(s2.x, s2.y);
                        this.ctx.stroke();
                    });
                    this.ctx.setLineDash([]);
                }
            }
        }

        animate(currentTime = 0) {
            requestAnimationFrame((time) => this.animate(time));

            // Limit to target FPS
            const elapsed = currentTime - this.lastFrameTime;
            if (elapsed < this.frameInterval) return;
            this.lastFrameTime = currentTime - (elapsed % this.frameInterval);

            this.update();
            this.draw();
        }
    }

    // Initialize particle system
    const canvas = document.getElementById("particles-canvas");
    if (canvas) {
        new ParticleSystem(canvas);
    }
</script>

