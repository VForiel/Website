---
// Animated background with particles and connections
// Scientific/constellation theme
---

<div class="particles-bg" id="particles-bg">
  <canvas id="particles-canvas"></canvas>
</div>

<script>
  class ParticleSystem {
    constructor(canvas) {
      this.canvas = canvas;
      this.ctx = canvas.getContext('2d');
      this.particles = [];
      this.shootingStars = [];
      this.binaryDigits = [];
      this.particleCount = 60;
      this.binaryCount = 40;
      this.maxDistance = 150;
      this.mouse = { x: null, y: null, radius: 100 };
      this.lastShootingStar = 0;
      this.shootingStarInterval = 3000;
      this.isLightTheme = false;
      
      this.init();
      this.animate();
      this.addEventListeners();
      this.checkTheme();
    }
    
    init() {
      this.resize();
      this.createParticles();
      this.createBinaryDigits();
    }
    
    checkTheme() {
      this.isLightTheme = document.documentElement.classList.contains('light-theme');
      // Re-check theme periodically
      setInterval(() => {
        this.isLightTheme = document.documentElement.classList.contains('light-theme');
      }, 500);
    }
    
    resize() {
      this.canvas.width = window.innerWidth;
      this.canvas.height = Math.min(window.innerHeight * 0.8, 800);
    }
    
    createParticles() {
      this.particles = [];
      for (let i = 0; i < this.particleCount; i++) {
        this.particles.push({
          x: Math.random() * this.canvas.width,
          y: Math.random() * this.canvas.height,
          vx: (Math.random() - 0.5) * 0.5, // Increased base velocity
          vy: (Math.random() - 0.5) * 0.5,
          radius: Math.random() * 1.5 + 0.5,
          opacity: Math.random() * 0.5 + 0.3,
          baseVx: (Math.random() - 0.5) * 0.2, // Continuous drift
          baseVy: (Math.random() - 0.5) * 0.2
        });
      }
    }
    
    addEventListeners() {
      window.addEventListener('resize', () => this.handleResize());
      this.canvas.addEventListener('mousemove', (e) => this.handleMouseMove(e));
      this.canvas.addEventListener('mouseleave', () => this.handleMouseLeave());
    }
    
    handleResize() {
      this.resize();
      this.createParticles();
    }
    
    handleMouseMove(e) {
      this.mouse.x = e.clientX;
      this.mouse.y = e.clientY;
    }
    
    handleMouseLeave() {
      this.mouse.x = null;
      this.mouse.y = null;
    }
    
    createBinaryDigits() {
      // Create grid points for technical mesh
      this.binaryDigits = [];
      const spacing = 80;
      const cols = Math.ceil(this.canvas.width / spacing) + 1;
      const rows = Math.ceil(this.canvas.height / spacing) + 1;
      
      for (let i = 0; i < cols; i++) {
        for (let j = 0; j < rows; j++) {
          this.binaryDigits.push({
            baseX: i * spacing,
            baseY: j * spacing,
            x: i * spacing,
            y: j * spacing,
            offsetX: 0,
            offsetY: 0,
            phase: Math.random() * Math.PI * 2,
            value: Math.random() > 0.5 ? '1' : '0',
            nextFlip: Date.now() + Math.random() * 700 + 300 // Flip every 0.3-1 second
          });
        }
      }
    }
    
    updateBinaryDigits() {
      const time = Date.now() * 0.0005; // Slow animation
      const now = Date.now();
      
      this.binaryDigits.forEach(point => {
        // Gentle wave motion
        point.offsetX = Math.sin(time + point.phase) * 15;
        point.offsetY = Math.cos(time * 0.7 + point.phase) * 15;
        point.x = point.baseX + point.offsetX;
        point.y = point.baseY + point.offsetY;
        
        // Flip binary value
        if (now > point.nextFlip) {
          point.value = point.value === '1' ? '0' : '1';
          point.nextFlip = now + Math.random() * 700 + 300;
        }
      });
    }
    
    createShootingStar() {
      const now = Date.now();
      if (now - this.lastShootingStar < this.shootingStarInterval) return;
      
      // Random chance (20% when called)
      if (Math.random() > 0.2) return;
      
      this.lastShootingStar = now;
      
      // Start from top or right edge
      const fromTop = Math.random() > 0.5;
      const x = fromTop ? Math.random() * this.canvas.width : this.canvas.width;
      const y = fromTop ? 0 : Math.random() * this.canvas.height * 0.3;
      
      // Shooting stars go down and to the left
      const angle = fromTop ? Math.PI / 4 + (Math.random() - 0.5) * 0.3 : Math.PI / 3;
      const speed = 8 + Math.random() * 4;
      
      this.shootingStars.push({
        x,
        y,
        vx: Math.cos(angle) * speed * (fromTop ? 1 : -1),
        vy: Math.sin(angle) * speed,
        length: 40 + Math.random() * 30,
        opacity: 1,
        tail: []
      });
    }
    
    updateShootingStars() {
      this.shootingStars = this.shootingStars.filter(star => {
        // Update position
        star.x += star.vx;
        star.y += star.vy;
        
        // Add to tail
        star.tail.push({ x: star.x, y: star.y });
        if (star.tail.length > 15) {
          star.tail.shift();
        }
        
        // Fade out near end of screen
        if (star.x < 0 || star.y > this.canvas.height) {
          star.opacity -= 0.05;
        }
        
        // Remove if off screen or faded
        return star.opacity > 0 && star.x > -100 && star.y < this.canvas.height + 100;
      });
    }
    
    update() {
      // Try to create shooting star occasionally (dark theme only)
      if (!this.isLightTheme && Math.random() < 0.01) {
        this.createShootingStar();
      }
      
      // Update based on theme
      if (this.isLightTheme) {
        this.updateBinaryDigits();
      } else {
        this.updateShootingStars();
      }
      this.particles.forEach(particle => {
        // Apply base drift for continuous movement
        particle.vx += (particle.baseVx - particle.vx) * 0.02;
        particle.vy += (particle.baseVy - particle.vy) * 0.02;
        
        // Update position
        particle.x += particle.vx;
        particle.y += particle.vy;
        
        // Bounce off edges
        if (particle.x < 0 || particle.x > this.canvas.width) {
          particle.vx *= -1;
          particle.baseVx *= -1;
          particle.x = Math.max(0, Math.min(this.canvas.width, particle.x));
        }
        if (particle.y < 0 || particle.y > this.canvas.height) {
          particle.vy *= -1;
          particle.baseVy *= -1;
          particle.y = Math.max(0, Math.min(this.canvas.height, particle.y));
        }
        
        // Mouse interaction - repulsion
        if (this.mouse.x !== null && this.mouse.y !== null) {
          const dx = particle.x - this.mouse.x;
          const dy = particle.y - this.mouse.y;
          const distance = Math.sqrt(dx * dx + dy * dy);
          
          if (distance < this.mouse.radius) {
            const angle = Math.atan2(dy, dx);
            const force = (this.mouse.radius - distance) / this.mouse.radius;
            particle.vx += Math.cos(angle) * force * 0.5;
            particle.vy += Math.sin(angle) * force * 0.5;
          }
        }
      });
    }
    
    draw() {
      this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
      
      if (this.isLightTheme) {
        // Light theme: Animated technical grid
        const spacing = 80;
        const cols = Math.ceil(this.canvas.width / spacing);
        const rows = Math.ceil(this.canvas.height / spacing);
        
        this.ctx.strokeStyle = 'rgba(100, 120, 150, 0.15)';
        this.ctx.lineWidth = 1;
        
        // Draw horizontal lines
        for (let j = 0; j <= rows; j++) {
          this.ctx.beginPath();
          for (let i = 0; i <= cols; i++) {
            const index = i + j * (cols + 1);
            if (this.binaryDigits[index]) {
              const point = this.binaryDigits[index];
              if (i === 0) {
                this.ctx.moveTo(point.x, point.y);
              } else {
                this.ctx.lineTo(point.x, point.y);
              }
            }
          }
          this.ctx.stroke();
        }
        
        // Draw vertical lines
        for (let i = 0; i <= cols; i++) {
          this.ctx.beginPath();
          for (let j = 0; j <= rows; j++) {
            const index = i + j * (cols + 1);
            if (this.binaryDigits[index]) {
              const point = this.binaryDigits[index];
              if (j === 0) {
                this.ctx.moveTo(point.x, point.y);
              } else {
                this.ctx.lineTo(point.x, point.y);
              }
            }
          }
          this.ctx.stroke();
        }
        
        // Draw binary digits at intersections
        this.ctx.font = '12px "Courier New", monospace';
        this.ctx.textAlign = 'center';
        this.ctx.textBaseline = 'middle';
        this.ctx.fillStyle = 'rgba(100, 120, 150, 0.4)';
        
        this.binaryDigits.forEach(point => {
          this.ctx.fillText(point.value, point.x, point.y);
        });
      } else {
        // Dark theme: Shooting stars and particles
        // Draw shooting stars first (behind particles)
        this.shootingStars.forEach(star => {
          // Draw tail gradient
          if (star.tail.length > 1) {
            for (let i = 0; i < star.tail.length - 1; i++) {
              const progress = i / star.tail.length;
              const opacity = progress * star.opacity * 0.5;
              
              this.ctx.strokeStyle = `rgba(200, 230, 255, ${opacity})`;
              this.ctx.lineWidth = 2 * (1 - progress);
              this.ctx.beginPath();
              this.ctx.moveTo(star.tail[i].x, star.tail[i].y);
              this.ctx.lineTo(star.tail[i + 1].x, star.tail[i + 1].y);
              this.ctx.stroke();
            }
          }
          
          // Draw bright head
          const gradient = this.ctx.createRadialGradient(star.x, star.y, 0, star.x, star.y, 5);
          gradient.addColorStop(0, `rgba(255, 255, 255, ${star.opacity})`);
          gradient.addColorStop(0.5, `rgba(200, 230, 255, ${star.opacity * 0.6})`);
          gradient.addColorStop(1, `rgba(150, 200, 255, 0)`);
          
          this.ctx.fillStyle = gradient;
          this.ctx.beginPath();
          this.ctx.arc(star.x, star.y, 5, 0, Math.PI * 2);
          this.ctx.fill();
        });
      }
      
      // Draw connections and particles (dark theme only)
      if (!this.isLightTheme) {
        this.ctx.strokeStyle = 'rgba(100, 160, 255, 0.15)';
        this.ctx.lineWidth = 1;
      
      for (let i = 0; i < this.particles.length; i++) {
        for (let j = i + 1; j < this.particles.length; j++) {
          const dx = this.particles[i].x - this.particles[j].x;
          const dy = this.particles[i].y - this.particles[j].y;
          const distance = Math.sqrt(dx * dx + dy * dy);
          
          if (distance < this.maxDistance) {
            const opacity = (1 - distance / this.maxDistance) * 0.2;
            this.ctx.strokeStyle = `rgba(100, 160, 255, ${opacity})`;
            this.ctx.beginPath();
            this.ctx.moveTo(this.particles[i].x, this.particles[i].y);
            this.ctx.lineTo(this.particles[j].x, this.particles[j].y);
            this.ctx.stroke();
          }
        }
      }
      
      // Draw particles
      this.particles.forEach(particle => {
        this.ctx.fillStyle = `rgba(200, 220, 255, ${particle.opacity})`;
        this.ctx.beginPath();
        this.ctx.arc(particle.x, particle.y, particle.radius, 0, Math.PI * 2);
        this.ctx.fill();
        
        // Glow effect for larger particles
        if (particle.radius > 1) {
          this.ctx.fillStyle = `rgba(150, 200, 255, ${particle.opacity * 0.3})`;
          this.ctx.beginPath();
          this.ctx.arc(particle.x, particle.y, particle.radius * 2, 0, Math.PI * 2);
          this.ctx.fill();
        }
      });
      }
    }
    
    animate() {
      this.update();
      this.draw();
      requestAnimationFrame(() => this.animate());
    }
  }
  
  // Initialize particle system
  const canvas = document.getElementById('particles-canvas');
  if (canvas) {
    new ParticleSystem(canvas);
  }
</script>

<style>
  .particles-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    z-index: -1;
    pointer-events: none;
    opacity: 1;
    transition: opacity 0.5s ease;
  }
  
  #particles-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  
  /* Fade out towards bottom */
  .particles-bg::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 200px;
    background: linear-gradient(to bottom, transparent, var(--color-background));
    pointer-events: none;
  }
</style>
